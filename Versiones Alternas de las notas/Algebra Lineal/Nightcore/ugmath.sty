% ─── Texto con brillo ──────────────────────────────────────────────
% \ncglow[color del brillo]{texto}: texto blanco con contorno de color,
% como el título de los videos nightcore. Se usa dentro de un tikzpicture.
\newcommand{\ncglow}[2][ncPink]{%
  \foreach \ncang in {0,30,...,330}{%
    \node[text=#1, opacity=0.55, anchor=base west, inner sep=0pt]
      at ($(ncglowpos)+(\ncang:1.1pt)$) {#2};%
    \node[text=#1, opacity=0.18, anchor=base west, inner sep=0pt]
      at ($(ncglowpos)+(\ncang:2.6pt)$) {#2};%
  }%
  \node[text=white, anchor=base west, inner sep=0pt] at (ncglowpos) {#2};%
}

% ─── Estrellas en los márgenes ─────────────────────────────────────
% Puntos y destellos de cuatro puntas, solo en la franja de los márgenes
% para no estorbar al texto. La semilla depende de la página, así que
% cada hoja tiene su propio cielo y es el mismo en cada compilación.
\newcommand{\ncsparkle}[3]{% centro, tamaño, color
  \fill[#3] #1 ++(0,#2) .. controls +(0,-0.7*#2) and +(0.7*#2,0) .. ++(-#2,-#2)
    .. controls +(0.7*#2,0) and +(0,0.7*#2) .. ++(#2,-#2)
    .. controls +(0,0.7*#2) and +(-0.7*#2,0) .. ++(#2,#2)
    .. controls +(-0.7*#2,0) and +(0,-0.7*#2) .. cycle;}
\newcommand{\ncstarfield}{%
  \begin{tikzpicture}[x=1cm,y=1cm]
    \useasboundingbox (0,0) rectangle (\paperwidth,\paperheight);
    \pgfmathsetseed{\value{page}+7}%
    \foreach \i in {1,...,70}{%
      \pgfmathsetmacro{\ncside}{int(random(1,4))}%
      \pgfmathsetmacro{\ncu}{rnd}%
      \pgfmathsetmacro{\ncv}{rnd}%
      \ifcase\ncside\or
        \coordinate (ncp) at (\ncv*1.2, \ncu*\paperheight);\or
        \coordinate (ncp) at (\paperwidth-\ncv*1.2cm, \ncu*\paperheight);\or
        \coordinate (ncp) at (\ncu*\paperwidth, \ncv*1.2);\or
        \coordinate (ncp) at (\ncu*\paperwidth, \paperheight-\ncv*1.2cm);\fi
      \pgfmathsetmacro{\ncop}{0.15+0.5*rnd}%
      \fill[ncText, opacity=\ncop] (ncp) circle[radius=0.25pt+0.6pt*rnd];%
    }%
    \foreach \i in {1,...,5}{%
      \pgfmathsetmacro{\ncu}{rnd}%
      \pgfmathsetmacro{\ncv}{rnd}%
      \pgfmathsetmacro{\ncc}{int(random(1,2))}%
      \ifodd\i
        \coordinate (ncp) at (0.25+\ncv*0.7, \ncu*\paperheight);
      \else
        \coordinate (ncp) at (\paperwidth-0.25cm-\ncv*0.7cm, \ncu*\paperheight);
      \fi
      \ifnum\ncc=1 \ncsparkle{(ncp)}{2.2pt}{ncPink!80}\else\ncsparkle{(ncp)}{2.2pt}{ncCyan!80}\fi
    }%
  \end{tikzpicture}}
\AddToHook{shipout/background}{\put(0pt,-\paperheight){\ncstarfield}}

% ─── Aperturas de capítulo ─────────────────────────────────────────
% \ncimagen{n}{archivo}{f}: imagen del capítulo n. f (entre 0 y 1) es la
% altura, medida desde arriba, que queda al centro de la franja.
\newlength{\ncbannerht}
\setlength{\ncbannerht}{7.2cm}
\newsavebox{\ncimgbox}
\newcommand{\ncimagen}[3]{%
  \expandafter\def\csname ncimg@#1\endcsname{#2}%
  \expandafter\def\csname ncpos@#1\endcsname{#3}}

% Encabezado de capítulo numerado: franja con la imagen, degradado hacia la
% hoja y el título con brillo encima.
\newcommand{\ncchapter}[1]{%
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (\textwidth,\ncbannerht);
    \pgfmathsetmacro{\ncfrac}{\csname ncpos@\thechapter\endcsname}%
    \sbox{\ncimgbox}{\includegraphics[width=\textwidth]{\csname ncimg@\thechapter\endcsname}}%
    \begin{scope}
      \clip[rounded corners=10pt] (0,0) rectangle (\textwidth,\ncbannerht);
      \node[anchor=north west, inner sep=0pt]
        at (0,{\ncbannerht/2+\ncfrac*\ht\ncimgbox}) {\usebox{\ncimgbox}};
      \fill[ncPage, path fading=north] (0,0) rectangle (\textwidth,0.55\ncbannerht);
      \fill[ncPage, opacity=0.35, path fading=north] (0,0) rectangle (\textwidth,0.35\ncbannerht);
    \end{scope}
    \draw[ncCyan!35!ncPage, line width=3pt, rounded corners=10pt] (0,0) rectangle (\textwidth,\ncbannerht);
    \draw[ncCyan, line width=1pt, rounded corners=10pt] (0,0) rectangle (\textwidth,\ncbannerht);
    \node[anchor=base west, text=ncCyan, font=\sffamily\bfseries\small,
          fill=ncPage, fill opacity=0.8, text opacity=1, rounded corners=5pt,
          inner xsep=7pt, inner ysep=3pt, draw=ncCyan, draw opacity=0.6]
      at (0.45,1.75) {\ncnota\ NIGHTCORE \textperiodcentered\ CAPÍTULO \thechapter};
    \coordinate (ncglowpos) at (0.6,0.6);
    \ncglow{\sffamily\bfseries\huge #1}
  \end{tikzpicture}}

% Encabezado sin número (Índice, etc.): solo el título con brillo.
\newcommand{\ncchapterstar}[1]{%
  \begin{tikzpicture}
    \useasboundingbox (0,-0.2) rectangle (\textwidth,1.1);
    \coordinate (ncglowpos) at (0,0);
    \ncglow{\sffamily\bfseries\huge #1}
    \draw[ncCyan, line width=0.8pt] (0,-0.35) -- (\textwidth,-0.35);
  \end{tikzpicture}}

% ─── Interludios: páginas completas con imagen ─────────────────────
% \ncinterludioimagen{archivo}{x}: agrega una imagen a la fila de
% interludios. x (entre 0 y 1) es la posición horizontal de la imagen que
% queda al centro de la hoja. \ncinterludio usa la siguiente imagen de la
% fila en una página completa. Las páginas en blanco que deja
% \cleardoublepage antes de un capítulo también se llenan así.
\newcounter{ncintdef}
\newcounter{ncintuso}
\newcommand{\ncinterludioimagen}[2]{%
  \stepcounter{ncintdef}%
  \expandafter\def\csname ncint@img@\the\value{ncintdef}\endcsname{#1}%
  \expandafter\def\csname ncint@pos@\the\value{ncintdef}\endcsname{#2}}

\newcommand{\ncinterludiopagina}[2]{% archivo, x
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (\paperwidth,\paperheight);
    \fill[ncPage] (0,0) rectangle (\paperwidth,\paperheight);
    \sbox{\ncimgbox}{\includegraphics[height=\paperheight]{#1}}%
    \begin{scope}
      \clip (0,0) rectangle (\paperwidth,\paperheight);
      \node[anchor=south west, inner sep=0pt]
        at ({0.5\paperwidth-#2*\wd\ncimgbox},0) {\usebox{\ncimgbox}};
    \end{scope}
    \draw[ncCyan!35!ncPage, line width=4pt, rounded corners=14pt]
      (0.8,0.8) rectangle (\paperwidth-0.8cm,\paperheight-0.8cm);
    \draw[ncCyan, line width=1.2pt, rounded corners=14pt]
      (0.8,0.8) rectangle (\paperwidth-0.8cm,\paperheight-0.8cm);
    \node[text=ncCyan, font=\sffamily\bfseries, fill=ncPage, fill opacity=0.8,
          text opacity=1, rounded corners=5pt, inner xsep=8pt, inner ysep=4pt,
          draw=ncCyan, draw opacity=0.6]
      at (0.5\paperwidth,0.8) {\ncnota\ interludio \ncnota};
  \end{tikzpicture}}

\newcommand{\ncinterludio}{%
  \clearpage
  \ifnum\value{ncintuso}<\value{ncintdef}%
    \stepcounter{ncintuso}%
    \edef\ncint@img{\csname ncint@img@\the\value{ncintuso}\endcsname}%
    \edef\ncint@pos{\csname ncint@pos@\the\value{ncintuso}\endcsname}%
    \edef\ncint@do{\noexpand\AddToHookNext{shipout/foreground}{%
      \noexpand\put(0pt,-\noexpand\paperheight){%
        \noexpand\ncinterludiopagina{\ncint@img}{\ncint@pos}}}}%
    \ncint@do
  \fi
  \thispagestyle{empty}\null\newpage}

\renewcommand{\cleardoublepage}{%
  \clearpage
  \if@twoside\ifodd\c@page\else\ncinterludio\fi\fi}

% ─── Secciones con franja de imagen ────────────────────────────────
% \ncseccionimagen{1.2}{archivo}{f}: imagen de la sección 1.2. f (entre 0
% y 1) es la altura de la imagen, desde arriba, que queda al centro de la
% franja. Una sección sin imagen lleva el encabezado sencillo.
\newlength{\ncstripht}
\setlength{\ncstripht}{2.6cm}
\newcommand{\ncseccionimagen}[3]{%
  \expandafter\def\csname ncsec@img@#1\endcsname{#2}%
  \expandafter\def\csname ncsec@pos@#1\endcsname{#3}}

\newcommand{\ncsection}[1]{%
  \ifcsname ncsec@img@\thesection\endcsname
    \begin{tikzpicture}
      \useasboundingbox (0,0) rectangle (\textwidth,\ncstripht);
      \pgfmathsetmacro{\ncfrac}{\csname ncsec@pos@\thesection\endcsname}%
      \sbox{\ncimgbox}{\includegraphics[width=0.5\textwidth]{\csname ncsec@img@\thesection\endcsname}}%
      \begin{scope}
        \clip[rounded corners=8pt] (0,0) rectangle (\textwidth,\ncstripht);
        \fill[ncBoxBg] (0,0) rectangle (\textwidth,\ncstripht);
        \node[anchor=north east, inner sep=0pt]
          at (\textwidth,{\ncstripht/2+\ncfrac*\ht\ncimgbox}) {\usebox{\ncimgbox}};
        \fill[ncBoxBg, path fading=east] (0.5\textwidth-1pt,0) rectangle (0.72\textwidth,\ncstripht);
      \end{scope}
      \draw[ncPink!35!ncPage, line width=3pt, rounded corners=8pt] (0,0) rectangle (\textwidth,\ncstripht);
      \draw[ncPink, line width=1pt, rounded corners=8pt] (0,0) rectangle (\textwidth,\ncstripht);
      \node[anchor=west, text=ncPage, fill=ncCyan, rounded corners=4pt,
            font=\sffamily\bfseries, inner xsep=6pt, inner ysep=3pt]
        (ncnum) at (0.45,0.5\ncstripht) {\thesection};
      \path (ncnum.east) ++(0.35,0) coordinate (ncglowpos);
      \path (ncglowpos) ++(0,-0.6ex) coordinate (ncglowpos);
      \ncglow{\sffamily\bfseries\Large #1}
    \end{tikzpicture}%
  \else
    {\sffamily\bfseries\normalsize\textcolor{ncCyan}{\thesection}\hspace{1em}#1}%
  \fi}
