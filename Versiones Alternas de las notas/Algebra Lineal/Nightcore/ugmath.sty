\RequirePackage{textcomp}   % \textmusicalnote
% Libertinus Sans no trae la nota musical, se toma de Libertinus Serif.
\newcommand{\ncnota}{{\fontfamily{LibertinusSerif-TLF}\selectfont\textmusicalnote}}
