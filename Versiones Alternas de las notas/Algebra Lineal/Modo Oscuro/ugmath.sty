% ========== COLORES (modo oscuro) ==========
\RequirePackage[dvipsnames]{xcolor}

% Hoja y texto
\definecolor{darkpage}{HTML}{000000}     % la hoja: negro
\definecolor{orangeText}{HTML}{E3A063}   % texto: naranja suave, legible, no chillón
\definecolor{orangeDim}{HTML}{A87A4E}    % naranja apagado, para texto secundario/reglas
\definecolor{orangeLink}{HTML}{F2C14E}   % acento más claro, para enlaces (se distingue del texto)

% Cajas: fondos casi negros con distintos bordes naranja/ámbar
\definecolor{boxbg}{HTML}{140F0A}        % fondo de caja, negro con tinte cálido
\definecolor{boxborderDef}{HTML}{E08A3E} % borde: definición (naranja vivo)
\definecolor{boxborderThm}{HTML}{B98A55} % borde: teorema/proposición/lema/corolario (ámbar)
\definecolor{boxborderNote}{HTML}{8C5A2B}% borde: nota/errata (naranja quemado)
\definecolor{boxtitletext}{HTML}{140F0A} % texto del título de caja (oscuro, sobre barra clara)

% Se conservan estos nombres (usados en \mdfdefinestyle más abajo) para
% minimizar el diff frente a la versión original.
\definecolor{UGblue}{HTML}{E08A3E}
\definecolor{UGgold}{HTML}{F2C14E}
\definecolor{mutedyellow}{HTML}{B98A55}
\definecolor{myblue}{HTML}{E08A3E}
\definecolor{softgray}{HTML}{B98A55}
\definecolor{lightgray}{HTML}{140F0A}
\definecolor{elegantpurple}{HTML}{B98A55}
\definecolor{lightpurple}{HTML}{140F0A}
\definecolor{darkred}{HTML}{8C5A2B}
\definecolor{lightred}{HTML}{140F0A}

% La hoja negra y el color de texto por omisión (\pagecolor lo da xcolor)
\AtBeginDocument{%
  \pagecolor{darkpage}%
  \color{orangeText}%
}

