\mdfdefinestyle{mdpinkbox}{
    linecolor=boxborderNote,
    linewidth=1.5pt,
    backgroundcolor=boxbg,
    roundcorner=8pt,
    frametitlebackgroundcolor=boxborderNote,
    frametitlefont=\bfseries\color{boxtitletext},
    frametitlealignment=\raggedright, %\raggedleft o \centering
    innertopmargin=12pt,
    innerbottommargin=12pt,
    innerleftmargin=15pt,
    innerrightmargin=15pt,
    skipabove=20pt,     % Espacio antes de la caja
    skipbelow=15pt,     % Espacio después de la caja
    nobreak=true,      % Permite que se rompa en páginas
    splitbottomskip=10pt,
    splittopskip=10pt
}

