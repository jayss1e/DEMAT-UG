% =========================================================
% ENTORNOS MATEMÁTICOS SIN CAJA (estilo de libro impreso)
% =========================================================
% Mismo patrón usado en las variantes "Impresión" del resto del
% repositorio (Álgebra Lineal, Introducción a la teoría analítica de
% números): encabezado en negritas seguido del texto en el mismo
% párrafo, sin mdframed, sin color de fondo ni de borde.

% ─── Contadores ────────────────────────────────────────────────────
\newcounter{defn}[chapter]
\newcounter{teor}[chapter]
\newcounter{prop}[chapter]
\newcounter{lema}[chapter]
\newcounter{coro}[chapter]

% Formato: 1.1, 1.2, 2.1 … (capítulo.número)
\renewcommand{\thedefn}{\thechapter.\arabic{defn}}
\renewcommand{\theteor}{\thechapter.\arabic{teor}}
\renewcommand{\theprop}{\thechapter.\arabic{prop}}
\renewcommand{\thelema}{\thechapter.\arabic{lema}}
\renewcommand{\thecoro}{\thechapter.\arabic{coro}}

% Nombres de ancla únicos para hyperref (estos contadores se definieron
% antes de \usepackage{hyperref}, así que hyperref no generó \theH*
% automáticamente; sin esto, dos capítulos con, p. ej., el mismo número
% de teorema local producen anclas duplicadas).
\providecommand{\theHdefn}{\thechapter.\arabic{defn}}
\providecommand{\theHteor}{\thechapter.\arabic{teor}}
\providecommand{\theHprop}{\thechapter.\arabic{prop}}
\providecommand{\theHlema}{\thechapter.\arabic{lema}}
\providecommand{\theHcoro}{\thechapter.\arabic{coro}}

% ─── Encabezado genérico (negritas + numeración + título opcional entre
%     paréntesis), sin caja, sin color ──────────────────────────────
\newcommand{\@ugmathrunin}[3]{%
  % #1 = etiqueta ("Definición", "Teorema", ...), #2 = número, #3 = título opcional
  \textbf{#1~#2}%
  \ifx&#3&\else\space(#3)\fi
  \textbf{.}\par\nobreak\ignorespaces
}

% ─── Entornos ──────────────────────────────────────────────────────

% DEFINICIÓN — sin caja
\newenvironment{definicion}[1][]{%
  \par\addvspace{10pt}\noindent
  \refstepcounter{defn}%
  \@ugmathrunin{Definición}{\thedefn}{#1}%
}{%
  \par\addvspace{8pt}
}

% TEOREMA — sin caja
\newenvironment{teorema}[1][]{%
  \par\addvspace{10pt}\noindent
  \refstepcounter{teor}%
  \@ugmathrunin{Teorema}{\theteor}{#1}%
}{%
  \par\addvspace{8pt}
}

% PROPOSICIÓN — sin caja
\newenvironment{proposicion}[1][]{%
  \par\addvspace{10pt}\noindent
  \refstepcounter{prop}%
  \@ugmathrunin{Proposición}{\theprop}{#1}%
}{%
  \par\addvspace{8pt}
}

% LEMA — sin caja
\newenvironment{lema}[1][]{%
  \par\addvspace{10pt}\noindent
  \refstepcounter{lema}%
  \@ugmathrunin{Lema}{\thelema}{#1}%
}{%
  \par\addvspace{8pt}
}

% COROLARIO — sin caja
\newenvironment{corolario}[1][]{%
  \par\addvspace{10pt}\noindent
  \refstepcounter{coro}%
  \@ugmathrunin{Corolario}{\thecoro}{#1}%
}{%
  \par\addvspace{8pt}
}

% ─── Contador de ejemplos ──────────────────────────────────────────
\newcounter{ejemplo}[chapter]
\renewcommand{\theejemplo}{\thechapter.\arabic{ejemplo}}
\providecommand{\theHejemplo}{\thechapter.\arabic{ejemplo}}

% ─── Entorno ejemplo ───────────────────────────────────────────────
% Si el ejemplo termina con una demostración, se omite el $\blacktriangle$
% y queda sólo el $\blacksquare$ de la demostración. La bandera se activa al
% cerrar una \texttt{proof} y se apaga en cuanto empieza cualquier párrafo.
\newif\ifug@tras@proof
\AddToHook{env/proof/after}{\global\ug@tras@prooftrue}
\AddToHook{para/begin}{\global\ug@tras@prooffalse}

\newenvironment{ejemplo}[1][]{%
  \refstepcounter{ejemplo}%
  \global\ug@tras@prooffalse
  \par\medskip
  \noindent\textbf{Ejemplo \theejemplo}%
  \ifx&#1&%
  \else%
    \textbf{ (#1)}%
  \fi
  \par\smallskip
}{%
  \ifug@tras@proof\else\hfill$\blacktriangle$\fi
  \global\ug@tras@prooffalse
  \par\medskip
}

% ─── Contador de ejercicios ────────────────────────────────────────
\newcounter{ejercicio}[chapter]
\renewcommand{\theejercicio}{\thechapter.\arabic{ejercicio}}
\providecommand{\theHejercicio}{\thechapter.\arabic{ejercicio}}

% ─── Entorno ejercicio ─────────────────────────────────────────────
\newenvironment{ejercicio}{%
  \refstepcounter{ejercicio}%
  \par\medskip
  \noindent\textbf{Ejercicio \theejercicio}\space\ignorespaces
}{%
  \par\medskip
}

% ─── Entorno problema (con caja, título opcional) ──────────────────
% Uso: \begin{problema}  o  \begin{problema}[título]
\newcounter{problema}[chapter]
\renewcommand{\theproblema}{\thechapter.\arabic{problema}}
\providecommand{\theHproblema}{\thechapter.\arabic{problema}}

\newenvironment{problema}[1][]{%
  \refstepcounter{problema}%
  \ifx&#1&%
    \begin{mdframed}[style=mdpinkbox, frametitle={Problema \theproblema}]%
  \else%
    \begin{mdframed}[style=mdpinkbox, frametitle={Problema \theproblema: #1}]%
  \fi
}{%
  \end{mdframed}
}

