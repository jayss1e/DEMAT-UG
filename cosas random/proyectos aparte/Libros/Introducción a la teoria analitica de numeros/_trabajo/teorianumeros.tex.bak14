    Los siguientes ejemplos ilustran el uso de índices para resolver congruencias.

    \begin{ejemplo}
        \textit{Congruencias lineales.} Suponemos que $m$ tiene una raíz primitiva y que
        $(a,m)=(b,m)=1$. Entonces la congruencia lineal
        \begin{equation}\label{eq:10-14}
            ax\equiv b\pmod{m}
        \end{equation}
        es equivalente a la congruencia
        \begin{equation*}
            \operatorname{ind}a+\operatorname{ind}x\equiv\operatorname{ind}b\pmod{\varphi(m)},
        \end{equation*}
        luego la única solución de \eqref{eq:10-14} satisface la congruencia
        \begin{equation*}
            \operatorname{ind}x\equiv\operatorname{ind}b-\operatorname{ind}a\pmod{\varphi(m)}.
        \end{equation*}
        Para efectuar un ejemplo numérico, consideremos la congruencia lineal
        \begin{equation*}
            9x\equiv13\pmod{47}.
        \end{equation*}
        La correspondiente relación entre índices es
        \begin{equation*}
            \operatorname{ind}x\equiv\operatorname{ind}13-\operatorname{ind}9\pmod{46}.
        \end{equation*}
        De la tabla 10.2 obtenemos $\operatorname{ind}13=11$ e $\operatorname{ind}9=40$ (para
        $p=47$), luego
        \begin{equation*}
            \operatorname{ind}x\equiv11-40\equiv-29\equiv17\pmod{46}.
        \end{equation*}
        De nuevo recurriendo a la tabla 10.2 obtenemos $x\equiv38\pmod{47}$.
    \end{ejemplo}

    \begin{ejemplo}
        \textit{Congruencias binomiales\index{congruencia@Congruencia!binomial@binomial}.} Una congruencia de la forma
        \begin{equation*}
            x^n\equiv a\pmod{m}
        \end{equation*}
        se llama \textit{congruencia binomial}. Si $m$ tiene una raíz primitiva y si
        $(a,m)=1$ ésta es equivalente a la congruencia\index{congruencias@Congruencias}
        \begin{equation*}
            n\operatorname{ind}x\equiv\operatorname{ind}a\pmod{\varphi(m)},
        \end{equation*}
        que es lineal en la incógnita $\operatorname{ind}x$. Como tal tiene solución si, y
        sólo si, $\operatorname{ind}a$ es divisible por $d=(n,\varphi(m))$, en cuyo caso
        tiene $d$ soluciones.

        Para ilustrarlo con un ejemplo numérico, consideramos la congruencia binomial
        \begin{equation}\label{eq:10-15}
            x^8\equiv a\pmod{17}.
        \end{equation}
        La relación con índices que le corresponde es
        \begin{equation}\label{eq:10-16}
            8\operatorname{ind}x\equiv\operatorname{ind}a\pmod{16}.
        \end{equation}
        En este ejemplo $d=(8,16)=8$. La tabla 10.2 prueba que 1 y 16 son los únicos números
        mód 17 cuyo índice es divisible por 8. En efecto, $\operatorname{ind}1=0$ e
        $\operatorname{ind}16=8$. Luego \eqref{eq:10-15} carece de solución si
        $a\not\equiv1$ o $a\not\equiv16\pmod{17}$.

        Para $a=1$, la congruencia \eqref{eq:10-16} se transforma en
        \begin{equation}\label{eq:10-17}
            8\operatorname{ind}x\equiv0\pmod{16},
        \end{equation}
        y para $a=16$ se transforma en
        \begin{equation}\label{eq:10-18}
            8\operatorname{ind}x\equiv8\pmod{16}.
        \end{equation}
        Cada una de ellas tiene exactamente ocho soluciones mód 16. Las soluciones de
        \eqref{eq:10-17} son los $x$ cuyo índice es par,
        \begin{equation*}
            x\equiv1,2,4,8,9,13,15,16\pmod{17}.
        \end{equation*}
        Éstos, además, son los restos cuadráticos\index{resto cuadratico@Resto cuadrático} de 17. Las soluciones de
        \eqref{eq:10-18} son los $x$ cuyo índice es impar; son los no restos cuadráticos\index{no-resto cuadratico@No-resto cuadrático} de
        17,
        \begin{equation*}
            x\equiv3,5,6,7,10,11,12,14\pmod{17}.
        \end{equation*}
    \end{ejemplo}

    \begin{ejemplo}
        \textit{Congruencias exponenciales\index{congruencia@Congruencia!exponencial@exponencial}.} Una congruencia exponencial es una congruencia
        de la forma
        \begin{equation*}
            a^x\equiv b\pmod{m}.
        \end{equation*}
        Si $m$ admite una raíz primitiva y si $(a,m)=(b,m)=1$, es equivalente a la
        congruencia lineal
        \begin{equation}\label{eq:10-19}
            x\operatorname{ind}a\equiv\operatorname{ind}b\pmod{\varphi(m)}.
        \end{equation}
        Sea $d=(\operatorname{ind}a,\varphi(m))$. Entonces \eqref{eq:10-19} tiene una
        solución si, y sólo si, $d\mid\operatorname{ind}b$, en cuyo caso existen exactamente
        $d$ soluciones. En el ejemplo numérico
        \begin{equation}\label{eq:10-20}
            25^x\equiv17\pmod{47}
        \end{equation}
        tenemos $\operatorname{ind}25=2$, $\operatorname{ind}17=16$, y $d=(2,46)$. Por
        consiguiente \eqref{eq:10-19} se transforma en
        \begin{equation*}
            2x\equiv16\pmod{46},
        \end{equation*}
        con dos soluciones, $x\equiv8$ y $31\pmod{46}$. Éstas son también las soluciones de
        \eqref{eq:10-20} mód 47.
    \end{ejemplo}

    \section{RAÍCES PRIMITIVAS Y CARACTERES DE DIRICHLET}
\index{caracteres@Caracteres!de dirichlet@de Dirichlet}\index{raices primitivas@Raíces primitivas}
    Las raíces primitivas y los índices se pueden utilizar para construir explícitamente
    todos los caracteres de Dirichlet mód $m$. En primer lugar el módulo considerado es la
    potencia $p^{\alpha}$ de un primo $p$ impar y $\alpha\geq1$.

    Sea $g$ una raíz primitiva mód $p^{\beta}$ para todo $\beta\geq1$. Tales $g$ existen en
    virtud del teorema \ref{teo:10-6}. Si $(n,p)=1$, sea $b(n)=\operatorname{ind}_gn$ (mód
    $p^{\alpha}$) así que $b(n)$ es el único entero que satisface las condiciones
    \begin{equation*}
        n\equiv g^{b(n)}\pmod{p^{\alpha}},\qquad0\leq b(n)<\varphi(p^{\alpha}).
    \end{equation*}
    Para $h=0,1,2,\dots,\varphi(p^{\alpha})-1$, definimos $\chi_h$ por las relaciones
    \begin{equation}\label{eq:10-21}
        \chi_h(n)=
        \begin{cases}
            e^{2\pi ihb(n)/\varphi(p^{\alpha})}&\text{si }p\nmid n,\\
            0&\text{si }p\mid n.
        \end{cases}
    \end{equation}
    Utilizando las propiedades de los índices es fácil comprobar que $\chi_h$ es
    completamente multiplicativa y periódica con período $p^{\alpha}$, luego $\chi_h$ es un
    carácter de Dirichlet mód $p^{\alpha}$, y $\chi_0$ es el carácter principal\index{caracter principal@Carácter principal}. La
    comprobación se deja como ejercicio para el lector.

    Como
    \begin{equation*}
        \chi_h(g)=e^{2\pi ih/\varphi(p^{\alpha})}
    \end{equation*}
    los caracteres $\chi_0,\chi_1,\dots,\chi_{\varphi(p^{\alpha})-1}$ son distintos ya que
    toman distintos valores en $g$. Por consiguiente dado que existen $\varphi(p^{\alpha})$
    de estas funciones, representan todos los caracteres de Dirichlet mód $p^{\alpha}$. La
    misma construcción vale para mód $2^{\alpha}$ si $\alpha=1$ ó 2, utilizando $g=3$ como
    raíz primitiva.

    Ahora si $m=p_1^{a_1}\cdots p_r^{a_r}$ en donde los $p_i$ son primos impares distintos, y
    si $\chi_i$ es un carácter de Dirichlet mód $p_i^{a_i}$, entonces el producto
    $\chi=\chi_1\cdots\chi_r$ es un carácter de Dirichlet mód $m$. Como
    $\varphi(m)=\varphi(p_1^{a_1})\cdots\varphi(p_r^{a_r})$ obtenemos $\varphi(m)$ de tales
    caracteres cuando cada $\chi_i$ recorre los $\varphi(p_i^{a_i})$ caracteres mód
    $p_i^{a_i}$. Luego tenemos construidos explícitamente todos los caracteres mód $m$ para
    cada módulo impar.

    Si $\alpha\geq3$, el módulo $2^{\alpha}$ carece de raíces primitivas y necesitamos una
    construcción ligeramente diferente para obtener los caracteres mód $2^{\alpha}$. El
    teorema que sigue demuestra que 5 es un buen substituto para una raíz primitiva mód
    $2^{\alpha}$.

    \begin{teorema}\label{teo:10-11}
        Suponemos $\alpha\geq3$. Entonces, para cada entero impar $n$, existe un entero
        $b(n)$, unívocamente determinado, tal que
        \begin{equation*}
            n\equiv(-1)^{(n-1)/2}5^{b(n)}\pmod{2^{\alpha}},\qquad\text{con }1\leq b(n)\leq\varphi(2^{\alpha})/2.
        \end{equation*}
    \end{teorema}

    \begin{proof}
        Sea $f=\exp_{2^{\alpha}}(5)$ o sea que $5^f\equiv1\pmod{2^{\alpha}}$. Probaremos que
        $f=\varphi(2^{\alpha})/2$. Ahora bien $f\mid\varphi(2^{\alpha})=2^{\alpha-1}$, luego
        $f=2^{\beta}$ para algún $\beta\leq\alpha-1$. Del teorema \ref{teo:10-8} deducimos
        \begin{equation*}
            5^{\varphi(2^{\alpha})/2}\equiv1\pmod{2^{\alpha}},
        \end{equation*}
        luego $f\leq\varphi(2^{\alpha})/2=2^{\alpha-2}$. Por consiguiente $\beta\leq\alpha-2$.
        Probaremos que $\beta=\alpha-2$.

        Si elevamos los dos miembros de la igualdad $5=1+2^2$ a la potencia $f=2^{\beta}$
        obtenemos
        \begin{equation*}
            5^f=(1+2^2)^{2^{\beta}}=1+2^{\beta+2}+r2^{\beta+3}=1+2^{\beta+2}(1+2r)
        \end{equation*}
        en donde $r$ es un entero. Luego $5^f-1=2^{\beta+2}t$, en donde $t$ es impar. Pero
        $2^{\alpha}\mid(5^f-1)$ por lo que $\alpha\leq\beta+2$, o bien $\beta\geq\alpha-2$.
        Luego $\beta=\alpha-2$ y $f=2^{\alpha-2}=\varphi(2^{\alpha})/2$. Por consiguiente los
        números
        \begin{equation}\label{eq:10-22}
            5,5^2,\dots,5^f
        \end{equation}
        son incongruentes mód $2^{\alpha}$. También cada uno de ellos es $\equiv1\pmod{4}$ ya
        que $5\equiv1\pmod{4}$. Análogamente los números
        \begin{equation}\label{eq:10-23}
            -5,-5^2,\dots,-5^f
        \end{equation}
        son incongruentes mód $2^{\alpha}$ y cada uno de ellos es $\equiv3\pmod{4}$ ya que
        $-5\equiv3\pmod{4}$. Existen $2f=\varphi(2^{\alpha})$ números en \eqref{eq:10-22} y
        \eqref{eq:10-23} conjuntamente. Además no es posible que $5^a\equiv-5^b\pmod{2^{\alpha}}$
        ya que ello implicaría $1\equiv-1\pmod{4}$. Luego los números de \eqref{eq:10-22}
        junto con los de \eqref{eq:10-23} representan $\varphi(2^{\alpha})$ números impares
        incongruentes mód $2^{\alpha}$. Cada impar $n\equiv1\pmod{4}$ es congruente mód
        $2^{\alpha}$ a uno de los números de \eqref{eq:10-22}, y cada impar $n\equiv3\pmod{4}$
        es congruente con uno de \eqref{eq:10-23}. Esto prueba el teorema.
    \end{proof}

    Con la ayuda del teorema \ref{teo:10-11} podemos construir todos los caracteres mód
    $2^{\alpha}$ si $\alpha\geq3$. Sea
    \begin{equation}\label{eq:10-24}
        f(n)=
        \begin{cases}
            (-1)^{(n-1)/2}&\text{si }n\text{ es impar,}\\
            0&\text{si }n\text{ es par,}
        \end{cases}
    \end{equation}
    y sea
    \begin{equation*}
        g(n)=
        \begin{cases}
            e^{2\pi ib(n)/2^{\alpha-2}}&\text{si }n\text{ es impar,}\\
            0&\text{si }n\text{ es par,}
        \end{cases}
    \end{equation*}
    en donde $b(n)$ es el entero proporcionado por el teorema \ref{teo:10-11}. Entonces es
    fácil comprobar que cada uno de los $f$ y de los $g$ es un carácter mód $2^{\alpha}$.
    Luego también lo es cada producto
    \begin{equation}\label{eq:10-25}
        \chi_{a,c}(n)=f(n)^ag(n)^c
    \end{equation}
    en donde $a=1,2$, y $c=1,2,\dots,\varphi(2^{\alpha})/2$. Además, estos $\varphi(2^{\alpha})$
    caracteres son distintos, luego representan todos los caracteres mód $2^{\alpha}$.

    Ahora, si $m=2^{\alpha}Q$ en donde $Q$ es impar, formamos los productos
    $\chi=\chi_1\chi_2$, en donde $\chi_1$ recorre los $\varphi(2^{\alpha})$ caracteres mód
    $2^{\alpha}$ y $\chi_2$ recorre los $\varphi(Q)$ caracteres mód $Q$ para obtener todos
    los caracteres mód $m$.

    \section[CARACTERES DE DIRICHLET MÓD $p^{\alpha}$ CON VALORES REALES]{CARACTERES DE DIRICHLET MÓD \texorpdfstring{$p^{\alpha}$}{p^α} CON VALORES REALES}
\index{caracteres@Caracteres!de dirichlet@de Dirichlet}
    Si $\chi$ es un carácter de Dirichlet mód $m$ con valores reales y $(n,m)=1$, el número
    $\chi(n)$ es a la vez una raíz de la unidad y es real, luego $\chi(n)=\pm1$. Por la
    construcción de la sección anterior podemos determinar todos los caracteres de
    Dirichlet mód $p^{\alpha}$ con valores reales.

    \begin{teorema}\label{teo:10-12}
        Para un primo $p$ impar y $\alpha\geq1$, consideremos los $\varphi(p^{\alpha})$
        caracteres de Dirichlet $\chi_h$ mód $p^{\alpha}$ dados por \eqref{eq:10-21}.
        Entonces $\chi_h$ es real si, y sólo si, $h=0$ o $h=\varphi(p^{\alpha})/2$. Luego
        existen exactamente dos caracteres reales mód $p^{\alpha}$.
    \end{teorema}

    \begin{proof}
        Tenemos $e^{\pi iz}=\pm1$ si, y sólo si, $z$ es un entero. Si $p\nmid n$ tenemos
        \begin{equation*}
            \chi_h(n)=e^{2\pi ihb(n)/\varphi(p^{\alpha})}
        \end{equation*}
        luego $\chi_h(n)=\pm1$ si, y sólo si, $\varphi(p^{\alpha})\mid2hb(n)$. Esta condición
        la satisface todo $n$ si $h=0$ o si $h=\varphi(p^{\alpha})/2$. Recíprocamente, si
        $\varphi(p^{\alpha})\mid2hb(n)$ para todo $n$ entonces cuando $b(n)=1$ tenemos
        $\varphi(p^{\alpha})\mid2h$ o $\varphi(p^{\alpha})/2\mid h$. Luego $h=0$ o
        $h=\varphi(p^{\alpha})/2$ ya que éstos son los únicos múltiplos de
        $\varphi(p^{\alpha})/2$ menores que $\varphi(p^{\alpha})$.
    \end{proof}

    Nota. El carácter que corresponde a $h=0$ es el carácter principal. Cuando $\alpha=1$ el
    carácter cuadrático $\chi(n)=(n\,|\,p)$ es el otro carácter real mód $p$.

    Para los módulos $m=1,2$, y 4, todos los caracteres de Dirichlet son reales. El teorema
    que sigue describe los caracteres reales mód $2^{\alpha}$ cuando $\alpha\geq3$.

    \begin{teorema}\label{teo:10-13}
        Si $\alpha\geq3$, consideremos los $\varphi(2^{\alpha})$ caracteres de Dirichlet
        $\chi_{a,c}$ mód $2^{\alpha}$ dados por \eqref{eq:10-25}. Entonces $\chi_{a,c}$ es
        real si, y sólo si, $c=\varphi(2^{\alpha})/2$ ó $c=\varphi(2^{\alpha})/4$. Luego hay
        exactamente cuatro caracteres reales mód $2^{\alpha}$ si $\alpha\geq3$.
    \end{teorema}

    \begin{proof}
        Si $\alpha\geq3$ y $n$ es impar tenemos, por \eqref{eq:10-25},
        \begin{equation*}
            \chi_{a,c}(n)=f(n)^ag(n)^c
        \end{equation*}
        en donde $f(n)=\pm1$ y
        \begin{equation*}
            g(n)^c=e^{2\pi icb(n)/2^{\alpha-2}},
        \end{equation*}
        con $1\leq c\leq2^{\alpha-2}$. Esto es $\pm1$ si, y sólo si, $2^{\alpha-2}\mid2cb(n)$,
        ó $2^{\alpha-3}\mid cb(n)$. Puesto que $\varphi(2^{\alpha})=2^{\alpha-1}$ esta
        condición se verifica si $c=\varphi(2^{\alpha})/2=2^{\alpha-2}$ o si
        $c=\varphi(2^{\alpha})/4=2^{\alpha-3}$. Recíprocamente, si $2^{\alpha-3}\mid cb(n)$
        para todo $n$ entonces $b(n)=1$ requiere que $2^{\alpha-3}\mid c$ o sea que
        $c=2^{\alpha-3}$ ó $2^{\alpha-2}$ ya que $1\leq c\leq2^{\alpha-2}$.
    \end{proof}

    \section[CARACTERES DE DIRICHLET PRIMITIVOS MÓD $p^{\alpha}$]{CARACTERES DE DIRICHLET PRIMITIVOS MÓD \texorpdfstring{$p^{\alpha}$}{p^α}}
\index{caracteres@Caracteres!de dirichlet@de Dirichlet}
    En el teorema 8.14 probábamos que cada carácter no principal $\chi$ mód $p$ es primitivo
    si $p$ es primo. Ahora determinaremos todos los caracteres de Dirichlet primitivos mód
    $p^{\alpha}$.

    Recordemos (sección 8.7) que $\chi$ es primitivo mód $k$ si, y sólo si, $\chi$ carece de
    módulo inducido $d<k$. Un módulo inducido\index{modulos inducidos@Módulos inducidos} es un divisor $d$ de $k$ tal que
    \begin{equation*}
        \chi(n)=1\qquad\text{si }(n,k)=1\text{ y }n\equiv1\pmod{d}.
    \end{equation*}
    Si $k=p^{\alpha}$ y $\chi$ es no primitivo mód $p^{\alpha}$ entonces uno de los divisores
    $1,p,\dots,p^{\alpha-1}$ es un módulo inducido y por tanto $p^{\alpha-1}$ es un módulo
    inducido. Por consiguiente, $\chi$ es primitivo mód $p^{\alpha}$ si, y sólo si,
    $p^{\alpha-1}$ no es un módulo inducido para $\chi$.

    \begin{teorema}\label{teo:10-14}
        Para un primo impar $p$ y $\alpha\geq2$, consideremos los $\varphi(p^{\alpha})$
        caracteres de Dirichlet\index{dirichlet, peter gustav lejeune@Dirichlet, Peter Gustav Lejeune} $\chi_h$ mód $p^{\alpha}$ dados por \eqref{eq:10-21}. Entonces
        $\chi_h$ es primitivo mód $p^{\alpha}$ si, y sólo si, $p\nmid h$.
    \end{teorema}

    \begin{proof}
        Probaremos que $p^{\alpha-1}$ es un módulo inducido si, y sólo si, $p\mid h$. Si
        $p\nmid n$ tenemos, por \eqref{eq:10-21},
        \begin{equation*}
            \chi_h(n)=e^{2\pi ihb(n)/\varphi(p^{\alpha})},
        \end{equation*}
        en donde $n\equiv g^{b(n)}\pmod{p^{\alpha}}$ y $g$ es una raíz primitiva mód
        $p^{\beta}$ para todo $\beta\geq1$. Por consiguiente
        \begin{equation*}
            g^{b(n)}\equiv n\pmod{p^{\alpha-1}}.
        \end{equation*}
        Ahora si $n\equiv1\pmod{p^{\alpha-1}}$ entonces $g^{b(n)}\equiv1\pmod{p^{\alpha-1}}$
        y, como $g$ es una raíz primitiva de $p^{\alpha-1}$, tenemos
        $\varphi(p^{\alpha-1})\mid b(n)$, luego
        \begin{equation*}
            b(n)=t\varphi(p^{\alpha-1})=t\varphi(p^{\alpha})/p
        \end{equation*}
        para un entero $t$. Por lo tanto
        \begin{equation*}
            \chi_h(n)=e^{2\pi iht/p}.
        \end{equation*}
        Si $p\mid h$, esto es igual a 1 y por lo tanto $\chi_h$ no es primitivo mód
        $p^{\alpha}$. Si $p\nmid h$ tomamos $n=1+p^{\alpha-1}$. Entonces
        $n\equiv1\pmod{p^{\alpha-1}}$ pero $n\not\equiv1\pmod{p^{\alpha}}$ o sea que
        $0<b(n)<\varphi(p^{\alpha})$. Por consiguiente $p\nmid t$, $p\nmid ht$ y
        $\chi_h(n)\neq1$. Esto demuestra que $\chi_h$ es primitivo si $p\nmid h$.
    \end{proof}

    Cuando $m=1$ ó 2, existe un único carácter mód $m$, el carácter principal\index{caracter principal@Carácter principal}. Si $m=4$
    existen dos caracteres mód 4, el carácter principal y el carácter primitivo $f$ dado por
    \eqref{eq:10-24}. El teorema que sigue describe todos los caracteres primitivos\index{caracteres@Caracteres!primitivos@primitivos} mód
    $2^{\alpha}$ para $\alpha\geq3$. La demostración es análoga a la del teorema
    \ref{teo:10-14} y se deja como ejercicio al lector.

    \begin{teorema}\label{teo:10-15}
        Si $\alpha\geq3$, consideremos los $\varphi(2^{\alpha})$ caracteres de Dirichlet
        $\chi_{a,c}$ mód $2^{\alpha}$ dados por \eqref{eq:10-25}. Entonces $\chi_{a,c}$ es
        primitivo mód $2^{\alpha}$ si, y sólo si, $c$ es impar.
    \end{teorema}

    Los resultados precedentes describen todos los caracteres primitivos\index{caracteres@Caracteres!primitivos@primitivos} mód $p^{\alpha}$
    para todas las potencias de primos. Para determinar los caracteres primitivos\index{caracteres@Caracteres!primitivos@primitivos} para
    módulos compuestos $k$ escribimos
    \begin{equation*}
        k=p_1^{\alpha_1}\cdots p_r^{\alpha_r}.
    \end{equation*}
    Entonces cada carácter $\chi$ mód $k$ se descompone en la forma
    \begin{equation*}
        \chi=\chi_1\cdots\chi_r
    \end{equation*}
    en donde cada $\chi_i$ es un carácter mód $p_i^{\alpha_i}$. Además, por el ejercicio
    8.12, $\chi$ es primitivo mód $k$ si, y sólo si, cada $\chi_i$ es primitivo mód
    $p_i^{\alpha_i}$. Por consiguiente tenemos una descripción completa de todos los
    caracteres primitivos\index{caracteres@Caracteres!primitivos@primitivos} mód $k$.

    \section*{Ejercicios del capítulo 10}

    \begin{ejercicio}
        Probar que $m$ es primo si, y sólo si, $\exp_m(a)=m-1$ para algún $a$.
    \end{ejercicio}

    \begin{ejercicio}
        Si $(a,m)=(b,m)=1$ y si $(\exp_m(a),\exp_m(b))=1$, probar que
        \begin{equation*}
            \exp_m(ab)=\exp_m(a)\exp_m(b).
        \end{equation*}
    \end{ejercicio}

    \begin{ejercicio}
        Sea $g$ una raíz primitiva de un primo impar $p$. Probar que $-g$ también es una
        raíz primitiva de $p$ si $p\equiv1\pmod{4}$, pero que $\exp_p(-g)=(p-1)/2$ si
        $p\equiv3\pmod{4}$.
    \end{ejercicio}

    \begin{ejercicio}
        \begin{enumerate}
            \item[(a)] Probar que 3 es una raíz primitiva mód $p$ si $p$ es un primo de la
            forma $2^n+1$, $n>1$.
            \item[(b)] Probar que 2 es una raíz primitiva mód $p$ si $p$ es un primo de la
            forma $4q+1$, en donde $q$ es un primo impar.
        \end{enumerate}
    \end{ejercicio}

    \begin{ejercicio}
        Sea $m>2$ un entero con una raíz primitiva, y sea $(a,m)=1$. Escribiremos $a\mathrm{R}m$
        si existe un $x$ tal que $x^2\equiv a\pmod{m}$. Probar que:
        \begin{enumerate}
            \item[(a)] $a\mathrm{R}m$ si, y sólo si, $a^{\varphi(m)/2}\equiv1\pmod{m}$.
            \item[(b)] Si $a\mathrm{R}m$, la congruencia $x^2\equiv a\pmod{m}$ tiene
            exactamente dos soluciones.
            \item[(c)] Existen exactamente $\varphi(m)/2$ enteros $a$, incongruentes mód $m$,
            tales que $(a,m)=1$ y $a\mathrm{R}m$.
        \end{enumerate}
    \end{ejercicio}

    \begin{ejercicio}
        Suponemos $m>2$, $(a,m)=1$, $a\mathrm{R}m$. Probar que la congruencia
        $x^2\equiv a\pmod{m}$ tiene exactamente dos soluciones si, y sólo si, $m$ tiene una
        raíz primitiva.
    \end{ejercicio}

    \begin{ejercicio}
        Sea $S_n(p)=\sum_{k=1}^{p-1}k^n$, en donde $p$ es un impar y $n>1$. Probar que
        \begin{equation*}
            S_n(p)\equiv
            \begin{cases}
                0\pmod{p}&\text{si }n\not\equiv0\pmod{p-1},\\
                -1\pmod{p}&\text{si }n\equiv0\pmod{p-1}.
            \end{cases}
        \end{equation*}
    \end{ejercicio}

    \begin{ejercicio}
        Probar que la suma de las raíces primitivas mód $p$ es congruente con
        $\mu(p-1)$ mód $p$.
    \end{ejercicio}

    \begin{ejercicio}
        Si $p$ es un primo impar $>3$, probar que el producto de las raíces primitivas\index{raices primitivas@Raíces primitivas} mód
        $p$ es congruente con 1 mód $p$.
    \end{ejercicio}

    \begin{ejercicio}
        Sea $p$ un primo impar de la forma $2^{2^k}+1$. Probar que el conjunto de las raíces
        primitivas mód $p$ es igual al conjunto de los no restos cuadráticos mód $p$.
        Utilizar este resultado para probar que 7 es una raíz primitiva de cada uno de estos
        primos.
    \end{ejercicio}

    \begin{ejercicio}
        Suponemos que $d\mid\varphi(m)$. Si $d=\exp_m(a)$ decimos que $a$ es una raíz
        primitiva de la congruencia
        \begin{equation*}
            x^d\equiv1\pmod{m}.
        \end{equation*}
        Probar que si la congruencia
        \begin{equation*}
            x^{\varphi(m)}\equiv1\pmod{m}
        \end{equation*}
        tiene una raíz primitiva entonces tiene $\varphi(\varphi(m))$ raíces primitivas,
        incongruentes mód $m$.
    \end{ejercicio}

    \begin{ejercicio}
        Probar las propiedades de los índices descritas en el teorema \ref{teo:10-10}.
    \end{ejercicio}

    \begin{ejercicio}
        Sea $p$ un primo impar. Si $(h,p)=1$ sea
        \begin{equation*}
            S(h)=\{h^n:1\leq n\leq\varphi(p-1),\ (n,p-1)=1\}.
        \end{equation*}
        Si $h$ es una raíz primitiva de $p$, los números del conjunto $S(h)$ son distintos
        mód $p$ (son, de hecho, las raíces primitivas de $p$). Probar que existe un entero
        $h$, que no es raíz primitiva de $p$, tal que los números de $S(h)$ son distintos
        mód $p$ si, y sólo si, $p\equiv3\pmod{4}$.
    \end{ejercicio}

    \begin{ejercicio}
        Si $m>1$, sean $p_1,\dots,p_k$ los divisores primos distintos de $\varphi(m)$. Si
        $(g,m)=1$, probar que $g$ es una raíz primitiva de $m$ si, y sólo si, $g$ no
        satisface ninguna de las congruencias $g^{\varphi(m)/p_i}\equiv1\pmod{m}$ para
        $i=1,2,\dots,k$.
    \end{ejercicio}

    \begin{ejercicio}
        El primo $p=71$ tiene 7 como raíz primitiva. Buscar todas las raíces primitivas de
        71 y también una raíz primitiva de $p^2$ y de $2p^2$.
    \end{ejercicio}

    \begin{ejercicio}
        Resolver cada una de las congruencias siguientes:
        \begin{enumerate}
            \item[(a)] $8x\equiv7\pmod{43}$.
            \item[(b)] $x^8\equiv17\pmod{43}$.
            \item[(c)] $8^x\equiv3\pmod{43}$.
        \end{enumerate}
    \end{ejercicio}

    \begin{ejercicio}
        Sea $q$ un primo impar y sea $p=4q+1$ también primo.
        \begin{enumerate}
            \item[(a)] Probar que la congruencia $x^2\equiv-1\pmod{p}$ tiene exactamente dos
            soluciones, y que cada una de ellas es un no resto cuadrático\index{no-resto cuadratico@No-resto cuadrático} de $p$.
            \item[(b)] Probar que cada no resto cuadrático\index{no-resto cuadratico@No-resto cuadrático} de $p$ es una raíz primitiva de
            $p$, con la excepción de los dos no restos de (a).
            \item[(c)] Hallar todas las raíces primitivas de 29.
        \end{enumerate}
    \end{ejercicio}

    \begin{ejercicio}
        (Extensión del ejercicio 10.17.) Sea $q$ un primo impar y supongamos que
        $p=2^nq+1$ es primo. Probar que cada no resto cuadrático $u$ de $p$ es una raíz
        primitiva de $p$ si $u^{2^n}\not\equiv1\pmod{p}$.
    \end{ejercicio}

    \begin{ejercicio}
        Probar que sólo existen dos caracteres reales primitivos mód 8 y construir una tabla
        que dé sus valores.
    \end{ejercicio}

    \begin{ejercicio}
        Sea $\chi$ un carácter real primitivo mód $m$. Si $m$ no es una potencia de 2 probar
        que $m$ tiene la forma
        \begin{equation*}
            m=2^{\alpha}p_1\cdots p_r
        \end{equation*}
        en donde los $p_i$ son primos distintos impares y $\alpha=0,2$ ó 3. Si $\alpha=0$
        probar que
        \begin{equation*}
            \chi(-1)=\prod_{p\mid m}(-1)^{(p-1)/2}
        \end{equation*}
        y hallar una fórmula análoga para $\chi(-1)$ cuando $\alpha=2$.
    \end{ejercicio}

\chapter{Series de Dirichlet y productos de Euler}

    \section{INTRODUCCIÓN}

    En 1737 Euler demostró el teorema de Euclides relativo a la existencia de una infinidad
    de números primos viendo que la serie $\sum p^{-1}$, extendida a todos los números
    primos, diverge. Este resultado lo dedujo del hecho de que la función zeta $\zeta(s)$,
    dada por
    \begin{equation}\label{eq:11-1}
        \zeta(s)=\sum_{n=1}^{\infty}\frac{1}{n^s}
    \end{equation}
    para valores reales $s>1$, tiende a $\infty$ cuando $s\to1$. En 1837, Dirichlet demostró
    su célebre teorema relativo a los primos existentes en una progresión aritmética
    estudiando la serie
    \begin{equation}\label{eq:11-2}
        L(s,\chi)=\sum_{n=1}^{\infty}\frac{\chi(n)}{n^s}
    \end{equation}
    en donde $\chi$ es un carácter de Dirichlet y $s>1$.\label{sim:Lsx}

    Las series \eqref{eq:11-1} y \eqref{eq:11-2} son ejemplos de series de la forma
    \begin{equation}\label{eq:11-3}
        \sum_{n=1}^{\infty}\frac{f(n)}{n^s}
    \end{equation}
    en donde $f(n)$ es una función aritmética. Estas series reciben el nombre de
    \textit{series de Dirichlet} de coeficientes $f(n)$. Estas series constituyen una de las
    herramientas más útiles de la Teoría analítica de números.

    Este capítulo estudia las propiedades generales de las series de Dirichlet. El capítulo
    siguiente efectúa un estudio más detallado de la función zeta de Riemann\index{riemann, georg friedrich bernhard@Riemann, Georg Friedrich Bernhard} $\zeta(s)$ y de
    las $L$-funciones de Dirichlet $L(s,\chi)$.

    \textbf{Notación.} De acuerdo con Riemann, sea $s$ una variable compleja y escribamos
    \begin{equation*}
        s=\sigma+it,
    \end{equation*}
    en donde $\sigma$ y $t$ son reales. Entonces
    $n^s=e^{s\log n}=e^{(\sigma+it)\log n}=n^{\sigma}e^{it\log n}$. Esto prueba que
    $\abs{n^s}=n^{\sigma}$ puesto que $\abs{e^{i\theta}}=1$ para $\theta$ real.

    El conjunto de puntos $s=\sigma+it$ tales que $\sigma>a$ se llama \textit{semiplano}.
    Demostraremos que, para cada serie de Dirichlet, existe un semiplano $\sigma>\sigma_c$
    en el que la serie converge, y otro semiplano $\sigma>\sigma_a$ en el que converge
    absolutamente. Probaremos además que, en el semiplano de convergencia\index{semiplano de convergencia@Semiplano de convergencia}, la serie
    representa una función analítica de la variable compleja $s$.

    \section{EL SEMIPLANO DE CONVERGENCIA ABSOLUTA DE UNA SERIE DE DIRICHLET}\label{sim:siga}
\index{semiplano de convergencia@Semiplano de convergencia}
    Observemos en primer lugar que, si $\sigma\geq a$, tenemos $\abs{n^s}=n^{\sigma}\geq n^a$,
    por lo tanto
    \begin{equation*}
        \abs{\frac{f(n)}{n^s}}\leq\frac{\abs{f(n)}}{n^a}.
    \end{equation*}
    Por consiguiente, si una serie de Dirichlet $\sum f(n)n^{-s}$ converge absolutamente para
    $s=a+ib$, entonces, por el criterio de comparación, converge también absolutamente para
    todo $s$ con $\sigma\geq a$.

    \begin{teorema}\label{teo:11-1}
        Suponemos que la serie $\sum\abs{f(n)n^{-s}}$ ni converge para todo $s$ ni diverge
        para todo $s$. Entonces existe un número real $\sigma_a$, llamado \textit{abscisa de
        convergencia absoluta}, tal que la serie $\sum f(n)n^{-s}$ converge absolutamente si
        $\sigma>\sigma_a$ pero, en cambio, no converge absolutamente, si $\sigma<\sigma_a$.
    \end{teorema}

    \begin{proof}
        Sea $D$ el conjunto de todos los números reales $\sigma$ tales que
        $\sum\abs{f(n)n^{-\sigma}}$ diverge. $D$ es no vacío puesto que esta serie no converge
        para todo $s$, y $D$ está acotado superiormente ya que la serie no diverge para todo
        $s$. Por consiguiente $D$ admite un supremo que llamaremos $\sigma_a$. Si
        $\sigma<\sigma_a$, entonces $\sigma\in D$, en otro caso $\sigma$ sería una cota
        superior de $D$ menor que su supremo. Si $\sigma>\sigma_a$, entonces $\sigma\notin D$
        puesto que $\sigma_a$ es el supremo de $D$. Esto demuestra el teorema.
    \end{proof}

    Nota. Si $\sum\abs{f(n)n^{-s}}$ converge para todo real, definimos $\sigma_a=-\infty$. Si
    la serie $\sum\abs{f(n)n^{-s}}$ no converge para ningún $s$, definimos $\sigma_a=+\infty$.

    \begin{ejemplo}
        \textit{Función zeta de Riemann\index{funcion zeta de riemann@Función zeta de Riemann}.} La serie de Dirichlet\index{dirichlet, series@Dirichlet, series} $\sum_{n=1}^{\infty}n^{-s}$
        converge absolutamente para $\sigma>1$. Cuando $s=1$ la serie diverge, por lo tanto
        $\sigma_a=1$. La suma de esta serie se designa $\zeta(s)$ y se llama función zeta de
        Riemann.
    \end{ejemplo}

    \begin{ejemplo}
        Si $f$ está acotada, o sea si $\abs{f(n)}\leq M$ para todo $n\geq1$, entonces
        $\sum f(n)n^{-s}$ converge absolutamente para $\sigma>1$, luego $\sigma_a\leq1$. En
        particular, si $\chi$ es un carácter de Dirichlet, la $L$-serie
        $L(s,\chi)=\sum\chi(n)n^{-s}$ converge absolutamente para $\sigma>1$.
    \end{ejemplo}

    \begin{ejemplo}
        La serie $\sum n^nn^{-s}$ diverge para cada $s$, luego $\sigma_a=+\infty$.
    \end{ejemplo}

    \begin{ejemplo}
        La serie $\sum n^{-n}n^{-s}$ converge absolutamente para todo $s$, luego
        $\sigma_a=-\infty$.
    \end{ejemplo}

    \section{LA FUNCIÓN DEFINIDA POR UNA SERIE DE DIRICHLET}

    Suponemos que $\sum f(n)n^{-s}$ converge absolutamente para $\sigma>\sigma_a$ y
    consideramos la función suma $F(s)$:
    \begin{equation}\label{eq:11-4}
        F(s)=\sum_{n=1}^{\infty}\frac{f(n)}{n^s}\qquad\text{para }\sigma>\sigma_a.
    \end{equation}
    En esta sección se obtienen algunas de las propiedades de $F(s)$. En primer lugar se
    demuestra el lema que sigue.

    \begin{lema}\label{lem:11-1}
        Si $N\geq1$ y $\sigma\geq c>\sigma_a$ tenemos
        \begin{equation*}
            \abs{\sum_{n=N}^{\infty}f(n)n^{-s}}\leq N^{-(\sigma-c)}\sum_{n=N}^{\infty}\abs{f(n)}n^{-c}.
        \end{equation*}
    \end{lema}

    \begin{proof}
        Tenemos
        \begin{equation*}
            \abs{\sum_{n=N}^{\infty}f(n)n^{-s}}\leq\sum_{n=N}^{\infty}\abs{f(n)}n^{-\sigma}
            =\sum_{n=N}^{\infty}\abs{f(n)}n^{-c}n^{-(\sigma-c)}
            \leq N^{-(\sigma-c)}\sum_{n=N}^{\infty}\abs{f(n)}n^{-c}.\qedhere
        \end{equation*}
    \end{proof}

    El teorema que sigue describe el comportamiento de $F(s)$ cuando $\sigma\to+\infty$.

    \begin{teorema}\label{teo:11-2}
        Si $F(s)$ está definida por \eqref{eq:11-4}, entonces
        \begin{equation*}
            \lim_{\sigma\to+\infty}F(\sigma+it)=f(1)
        \end{equation*}
        uniformemente para $-\infty<t<+\infty$.
    \end{teorema}

    \begin{proof}
        Puesto que $F(s)=f(1)+\sum_{n=2}^{\infty}f(n)n^{-s}$, únicamente debemos demostrar que
        el segundo término tiende a 0 cuando $\sigma\to+\infty$. Elegimos $c>\sigma_a$.
        Entonces para $\sigma\geq c$ el lema \ref{lem:11-1} implica
        \begin{equation*}
            \abs{\sum_{n=2}^{\infty}\frac{f(n)}{n^s}}\leq2^{-(\sigma-c)}\sum_{n=2}^{\infty}\abs{f(n)}n^{-c}=\frac{A}{2^{\sigma}}
        \end{equation*}
        en donde $A$ es independiente de $\sigma$ y de $t$. Dado que $A/2^{\sigma}\to0$ cuando
        $\sigma\to+\infty$ el teorema queda establecido.
    \end{proof}

    \textbf{Ejemplos.} $\zeta(\sigma+it)\to1$ y $L(\sigma+it,\chi)\to1$ cuando
    $\sigma\to+\infty$.

    A continuación vemos que todos los coeficientes están unívocamente determinados por la
    función suma.

    \begin{teorema}[Teorema de unicidad]\label{teo:11-3}
        Dadas dos series de Dirichlet
        \begin{equation*}
            F(s)=\sum_{n=1}^{\infty}\frac{f(n)}{n^s}\qquad\text{y}\qquad G(s)=\sum_{n=1}^{\infty}\frac{g(n)}{n^s},
        \end{equation*}
        ambas absolutamente convergentes para $\sigma>\sigma_a$. Si $F(s)=G(s)$ para cada $s$
        de una sucesión infinita $\{s_k\}$ tal que $\sigma_k\to+\infty$ cuando
        $k\to+\infty$, entonces $f(n)=g(n)$ para cada $n$.
    \end{teorema}

    \begin{proof}
        Sea $h(n)=f(n)-g(n)$ y sea $H(s)=F(s)-G(s)$. Entonces $H(s_k)=0$ para cada $k$. Para
        probar que $h(n)=0$ para todo $n$, supongamos que $h(n)\neq0$ para un cierto $n$ y
        obtendremos una contradicción.

        Sea $N$ el menor entero tal que $h(n)\neq0$. Entonces
        \begin{equation*}
            H(s)=\sum_{n=N}^{\infty}\frac{h(n)}{n^s}=\frac{h(N)}{N^s}+\sum_{n=N+1}^{\infty}\frac{h(n)}{n^s}.
        \end{equation*}
        Luego
        \begin{equation*}
            h(N)=N^sH(s)-N^s\sum_{n=N+1}^{\infty}\frac{h(n)}{n^s}.
        \end{equation*}
        Si hacemos $s=s_k$ tenemos $H(s_k)=0$ luego
        \begin{equation*}
            h(N)=-N^{s_k}\sum_{n=N+1}^{\infty}h(n)n^{-s_k}.
        \end{equation*}
        Elegimos $k$ tal que $\sigma_k>c$ en donde $c>\sigma_a$. Entonces el lema
        \ref{lem:11-1} implica
        \begin{equation*}
            \abs{h(N)}\leq N^{\sigma_k}(N+1)^{-(\sigma_k-c)}\sum_{n=N+1}^{\infty}\abs{h(n)}n^{-c}=\left(\frac{N}{N+1}\right)^{\sigma_k}A
        \end{equation*}
        en donde $A$ no depende de $k$. Si hacemos que $k\to\infty$ obtenemos
        $(N/(N+1))^{\sigma_k}\to0$ luego $h(N)=0$, que es una contradicción.
    \end{proof}

    El teorema de unicidad implica la existencia de un semiplano en el cual la serie de
    Dirichlet no puede anularse (al menos que se anule idénticamente).

    \begin{teorema}\label{teo:11-4}
        Sea $F(s)=\sum f(n)n^{-s}$ y supongamos que $F(s)\neq0$ para un cierto $s$ con
        $\sigma>\sigma_a$. Entonces existe un semiplano $\sigma>c\geq\sigma_a$ en el que
        $F(s)$ nunca es cero.
    \end{teorema}

    \begin{proof}
        Supongamos que tal semiplano no existe. Entonces, para cada $k=1,2,\dots$ existe un
        punto $s_k$ con $\sigma_k>k$ tal que $F(s_k)=0$. Dado que $\sigma_k\to+\infty$ cuando
        $k\to\infty$ el teorema de unicidad prueba que $f(n)=0$ para todo $n$, en
        contradicción con la hipótesis de que $F(s)\neq0$ para un $s$.
    \end{proof}

    \section{MULTIPLICACIÓN DE SERIES DE DIRICHLET}

    El teorema que sigue relaciona los productos de series de Dirichlet con la convolución de
    Dirichlet de sus coeficientes.

    \begin{teorema}\label{teo:11-5}
        Dadas dos funciones $F(s)$ y $G(s)$ representadas por dos series de Dirichlet,
        \begin{equation*}
            F(s)=\sum_{n=1}^{\infty}\frac{f(n)}{n^s}\quad\text{para }\sigma>a,
        \end{equation*}
        y
        \begin{equation*}
            G(s)=\sum_{n=1}^{\infty}\frac{g(n)}{n^s}\quad\text{para }\sigma>b.
        \end{equation*}
        Entonces, en el semiplano en el que ambas series convergen absolutamente, tenemos
        \begin{equation}\label{eq:11-5}
            F(s)G(s)=\sum_{n=1}^{\infty}\frac{h(n)}{n^s},
        \end{equation}
        en donde $h=f*g$ es la convolución de Dirichlet de $f$ y $g$:
        \begin{equation*}
            h(n)=\sum_{d\mid n}f(d)g\left(\frac{n}{d}\right).
        \end{equation*}
        Recíprocamente, si $F(s)G(s)=\sum\alpha(n)n^{-s}$ para todo $s$ de una sucesión
        $\{s_k\}$ con $\sigma_k\to+\infty$ cuando $k\to\infty$, entonces $\alpha=f*g$.
    \end{teorema}

    \begin{proof}
        Para todo $s$ en el que ambas series converjan absolutamente tenemos
        \begin{equation*}
            F(s)G(s)=\sum_{n=1}^{\infty}f(n)n^{-s}\sum_{m=1}^{\infty}g(m)m^{-s}
            =\sum_{n=1}^{\infty}\sum_{m=1}^{\infty}f(n)g(m)(mn)^{-s}.
        \end{equation*}
        En virtud de la convergencia absoluta podemos multiplicar estas series y reordenar
        sus términos convenientemente sin que ello altere la suma. Juntamos los términos para
        los que $mn$ es constante, $mn=k$. Los posibles valores de $k$ son $1,2,\dots$, luego
        \begin{equation*}
            F(s)G(s)=\sum_{k=1}^{\infty}\left(\sum_{mn=k}f(n)g(m)\right)k^{-s}=\sum_{k=1}^{\infty}h(k)k^{-s}
        \end{equation*}
        en donde $h(k)=\sum_{mn=k}f(n)g(m)=(f*g)(k)$. Hemos demostrado la primera afirmación y
        la segunda se sigue inmediatamente del teorema de unicidad.
    \end{proof}

    \begin{ejemplo}
        Las series $\sum n^{-s}$ y $\sum\mu(n)n^{-s}$ convergen absolutamente para
        $\sigma>1$. Si hacemos $f(n)=1$ y $g(n)=\mu(n)$ en \eqref{eq:11-5} obtenemos
        $h(n)=[1/n]$, luego
        \begin{equation*}
            \zeta(s)\sum_{n=1}^{\infty}\frac{\mu(n)}{n^s}=1\qquad\text{si }\sigma>1.
        \end{equation*}
        En particular, esto prueba que $\zeta(s)\neq0$ para $\sigma>1$ y que
        \begin{equation*}
            \sum_{n=1}^{\infty}\frac{\mu(n)}{n^s}=\frac{1}{\zeta(s)}\qquad\text{si }\sigma>1.
        \end{equation*}
    \end{ejemplo}

    \begin{ejemplo}
        Con más generalidad, suponemos $f(1)\neq0$, y sea $g=f^{-1}$, la serie de Dirichlet\index{dirichlet, series@Dirichlet, series}
        inversa de $f$. Entonces en todo semiplano en el que ambas series
        $F(s)=\sum f(n)n^{-s}$ y $G(s)=\sum g(n)n^{-s}$ convergen absolutamente tenemos
        $F(s)\neq0$ y $G(s)=1/F(s)$.
    \end{ejemplo}

    \begin{ejemplo}
        Suponemos que $F(s)=\sum f(n)n^{-s}$ converge absolutamente para $\sigma>\sigma_a$.
        Si $f$ es completamente multiplicativa\index{funcion completamente multiplicativa@Función completamente multiplicativa} tenemos $f^{-1}(n)=\mu(n)f(n)$. Como
        $\abs{f^{-1}(n)}\leq\abs{f(n)}$, la serie $\sum\mu(n)f(n)n^{-s}$ también converge
        absolutamente para $\sigma>\sigma_a$ y tenemos
        \begin{equation*}
            \sum_{n=1}^{\infty}\frac{\mu(n)f(n)}{n^s}=\frac{1}{F(s)}\qquad\text{si }\sigma>\sigma_a.
        \end{equation*}
        En particular, para cada carácter de Dirichlet $\chi$, tenemos
        \begin{equation*}
            \sum_{n=1}^{\infty}\frac{\mu(n)\chi(n)}{n^s}=\frac{1}{L(s,\chi)}\qquad\text{si }\sigma>1.
        \end{equation*}
    \end{ejemplo}

    \begin{ejemplo}
        Tomamos $f(n)=1$ y $g(n)=\varphi(n)$, indicatriz de Euler\index{funcion indicatriz varphi(n)@Función indicatriz $\varphi(n)$}. Como $\varphi(n)\leq n$, la
        serie $\sum\varphi(n)n^{-s}$ converge absolutamente para $\sigma>2$. Luego
        $h(n)=\sum_{d\mid n}\varphi(d)=n$, y \eqref{eq:11-5} nos proporciona
        \begin{equation*}
            \zeta(s)\sum_{n=1}^{\infty}\frac{\varphi(n)}{n^s}=\sum_{n=1}^{\infty}\frac{n}{n^s}=\zeta(s-1)\qquad\text{si }\sigma>2.
        \end{equation*}
        Por consiguiente
        \begin{equation*}
            \sum_{n=1}^{\infty}\frac{\varphi(n)}{n^s}=\frac{\zeta(s-1)}{\zeta(s)}\qquad\text{si }\sigma>2.
        \end{equation*}
    \end{ejemplo}

    \begin{ejemplo}
        Hacemos $f(n)=1$ y $g(n)=n^{\alpha}$. Entonces $h(n)=\sum_{d\mid n}d^{\alpha}=\sigma_{\alpha}(n)$, y
        \eqref{eq:11-5} nos proporciona
        \begin{equation*}
            \zeta(s)\zeta(s-\alpha)=\sum_{n=1}^{\infty}\frac{\sigma_{\alpha}(n)}{n^s}\qquad\text{si }\sigma>\max\{1,1+\operatorname{Re}(\alpha)\}.
        \end{equation*}
    \end{ejemplo}

    \begin{ejemplo}
        Hacemos $f(n)=1$ y $g(n)=\lambda(n)$, función de Liouville\index{funcion lambda(n) de liouville@Función $\lambda(n)$ de Liouville}\index{liouville, joseph@Liouville, Joseph}. Entonces
        \begin{equation*}
            h(n)=\sum_{d\mid n}\lambda(d)=
            \begin{cases}
                1&\text{si }n=m^2\text{ para un }m,\\
                0&\text{en otro caso,}
            \end{cases}
        \end{equation*}
        luego \eqref{eq:11-5} nos proporciona
        \begin{equation*}
            \zeta(s)\sum_{n=1}^{\infty}\frac{\lambda(n)}{n^s}=\sum_{\substack{n=1\\n=\text{cuadrado}}}^{\infty}\frac{1}{n^s}=\sum_{m=1}^{\infty}\frac{1}{m^{2s}}=\zeta(2s).
        \end{equation*}
        Por lo tanto
        \begin{equation*}
            \sum_{n=1}^{\infty}\frac{\lambda(n)}{n^s}=\frac{\zeta(2s)}{\zeta(s)}\qquad\text{si }\sigma>1.
        \end{equation*}
    \end{ejemplo}

    \section{PRODUCTOS DE EULER}
\index{productos de euler@Productos de Euler}
    El próximo teorema, descubierto por Euler en 1737, a veces se denomina versión analítica
    del teorema fundamental de la Aritmética\index{teorema@Teorema!fundamental de la aritmetica@fundamental de la Aritmética}.

    \begin{teorema}\label{teo:11-6}
        Sea $f$ una función aritmética multiplicativa tal que la serie $\sum f(n)$ es
        absolutamente convergente. Entonces la suma de la serie se puede expresar como un
        producto infinito absolutamente convergente,
        \begin{equation}\label{eq:11-6}
            \sum_{n=1}^{\infty}f(n)=\prod_p\left\{1+f(p)+f(p^2)+\cdots\right\}
        \end{equation}
        extendido al conjunto de todos los números primos. Si $f$ es completamente
        multiplicativa, el producto se simplifica y se tiene
        \begin{equation}\label{eq:11-7}
            \sum_{n=1}^{\infty}f(n)=\prod_p\frac{1}{1-f(p)}.
        \end{equation}
    \end{teorema}

    Nota. En cada uno de los casos el producto se llama \textit{producto de Euler\index{productos de euler@Productos de Euler}} de la
    serie.

    \begin{proof}
        Consideremos el producto finito
        \begin{equation*}
            P(x)=\prod_{p\leq x}\left\{1+f(p)+f(p^2)+\cdots\right\}
        \end{equation*}
        extendido a todos los números primos $p\leq x$. Como es el producto de un número
        finito de términos de una serie absolutamente convergente podemos multiplicar la
        serie y reordenar sus términos arbitrariamente sin que se altere la suma. Un término
        tipo es de la forma
        \begin{equation*}
            f(p_1^{a_1})f(p_2^{a_2})\cdots f(p_r^{a_r})=f(p_1^{a_1}p_2^{a_2}\cdots p_r^{a_r})
        \end{equation*}
        ya que $f$ es multiplicativa. Por el teorema fundamental de la Aritmética\index{teorema@Teorema!fundamental de la aritmetica@fundamental de la Aritmética} podemos
        escribir
        \begin{equation*}
            P(x)=\sum_{n\in A}f(n)
        \end{equation*}
        en donde $A$ consta de todos los $n$ cuya descomposición tiene factores primos
        $\leq x$. Por consiguiente
        \begin{equation*}
            \sum_{n=1}^{\infty}f(n)-P(x)=\sum_{n\in B}f(n),
        \end{equation*}
        en donde $B$ es el conjunto de los $n$ que tienen por lo menos un factor primo $>x$.
        Por consiguiente
        \begin{equation*}
            \abs{\sum_{n=1}^{\infty}f(n)-P(x)}\leq\sum_{n\in B}\abs{f(n)}\leq\sum_{n>x}\abs{f(n)}.
        \end{equation*}
        Cuando $x\to\infty$ la última suma de la derecha tiende a 0 puesto que $\sum\abs{f(n)}$
        es convergente. Luego $P(x)\to\sum f(n)$ cuando $x\to\infty$.

        Ahora bien, un producto infinito de la forma $\prod(1+a_n)$ converge absolutamente
        siempre que la serie asociada $\sum a_n$ converge absolutamente. En este caso
        tenemos
        \begin{equation*}
            \sum_{p\leq x}\abs{f(p)+f(p^2)+\cdots}\leq\sum_{p\leq x}\left(\abs{f(p)}+\abs{f(p^2)}+\cdots\right)\leq\sum_{n=2}^{\infty}\abs{f(n)}.
        \end{equation*}
        Al estar acotadas todas las sumas parciales, la serie de términos positivos
        \begin{equation*}
            \sum_p\abs{f(p)+f(p^2)+\cdots}
        \end{equation*}
        converge, y este resultado implica la convergencia absoluta del producto
        \eqref{eq:11-6}.

        Finalmente, cuando $f$ es completamente multiplicativa tenemos $f(p^a)=f(p)^a$ y cada
        serie de la derecha de \eqref{eq:11-6} es una serie geométrica convergente cuya suma
        es $(1-f(p))^{-1}$.
    \end{proof}

    Aplicando el teorema \ref{teo:11-6} a las series de Dirichlet absolutamente convergentes
    obtenemos inmediatamente:

    \begin{teorema}\label{teo:11-7}
        Suponemos que $\sum f(n)n^{-s}$ converge absolutamente para $\sigma>\sigma_a$. Si $f$
        es multiplicativa tenemos
        \begin{equation}\label{eq:11-8}
            \sum_{n=1}^{\infty}\frac{f(n)}{n^s}=\prod_p\left\{1+\frac{f(p)}{p^s}+\frac{f(p^2)}{p^{2s}}+\cdots\right\}\qquad\text{si }\sigma>\sigma_a.
        \end{equation}
        y si $f$ es completamente multiplicativa tenemos
        \begin{equation*}
            \sum_{n=1}^{\infty}\frac{f(n)}{n^s}=\prod_p\frac{1}{1-f(p)p^{-s}}\qquad\text{si }\sigma>\sigma_a.
        \end{equation*}
    \end{teorema}

    Obsérvese que el término general del producto \eqref{eq:11-8} es la serie de Bell
    $f_p(x)$ de la función $f$ con $x=p^{-s}$. (Ver sección 2.16.)

    \textbf{Ejemplos.} Hacemos $f(n)=1$, $\mu(n)$, $\sigma_{\alpha}(n)$, $\lambda(n)$ y
    $\chi(n)$, respectivamente, y obtenemos los siguientes productos de Euler\index{productos de euler@Productos de Euler}:
    \begin{align*}
        \zeta(s)&=\sum_{n=1}^{\infty}\frac{1}{n^s}=\prod_p\frac{1}{1-p^{-s}}&&\text{si }\sigma>1.\\
        \frac{1}{\zeta(s)}&=\sum_{n=1}^{\infty}\frac{\mu(n)}{n^s}=\prod_p(1-p^{-s})&&\text{si }\sigma>1.\\
        \frac{\zeta(s-1)}{\zeta(s)}&=\sum_{n=1}^{\infty}\frac{\varphi(n)}{n^s}=\prod_p\frac{1-p^{-s}}{1-p^{1-s}}&&\text{si }\sigma>2.\\
        \zeta(s)\zeta(s-\alpha)&=\sum_{n=1}^{\infty}\frac{\sigma_{\alpha}(n)}{n^s}=\prod_p\frac{1}{(1-p^{-s})(1-p^{\alpha-s})}&&\text{si }\sigma>\max\{1,1+\operatorname{Re}(\alpha)\}.\\
        \frac{\zeta(2s)}{\zeta(s)}&=\sum_{n=1}^{\infty}\frac{\lambda(n)}{n^s}=\prod_p\frac{1}{1+p^{-s}}&&\text{si }\sigma>1.\\
        L(s,\chi)&=\sum_{n=1}^{\infty}\frac{\chi(n)}{n^s}=\prod_p\frac{1}{1-\chi(p)p^{-s}}&&\text{si }\sigma>1.
    \end{align*}

    Nota. Si $\chi=\chi_1$ es el carácter principal mód $k$, entonces $\chi_1(p)=0$ si $p\mid k$
    y $\chi_1(p)=1$ si $p\nmid k$, luego el producto de Euler\index{productos de euler@Productos de Euler} para $L(s,\chi_1)$ se convierte
    en
    \begin{equation*}
        L(s,\chi_1)=\prod_{p\nmid k}\frac{1}{1-p^{-s}}=\prod_p\frac{1}{1-p^{-s}}\cdot\prod_{p\mid k}(1-p^{-s})=\zeta(s)\prod_{p\mid k}(1-p^{-s}).
    \end{equation*}
    Entonces la $L$-función $L(s,\chi_1)$ es igual a la función zeta $\zeta(s)$ multiplicada
    por un número finito de factores.

    \section{EL SEMIPLANO DE CONVERGENCIA DE UNA SERIE DE DIRICHLET}\label{sim:sigc}
\index{semiplano de convergencia@Semiplano de convergencia}
    Para demostrar la existencia del semiplano de convergencia utilizaremos el lema que
    sigue.

    \begin{lema}\label{lem:11-2}
        Sea $s_0=\sigma_0+it_0$ y supongamos que la serie de Dirichlet $\sum f(n)n^{-s_0}$
        tiene sumas parciales acotadas, o sea
        \begin{equation*}
            \abs{\sum_{n\leq x}f(n)n^{-s_0}}\leq M
        \end{equation*}
        para todo $x\geq1$. Entonces, para cada $s$ con $\sigma>\sigma_0$, tenemos
        \begin{equation}\label{eq:11-9}
            \abs{\sum_{a<n\leq b}f(n)n^{-s}}\leq2Ma^{\sigma_0-\sigma}\left(1+\frac{\abs{s-s_0}}{\sigma-\sigma_0}\right).
        \end{equation}
    \end{lema}

    \begin{proof}
        Sea $a(n)=f(n)n^{-s_0}$ y sea $A(x)=\sum_{n\leq x}a(n)$. Entonces
        $f(n)n^{-s}=a(n)n^{s_0-s}$ por lo que podemos aplicar el teorema 4.2 (con
        $f(x)=x^{s_0-s}$) y obtenemos
        \begin{equation*}
            \sum_{a<n\leq b}f(n)n^{-s}=A(b)b^{s_0-s}-A(a)a^{s_0-s}+(s-s_0)\int_a^bA(t)t^{s_0-s-1}\,dt.
        \end{equation*}
        Pero, al ser $\abs{A(x)}\leq M$ resulta
        \begin{align*}
            \abs{\sum_{a<n\leq b}f(n)n^{-s}}&\leq Mb^{\sigma_0-\sigma}+Ma^{\sigma_0-\sigma}+\abs{s-s_0}M\int_a^bt^{\sigma_0-\sigma-1}\,dt\\
            &\leq2Ma^{\sigma_0-\sigma}+\abs{s-s_0}M\abs{\frac{b^{\sigma_0-\sigma}-a^{\sigma_0-\sigma}}{\sigma_0-\sigma}}\\
            &\leq2Ma^{\sigma_0-\sigma}\left(1+\frac{\abs{s-s_0}}{\sigma-\sigma_0}\right).\qedhere
        \end{align*}
    \end{proof}

    \textbf{Ejemplos.} Si las sumas parciales $\sum_{n\leq x}f(n)$ están acotadas, el lema
    \ref{lem:11-2} implica que $\sum f(n)n^{-s}$ converge para $\sigma>0$. En efecto, si
    hacemos $s_0=\sigma_0=0$ en \eqref{eq:11-9} obtenemos, para $\sigma>0$,
    \begin{equation*}
        \abs{\sum_{a<n\leq b}f(n)n^{-s}}\leq Ka^{-\sigma}
    \end{equation*}
    en donde $K$ es independiente de $a$. Si hacemos que $a\to+\infty$ vemos que
    $\sum f(n)n^{-s}$ converge si $\sigma>0$. En particular este hecho prueba que la serie de
    Dirichlet\index{dirichlet, peter gustav lejeune@Dirichlet, Peter Gustav Lejeune}
    \begin{equation*}
        \sum_{n=1}^{\infty}\frac{(-1)^n}{n^s}
    \end{equation*}
    converge para $\sigma>0$ ya que $\abs{\sum_{n\leq x}(-1)^n}\leq1$. Análogamente, si
    $\chi$ es un carácter de Dirichlet, mód $k$, no principal, tenemos
    $\abs{\sum_{n\leq x}\chi(n)}\leq\varphi(k)$, luego
    \begin{equation*}
        \sum_{n=1}^{\infty}\frac{\chi(n)}{n^s}
    \end{equation*}
    converge para $\sigma>0$. El mismo tipo de razonamiento lleva al siguiente teorema.

    \begin{teorema}\label{teo:11-8}
        Si la serie $\sum f(n)n^{-s}$ converge para $s=\sigma_0+it_0$, entonces también
        converge para todo $s$ con $\sigma>\sigma_0$. Si diverge para $s=\sigma_0+it_0$,
        diverge también para todo $s$ con $\sigma<\sigma_0$.
    \end{teorema}

    \begin{proof}
        La segunda afirmación se sigue de la primera. Para demostrar la primera afirmación,
        elegimos un $s$ con $\sigma>\sigma_0$. El lema \ref{lem:11-2} prueba que
        \begin{equation*}
            \abs{\sum_{a<n\leq b}f(n)n^{-s}}\leq Ka^{\sigma_0-\sigma}
        \end{equation*}
        en donde $K$ no depende de $a$. Como $a^{\sigma_0-\sigma}\to0$ cuando $a\to+\infty$,
        la condición de Cauchy\index{cauchy, augustin-louis@Cauchy, Augustin-Louis} prueba que $\sum f(n)n^{-s}$ converge.
    \end{proof}

    \begin{teorema}\label{teo:11-9}
        Si la serie $\sum f(n)n^{-s}$ no converge para todo $s$ o no diverge para todo $s$,
        entonces existe un número real $\sigma_c$, llamado la \textit{abscisa de
        convergencia}, tal que la serie converge para todo $s$ del semiplano $\sigma>\sigma_c$
        y diverge para todo $s$ del semiplano $\sigma<\sigma_c$.
    \end{teorema}

    \begin{proof}
        Se razona como en la demostración del teorema \ref{teo:11-1}, tomando $\sigma_c$ igual
        al ínfimo de todos los $\sigma$ tales que $\sum f(n)n^{-s}$ converge.
    \end{proof}

    Nota. Si la serie converge para todo $s$ definimos $\sigma_c=-\infty$, y si no converge en
    ningún punto definimos $\sigma_c=+\infty$.

    Como la convergencia absoluta implica la convergencia, en cualquier caso tenemos
    $\sigma_a\geq\sigma_c$. Si $\sigma_a>\sigma_c$, existe un intervalo infinito
    $\sigma_c<\sigma<\sigma_a$ en el que la serie converge condicionalmente. (Ver figura
    11.1.) El teorema que sigue prueba que la amplitud de dicho intervalo no excede a 1.

    \begin{teorema}\label{teo:11-10}
        Para toda serie de Dirichlet con $\sigma_c$ finito tenemos
        \begin{equation*}
            0\leq\sigma_a-\sigma_c\leq1.
        \end{equation*}
    \end{teorema}

    \begin{figure}[H]
        \centering
        \includegraphics{figuras/figura11-1.pdf}
        \caption{}
    \end{figure}

    \begin{proof}
        Basta demostrar que, si $\sum f(n)n^{-s}$ converge para un cierto $s_0$, entonces
        converge absolutamente para todo $s$ con $\sigma>\sigma_0+1$. Sea $A$ una cota
        superior del conjunto de números $\abs{f(n)n^{-s_0}}$. Entonces
        \begin{equation*}
            \abs{\frac{f(n)}{n^s}}=\abs{\frac{f(n)}{n^{s_0}}}\abs{\frac{1}{n^{s-s_0}}}\leq\frac{A}{n^{\sigma-\sigma_0}}
        \end{equation*}
        luego $\sum\abs{f(n)n^{-s}}$ converge por comparación con $\sum n^{\sigma_0-\sigma}$.
    \end{proof}

    \begin{ejemplo}
        La serie
        \begin{equation*}
            \sum_{n=1}^{\infty}\frac{(-1)^n}{n^s}
        \end{equation*}
        converge si $\sigma>0$, pero la convergencia únicamente es absoluta si $\sigma>1$. Por
        consiguiente en este ejemplo $\sigma_c=0$ y $\sigma_a=1$.
    \end{ejemplo}

    Las propiedades de convergencia de las series de Dirichlet se pueden comparar con las
    propiedades de convergencia de las series de potencias. Cada serie de potencias posee un
    disco de convergencia, mientras que cada serie de Dirichlet\index{dirichlet, series@Dirichlet, series} admite un semiplano de
    convergencia. Para las series de potencias el interior del disco de convergencia es
    también el dominio de convergencia absoluta. Para las series de Dirichlet el dominio de
    convergencia absoluta puede constituir un subconjunto propio del dominio de convergencia.
    Una serie de potencias representa una función analítica en el interior de su disco de
    convergencia. A continuación demostraremos que una serie de Dirichlet representa una
    función analítica en el interior del semiplano de convergencia\index{semiplano de convergencia@Semiplano de convergencia}.

    \section{PROPIEDADES ANALÍTICAS DE LAS SERIES DE DIRICHLET}

    Las propiedades de las series de Dirichlet se deducirán del siguiente teorema general
    relativo a la teoría de funciones complejas, que damos como lema.

    \begin{lema}\label{lem:11-3}
        Sea $\{f_n\}$ una sucesión de funciones analíticas en un conjunto abierto $S$ del
        plano complejo, y supongamos que $\{f_n\}$ converge uniformemente en cada subconjunto
        compacto de $S$ hacia una función límite $f$. Entonces $f$ es una función analítica en
        $S$ y la sucesión de derivadas $\{f_n'\}$ converge uniformemente en cada subconjunto
        compacto de $S$ hacia la derivada $f'$.
    \end{lema}

    \begin{proof}
        Por ser $f_n$ analítica en $S$ tenemos la fórmula integral de Cauchy
        \begin{equation*}
            f_n(a)=\frac{1}{2\pi i}\int_{\partial D}\frac{f_n(z)}{z-a}\,dz
        \end{equation*}
        en donde $D$ es un disco compacto arbitrario de $S$, $\partial D$ es su frontera
        orientada positivamente, y $a$ es un punto interior de $D$. En virtud de la
        convergencia uniforme podemos introducir el límite bajo el signo integral y obtener
        \begin{equation*}
            f(a)=\frac{1}{2\pi i}\int_{\partial D}\frac{f(z)}{z-a}\,dz
        \end{equation*}
        que implica que $f$ es analítica en el interior de $D$. Para las derivadas tenemos
        \begin{equation*}
            f_n'(a)=\frac{1}{2\pi i}\int_{\partial D}\frac{f_n(z)}{(z-a)^2}\,dz\qquad\text{y}\qquad f'(a)=\frac{1}{2\pi i}\int_{\partial D}\frac{f(z)}{(z-a)^2}\,dz
        \end{equation*}
        de donde fácilmente se obtiene que $f_n'(a)\to f'(a)$ uniformemente en cada
        subconjunto compacto de $S$ cuando $n\to\infty$.
    \end{proof}

    Para aplicar el lema a las series de Dirichlet probaremos en primer lugar que tenemos
    convergencia uniforme en los subconjuntos compactos del semiplano de convergencia\index{semiplano de convergencia@Semiplano de convergencia}.

    \begin{teorema}\label{teo:11-11}
        Una serie de Dirichlet\index{dirichlet, series@Dirichlet, series} $\sum f(n)n^{-s}$ converge uniformemente en cada subconjunto
        compacto perteneciente al interior del semiplano de convergencia\index{semiplano de convergencia@Semiplano de convergencia} $\sigma>\sigma_c$.
    \end{teorema}

    \begin{proof}
        Basta probar que $\sum f(n)n^{-s}$ converge uniformemente en cada rectángulo compacto
        $R=[\alpha,\beta]\times[c,d]$ con $\alpha>\sigma_c$. Para ello utilizamos la acotación
        obtenida en el lema \ref{lem:11-2}:
        \begin{equation}\label{eq:11-10}
            \abs{\sum_{a<n\leq b}f(n)n^{-s}}\leq2Ma^{\sigma_0-\sigma}\left(1+\frac{\abs{s-s_0}}{\sigma-\sigma_0}\right)
        \end{equation}
        en donde $s_0=\sigma_0+it_0$ es un punto arbitrario del semiplano $\sigma>\sigma_c$ y
        $s$ es un punto arbitrario con $\sigma>\sigma_0$. Elegimos $s_0=\sigma_0$, en donde
        $\sigma_c<\sigma_0<\alpha$. (Ver figura 11.2.)

        \begin{figure}[H]
            \centering
            \includegraphics{figuras/figura11-2.pdf}
            \caption{}
        \end{figure}

        Entonces, si $s\in R$, tenemos $\sigma-\sigma_0\geq\alpha-\sigma_0$ y
        $\abs{s_0-s}<C$, en donde $C$ es una constante que depende de $s_0$ y de $R$ pero, en
        cambio, no depende de $s$. Entonces \eqref{eq:11-10} implica
        \begin{equation*}
            \abs{\sum_{a<n\leq b}f(n)n^{-s}}\leq2Ma^{\sigma_0-\alpha}\left(1+\frac{C}{\alpha-\sigma_0}\right)=Ba^{\sigma_0-\alpha}
        \end{equation*}
        en donde $B$ es independiente de $s$. Como $a^{\sigma_0-\alpha}\to0$ cuando
        $a\to+\infty$ se verifica la condición de Cauchy\index{cauchy, augustin-louis@Cauchy, Augustin-Louis} de la convergencia uniforme.
    \end{proof}

    \begin{teorema}\label{teo:11-12}
        La función suma $F(s)=\sum f(n)n^{-s}$ de una serie de Dirichlet es analítica en su
        semiplano de convergencia $\sigma>\sigma_c$, y su derivada $F'(s)$ se halla
        representada en dicho semiplano por la serie de Dirichlet
        \begin{equation}\label{eq:11-11}
            F'(s)=-\sum_{n=1}^{\infty}\frac{f(n)\log n}{n^s},
        \end{equation}
        obtenida derivando término a término.
    \end{teorema}

    \begin{proof}
        Aplicamos el teorema \ref{teo:11-11} y el lema \ref{lem:11-3} a la sucesión de las
        sumas parciales.
    \end{proof}

    \textbf{Notas.} La serie derivada \eqref{eq:11-11} tiene la misma abscisa de convergencia\index{abscisa@Abscisa!de convergencia@de convergencia}
    y la misma abscisa de convergencia absoluta\index{abscisa@Abscisa!de convergencia absoluta@de convergencia absoluta} que la serie relativa a $F(s)$.

    Aplicando repetidamente el teorema \ref{teo:11-12}, obtenemos que la $k$-ésima derivada se
    halla expresada por
    \begin{equation*}
        F^{(k)}(s)=(-1)^k\sum_{n=1}^{\infty}\frac{f(n)(\log n)^k}{n^s}\qquad\text{para }\sigma>\sigma_c.
    \end{equation*}

    \textbf{Ejemplos.} Para $\sigma>1$ tenemos
    \begin{equation}\label{eq:11-12}
        \zeta'(s)=-\sum_{n=1}^{\infty}\frac{\log n}{n^s}
    \end{equation}
    y
    \begin{equation}\label{eq:11-13}
        -\frac{\zeta'(s)}{\zeta(s)}=\sum_{n=1}^{\infty}\frac{\Lambda(n)}{n^s}.
    \end{equation}
    La ecuación \eqref{eq:11-12} se obtiene derivando término a término la serie
    correspondiente a la función zeta, y \eqref{eq:11-13} se obtiene multiplicando las dos
    series de Dirichlet $\sum\Lambda(n)n^{-s}$ y $\sum n^{-s}$ y utilizando la identidad
    $\sum_{d\mid n}\Lambda(d)=\log n$.

    \section{SERIES DE DIRICHLET CON COEFICIENTES NO NEGATIVOS}

    Algunas funciones definidas por medio de series de Dirichlet en su semiplano de
    convergencia $\sigma>\sigma_c$ se pueden prolongar analíticamente más allá de la recta
    $\sigma=\sigma_c$. Por ejemplo, en el capítulo que sigue demostraremos que la función zeta
    de Riemann\index{riemann, georg friedrich bernhard@Riemann, Georg Friedrich Bernhard} $\zeta(s)$ se puede prolongar analíticamente al otro lado de la recta
    $\sigma=1$ a una función que es analítica para todo $s$ salvo en un polo simple, en
    $s=1$. Análogamente, si $\chi$ es un carácter de Dirichlet no principal, la $L$-función
    $L(s,\chi)$ se puede prolongar analíticamente al otro lado de la recta $\sigma=1$ a una
    función entera (analítica para todo $s$). La singularidad de la función zeta se explica
    por el teorema de Landau\index{landau, edmund@Landau, Edmund}\index{teorema@Teorema!de landau@de Landau} que sigue referente a series de Dirichlet\index{dirichlet, series@Dirichlet, series} con coeficientes no
    negativos.

    \begin{teorema}[Landau]\label{teo:11-13}
        \index{landau, edmund@Landau, Edmund}Sea $F(s)$ representada en el semiplano $\sigma>c$ por la serie de Dirichlet
        \begin{equation}\label{eq:11-14}
            F(s)=\sum_{n=1}^{\infty}\frac{f(n)}{n^s},
        \end{equation}
        en donde $c$ es finito, y supongamos que $f(n)\geq0$ para todo $n\geq n_0$. Si $F(s)$
        es analítica en un disco que contiene en su interior el punto $s=c$, entonces la serie
        de Dirichlet converge en el semiplano $\sigma>c-\varepsilon$ para un $\varepsilon>0$.
        En consecuencia, si la serie de Dirichlet posee abscisa de convergencia\index{abscisa@Abscisa!de convergencia@de convergencia} finita
        $\sigma_c$, entonces $F(s)$ posee una singularidad en el eje real en el punto
        $s=\sigma_c$.
    \end{teorema}

    \begin{proof}
        Sea $a=1+c$. Dado que $F$ es analítica en $a$, se puede representar por medio de un
        desarrollo en serie de potencias centrado en $a$, absolutamente convergente,
        \begin{equation}\label{eq:11-15}
            F(s)=\sum_{k=0}^{\infty}\frac{F^{(k)}(a)}{k!}(s-a)^k,
        \end{equation}
        y el radio de convergencia de esta serie de potencias excede a 1 puesto que $F$ es
        analítica en $c$. (Ver figura 11.3.) Por el teorema \ref{teo:11-12}, es posible
        mediante derivación sucesiva de \eqref{eq:11-14} determinar la derivada $F^{(k)}(a)$.
        Esto nos proporciona
        \begin{equation*}
            F^{(k)}(a)=(-1)^k\sum_{n=1}^{\infty}f(n)(\log n)^kn^{-a},
        \end{equation*}
        luego \eqref{eq:11-15} se puede escribir en la forma
        \begin{equation}\label{eq:11-16}
            F(s)=\sum_{k=0}^{\infty}\sum_{n=1}^{\infty}\frac{(a-s)^k}{k!}f(n)(\log n)^kn^{-a}.
        \end{equation}
        Como el radio de convergencia excede de 1, esta fórmula es válida para un real
        $s=c-\varepsilon$ en donde $\varepsilon>0$ (ver figura 11.3). Entonces
        $a-s=1+\varepsilon$ para este $s$ y la serie doble \eqref{eq:11-16} tiene sus términos
        no negativos para $n\geq n_0$. Por consiguiente podemos cambiar el orden de los
        sumandos para obtener
        \begin{equation*}
            F(c-\varepsilon)=\sum_{n=1}^{\infty}\frac{f(n)}{n^a}\sum_{k=0}^{\infty}\frac{\{(1+\varepsilon)\log n\}^k}{k!}=\sum_{n=1}^{\infty}\frac{f(n)}{n^a}e^{(1+\varepsilon)\log n}=\sum_{n=1}^{\infty}\frac{f(n)}{n^{c-\varepsilon}}.
        \end{equation*}
        Con otras palabras, la serie de Dirichlet $\sum f(n)n^{-s}$ converge para
        $s=c-\varepsilon$, luego también converge en el semiplano $\sigma>c-\varepsilon$.
    \end{proof}

    \begin{figure}[H]
        \centering
        \includegraphics{figuras/figura11-3.pdf}
        \caption{}
    \end{figure}

    \section{SERIES DE DIRICHLET EXPRESADAS COMO EXPONENCIALES DE SERIES DE DIRICHLET}

    Una serie de Dirichlet $F(s)=\sum f(n)n^{-s}$ que no se anula idénticamente admite un
    semiplano en el que no se anula. El teorema que sigue demuestra que en este semiplano
    $F(s)$ es la exponencial de otra serie de Dirichlet\index{dirichlet, peter gustav lejeune@Dirichlet, Peter Gustav Lejeune}\index{dirichlet, series@Dirichlet, series} si $f(1)\neq0$.

    \begin{teorema}\label{teo:11-14}
        Sea $F(s)=\sum f(n)n^{-s}$ absolutamente convergente para $\sigma>\sigma_a$ y
        supongamos que $f(1)\neq0$. Si $F(s)\neq0$ para $\sigma>\sigma_0\geq\sigma_a$,
        entonces para $\sigma>\sigma_0$ tenemos
        \begin{equation*}
            F(s)=e^{G(s)}
        \end{equation*}
        con
        \begin{equation*}
            G(s)=\log f(1)+\sum_{n=2}^{\infty}\frac{(f'*f^{-1})(n)}{\log n}n^{-s},
        \end{equation*}
        en donde $f^{-1}$ es la inversa de Dirichlet de $f$ y $f'(n)=f(n)\log n$.
    \end{teorema}

    Nota. Para $z$ complejo $\neq0$, $\log z$ designa la rama del logaritmo que es real
    cuando $z>0$.

    \begin{proof}
        Como $F(s)\neq0$ podemos escribir $F(s)=e^{G(s)}$, donde $G(s)$ es una función
        analítica para $\sigma>\sigma_0$. Diferenciando obtenemos
        \begin{equation*}
            F'(s)=e^{G(s)}G'(s)=F(s)G'(s),
        \end{equation*}
        luego $G'(s)=F'(s)/F(s)$. Pero
        \begin{equation*}
            F'(s)=-\sum_{n=1}^{\infty}\frac{f(n)\log n}{n^s}=-\sum_{n=1}^{\infty}\frac{f'(n)}{n^s}\qquad\text{y}\qquad\frac{1}{F(s)}=\sum_{n=1}^{\infty}\frac{f^{-1}(n)}{n^s},
        \end{equation*}
        por lo tanto
        \begin{equation*}
            G'(s)=F'(s)\cdot\frac{1}{F(s)}=-\sum_{n=2}^{\infty}\frac{(f'*f^{-1})(n)}{n^s}.
        \end{equation*}
        Integrando obtenemos
        \begin{equation*}
            G(s)=C+\sum_{n=2}^{\infty}\frac{(f'*f^{-1})(n)}{\log n}n^{-s}
        \end{equation*}
        en donde $C$ es una constante. Si hacemos que $\sigma\to+\infty$ vemos que
        $\lim_{\sigma\to\infty}G(\sigma+it)=C$, luego
        \begin{equation*}
            f(1)=\lim_{\sigma\to\infty}F(\sigma+it)=e^C
        \end{equation*}
        o sea $C=\log f(1)$. Este resultado termina la demostración. Esta demostración prueba
        también que la serie relativa a $G(s)$ converge absolutamente si $\sigma>\sigma_0$.
    \end{proof}

    \begin{ejemplo}
        Cuando $f(n)=1$ tenemos $f'(n)=\log n$ y $f^{-1}(n)=\mu(n)$ o sea
        \begin{equation*}
            (f'*f^{-1})(n)=\sum_{d\mid n}\log d\,\mu\left(\frac{n}{d}\right)=\Lambda(n).
        \end{equation*}
        Por consiguiente, si $\sigma>1$, tenemos
        \begin{equation}\label{eq:11-17}
            \zeta(s)=e^{G(s)}
        \end{equation}
        en donde
        \begin{equation*}
            G(s)=\sum_{n=2}^{\infty}\frac{\Lambda(n)}{\log n}n^{-s}.
        \end{equation*}
    \end{ejemplo}

    \begin{ejemplo}
        Un razonamiento análogo prueba que si $f$ es completamente multiplicativa y
        $F(s)=\sum f(n)n^{-s}$ entonces, en el semiplano de convergencia\index{semiplano de convergencia@Semiplano de convergencia} absoluta
        $\sigma>\sigma_a$ tenemos
        \begin{equation*}
            F(s)=e^{G(s)}
        \end{equation*}
        en donde
        \begin{equation*}
            G(s)=\sum_{n=2}^{\infty}\frac{f(n)\Lambda(n)}{\log n}n^{-s}
        \end{equation*}
        puesto que $(f'*f)(n)=\sum_{d\mid n}f(d)\log d\,\mu(n/d)f(n/d)=f(n)\Lambda(n)$.
    \end{ejemplo}

    Las fórmulas de los ejemplos anteriores se pueden deducir también mediante los productos
    de Euler\index{euler, leonhard@Euler, Leonhard}. Por ejemplo, en lo que se refiere a la función zeta de Riemann\index{funcion zeta de riemann@Función zeta de Riemann} tenemos
    \begin{equation*}
        \zeta(s)=\prod_p\frac{1}{1-p^{-s}}.
    \end{equation*}
    Mantenemos $s$ real, $s>1$, por lo que $\zeta(s)$ es positiva. Si ahora tomamos
    logaritmos y utilizamos la serie de potencias $-\log(1-x)=\sum x^m/m$ obtenemos
    \begin{equation*}
        \log\zeta(s)=-\sum_p\log(1-p^{-s})=\sum_p\sum_{m=1}^{\infty}\frac{p^{-ms}}{m}=\sum_{n=1}^{\infty}\Lambda_1(n)n^{-s}
    \end{equation*}
    en donde
    \begin{equation*}
        \Lambda_1(n)=
        \begin{cases}
            \dfrac{1}{m}&\text{si }n=p^m\text{ para un primo }p,\\[1.5ex]
            0&\text{en otro caso.}
        \end{cases}
    \end{equation*}
    Pero si $n=p^m$ entonces $\log n=m\log p=m\Lambda(n)$ por lo que
    $1/m=\Lambda(n)/\log n$. Por consiguiente
    \begin{equation*}
        \log\zeta(s)=\sum_{n=2}^{\infty}\frac{\Lambda(n)}{\log n}n^{-s}
    \end{equation*}
    que implica \eqref{eq:11-17} para $s$ real $>1$. Pero cada miembro de \eqref{eq:11-17} es
    analítico en el semiplano $\sigma>1$ luego, por prolongación analítica\index{prolongacion analitica@Prolongación analítica},
    \eqref{eq:11-17} también se verifica para $\sigma>1$.

    \section{FÓRMULAS DE VALOR MEDIO PARA SERIES DE DIRICHLET}

    \begin{teorema}\label{teo:11-15}
        Se dan dos series de Dirichlet $F(s)=\sum f(n)n^{-s}$ y $G(s)=\sum g(n)n^{-s}$ con
        abscisas de convergencia absoluta $\sigma_1$ y $\sigma_2$, respectivamente. Entonces
        para $a>\sigma_1$ y $b>\sigma_2$ tenemos
        \begin{equation*}
            \lim_{T\to\infty}\frac{1}{2T}\int_{-T}^{T}F(a+it)G(b-it)\,dt=\sum_{n=1}^{\infty}\frac{f(n)g(n)}{n^{a+b}}.
        \end{equation*}
    \end{teorema}

    \begin{proof}
        Tenemos
        \begin{align*}
            F(a+it)G(b-it)&=\left(\sum_{m=1}^{\infty}\frac{f(m)}{m^{a+it}}\right)\left(\sum_{n=1}^{\infty}\frac{g(n)}{n^{b-it}}\right)
            =\sum_{m=1}^{\infty}\sum_{n=1}^{\infty}\frac{f(m)g(n)}{m^an^b}\left(\frac{n}{m}\right)^{it}\\
            &=\sum_{n=1}^{\infty}\frac{f(n)g(n)}{n^{a+b}}+\sum_{\substack{m,n=1\\m\neq n}}^{\infty}\frac{f(m)g(n)}{m^an^b}\left(\frac{n}{m}\right)^{it}.
        \end{align*}
        Ahora bien
        \begin{equation*}
            \sum_{m=1}^{\infty}\sum_{n=1}^{\infty}\abs{\frac{f(m)g(n)}{m^an^b}\left(\frac{n}{m}\right)^{it}}\leq\sum_{m=1}^{\infty}\frac{\abs{f(m)}}{m^a}\sum_{n=1}^{\infty}\frac{\abs{g(n)}}{n^b}
        \end{equation*}
        luego la serie es absolutamente convergente, y esta convergencia es también uniforme
        para todo $t$. Por lo tanto podemos integrar término a término y dividir por $2T$
        para obtener
        \begin{align*}
            \frac{1}{2T}&\int_{-T}^{T}F(a+it)G(b-it)\,dt\\
            &=\sum_{n=1}^{\infty}\frac{f(n)g(n)}{n^{a+b}}+\sum_{\substack{m,n=1\\m\neq n}}^{\infty}\frac{f(m)g(n)}{m^an^b}\,\frac{1}{2T}\int_{-T}^{T}e^{it\log(n/m)}\,dt.
        \end{align*}
        Pero, para $m\neq n$, tenemos
        \begin{equation*}
            \int_{-T}^{T}e^{it\log(n/m)}\,dt=\left.\frac{e^{it\log(n/m)}}{i\log(n/m)}\right|_{-T}^{T}=\frac{2\operatorname{sen}\left[T\log\left(\dfrac{n}{m}\right)\right]}{\log\left(\dfrac{n}{m}\right)}
        \end{equation*}
        por lo que obtenemos
        \begin{align*}
            \frac{1}{2T}&\int_{-T}^{T}F(a+it)G(b-it)\,dt\\
            &=\sum_{n=1}^{\infty}\frac{f(n)g(n)}{n^{a+b}}+\sum_{\substack{m,n=1\\m\neq n}}^{\infty}\frac{f(m)g(n)}{m^an^b}\,\frac{\operatorname{sen}\left[T\log\left(\dfrac{n}{m}\right)\right]}{T\log\left(\dfrac{n}{m}\right)}.
        \end{align*}
        De nuevo, la serie doble converge uniformemente respecto a $T$ ya que
        $(\operatorname{sen}x)/x$ está acotado para cada $x$. Luego, si en cada término
        tomamos límites obtenemos la afirmación del teorema.
    \end{proof}

    \begin{teorema}\label{teo:11-16}
        Si $F(s)=\sum_{n=1}^{\infty}f(n)n^{-s}$ converge absolutamente para $\sigma>\sigma_a$,
        entonces para $\sigma>\sigma_a$ tenemos
        \begin{equation}\label{eq:11-18}
            \lim_{T\to\infty}\frac{1}{2T}\int_{-T}^{T}\abs{F(\sigma+it)}^2\,dt=\sum_{n=1}^{\infty}\frac{\abs{f(n)}^2}{n^{2\sigma}}.
        \end{equation}
        En particular, si $\sigma>1$ tenemos
        \begin{enumerate}
            \item[(a)] $\displaystyle\lim_{T\to\infty}\frac{1}{2T}\int_{-T}^{T}\abs{\zeta(\sigma+it)}^2\,dt=\sum_{n=1}^{\infty}\frac{1}{n^{2\sigma}}=\zeta(2\sigma)$.
            \item[(b)] $\displaystyle\lim_{T\to\infty}\frac{1}{2T}\int_{-T}^{T}\abs{\zeta^{(k)}(\sigma+it)}^2\,dt=\sum_{n=1}^{\infty}\frac{\log^{2k}n}{n^{2\sigma}}=\zeta^{(2k)}(2\sigma)$.
            \item[(c)] $\displaystyle\lim_{T\to\infty}\frac{1}{2T}\int_{-T}^{T}\abs{\zeta(\sigma+it)}^{-2}\,dt=\sum_{n=1}^{\infty}\frac{\mu^2(n)}{n^{2\sigma}}=\frac{\zeta(2\sigma)}{\zeta(4\sigma)}$.
            \item[(d)] $\displaystyle\lim_{T\to\infty}\frac{1}{2T}\int_{-T}^{T}\abs{\zeta(\sigma+it)}^4\,dt=\sum_{n=1}^{\infty}\frac{\sigma_0^2(n)}{n^{2\sigma}}=\frac{\zeta^4(2\sigma)}{\zeta(4\sigma)}$.
        \end{enumerate}
    \end{teorema}

    \begin{proof}
        Si en el teorema \ref{teo:11-15} hacemos $g(n)=\overline{f(n)}$ obtenemos la fórmula
        \eqref{eq:11-18}. Para deducir las fórmulas especiales (a), (b), (c) y (d) debemos
        calcular tan sólo el valor de las series de Dirichlet $\sum\abs{f(n)}^2n^{-2\sigma}$
        para las siguientes elecciones de $f(n)$: (a) $f(n)=1$; (b) $f(n)=(-1)^k\log^kn$; (c)
        $f(n)=\mu(n)$; (d) $f(n)=\sigma_0(n)$. La fórmula (a) es clara, y la (b) se sigue de
        la relación
        \begin{equation*}
            \zeta^{(k)}(s)=(-1)^k\sum_{n=1}^{\infty}\frac{\log^kn}{n^s}.
        \end{equation*}
        Para probar (c) y (d) utilizamos productos de Euler\index{productos de euler@Productos de Euler}. Para (c) tenemos
        \begin{equation*}
            \sum_{n=1}^{\infty}\frac{\mu^2(n)}{n^s}=\prod_p(1+p^{-s})=\prod_p\frac{1-p^{-2s}}{1-p^{-s}}=\frac{\zeta(s)}{\zeta(2s)}.
        \end{equation*}
        Si substituimos $s$ por $2\sigma$ obtenemos (c). Para llegar a (d) escribimos
        \begin{align*}
            \sum_{n=1}^{\infty}\frac{\sigma_0^2(n)}{n^s}&=\prod_p\left\{1+\sigma_0^2(p)p^{-s}+\sigma_0^2(p^2)p^{-2s}+\cdots\right\}\\
            &=\prod_p\left\{1+2^2p^{-s}+3^2p^{-2s}+\cdots\right\}\\
            &=\prod_p\left\{\sum_{n=0}^{\infty}(n+1)^2p^{-ns}\right\}=\prod_p\frac{1-p^{-2s}}{(1-p^{-s})^4}=\frac{\zeta^4(s)}{\zeta(2s)}
        \end{align*}
        ya que $\sum_{n=0}^{\infty}(n+1)^2x^n=(1+x)/(1-x)^3=(1-x^2)/(1-x)^4$. Ahora substituimos
        $s$ por $2\sigma$ y obtenemos (d).
    \end{proof}

    \section{UNA FÓRMULA INTEGRAL PARA LOS COEFICIENTES DE UNA SERIE DE DIRICHLET}

    \begin{teorema}\label{teo:11-17}
        Suponemos que la serie $F(s)=\sum_{n=1}^{\infty}f(n)n^{-s}$ es absolutamente
        convergente para $\sigma>\sigma_a$. Entonces, para $\sigma>\sigma_a$ y $x>0$,
        tenemos
        \begin{equation*}
            \lim_{T\to\infty}\frac{1}{2T}\int_{-T}^{T}F(\sigma+it)x^{\sigma+it}\,dt=
            \begin{cases}
                f(n)&\text{si }x=n,\\
                0&\text{en otro caso.}
            \end{cases}
        \end{equation*}
    \end{teorema}

    \begin{proof}
        Para $\sigma>\sigma_a$ tenemos
        \begin{equation}\label{eq:11-19}
            \frac{1}{2T}\int_{-T}^{T}F(\sigma+it)x^{\sigma+it}\,dt=\frac{x^{\sigma}}{2T}\int_{-T}^{T}\sum_{n=1}^{\infty}\frac{f(n)}{n^{\sigma}}\left(\frac{x}{n}\right)^{it}dt
            =\frac{x^{\sigma}}{2T}\sum_{n=1}^{\infty}\frac{f(n)}{n^{\sigma}}\int_{-T}^{T}e^{it\log(x/n)}\,dt,
        \end{equation}
        ya que la serie es uniformemente convergente para todo $t$ del intervalo $[-T,T]$. Si
        $x$ no es entero, entonces $x/n\neq1$ para todo $n$ y tenemos
        \begin{equation*}
            \int_{-T}^{T}e^{it\log(x/n)}\,dt=\frac{2\operatorname{sen}\left[T\log\left(\dfrac{x}{n}\right)\right]}{\log\left(\dfrac{x}{n}\right)}
        \end{equation*}
        y la serie se transforma en
        \begin{equation*}
            \frac{x^{\sigma}}{T}\sum_{n=1}^{\infty}\frac{f(n)}{n^{\sigma}}\,\frac{\operatorname{sen}\left[T\log\left(\dfrac{x}{n}\right)\right]}{\log\left(\dfrac{x}{n}\right)}
        \end{equation*}
        que tiende a 0 cuando $T\to\infty$. Sin embargo, si $x$ es un entero, por ejemplo
        $x=k$, entonces el término \eqref{eq:11-19}, para $n=k$, contribuye con
        \begin{equation*}
            \int_{-T}^{T}\left(\frac{x}{n}\right)^{it}dt=\int_{-T}^{T}\left(\frac{k}{k}\right)^{it}dt=\int_{-T}^{T}dt=2T,
        \end{equation*}
        y por consiguiente
        \begin{equation*}
            \frac{x^{\sigma}}{2T}\sum_{n=1}^{\infty}\frac{f(n)}{n^{\sigma}}\int_{-T}^{T}\left(\frac{x}{n}\right)^{it}dt=f(k)+\frac{k^{\sigma}}{2T}\sum_{\substack{n=1\\n\neq k}}^{\infty}\frac{f(n)}{n^{\sigma}}\int_{-T}^{T}\left(\frac{k}{n}\right)^{it}dt.
        \end{equation*}
        El segundo término tiende a 0 cuando $T\to\infty$ como veíamos en la primera parte de
        la demostración.
    \end{proof}

    \section{UNA FÓRMULA INTEGRAL PARA LAS SUMAS PARCIALES DE UNA SERIE DE DIRICHLET}

    En esta sección obtenemos una fórmula de Perron\index{formula de perron@Fórmula de Perron} que expresa las sumas parciales de una
    serie de Dirichlet\index{dirichlet, series@Dirichlet, series} como integral de la función suma. Precisamos de un lema relativo a las
    integrales de contorno.

    \begin{lema}\label{lem:11-4}
        Si $c>0$, definimos $\int_{c-\infty i}^{c+\infty i}$ como
        $\lim_{T\to\infty}\int_{c-iT}^{c+iT}$. Entonces, si $a$ es un número real positivo,
        tenemos
        \begin{equation*}
            \frac{1}{2\pi i}\int_{c-\infty i}^{c+\infty i}a^z\,\frac{dz}{z}=
            \begin{cases}
                1&\text{si }a>1,\\
                \dfrac{1}{2}&\text{si }a=1,\\[1.5ex]
                0&\text{si }0<a<1.
            \end{cases}
        \end{equation*}
        Además, tenemos
        \begin{equation}\label{eq:11-20}
            \abs{\frac{1}{2\pi i}\int_{c-iT}^{c+iT}a^z\,\frac{dz}{z}}\leq\frac{a^c}{\pi T\log\left(\dfrac{1}{a}\right)}\qquad\text{si }0<a<1,
        \end{equation}
        \begin{equation}\label{eq:11-21}
            \abs{\frac{1}{2\pi i}\int_{c-iT}^{c+iT}a^z\,\frac{dz}{z}-1}\leq\frac{a^c}{\pi T\log a}\qquad\text{si }a>1,
        \end{equation}
        y
        \begin{equation}\label{eq:11-22}
            \abs{\frac{1}{2\pi i}\int_{c-iT}^{c+iT}\frac{dz}{z}-\frac{1}{2}}\leq\frac{c}{\pi T}\qquad\text{si }a=1.
        \end{equation}
    \end{lema}

    \begin{proof}
        En primer lugar suponemos que $0<a<1$ y consideramos el rectángulo de contorno $R$ dado
        en la figura 11.4. Como $a^z/z$ es analítica en el interior de $R$ tenemos
        $\int_Ra^z\,dz/z=0$. Luego
        \begin{equation*}
            \int_{c-iT}^{c+iT}=\int_{b+iT}^{c+iT}+\int_{b-iT}^{b+iT}+\int_{c-iT}^{b-iT},
        \end{equation*}
        por lo tanto
        \begin{align*}
            \abs{\int_{c-iT}^{c+iT}a^z\,\frac{dz}{z}}&\leq\int_c^b\frac{a^x}{T}\,dx+\frac{2Ta^b}{b}+\int_c^b\frac{a^x}{T}\,dx\\
            &\leq\frac{2}{T}\int_c^{\infty}a^x\,dx+\frac{2Ta^b}{b}=\frac{2}{T}\left(\frac{-a^c}{\log a}\right)+\frac{2Ta^b}{b}.
        \end{align*}
        Si $b\to\infty$, obtenemos que $a^b\to0$, luego
        \begin{equation*}
            \abs{\int_{c-iT}^{c+iT}a^z\,\frac{dz}{z}}\leq\frac{2a^c}{T\log\left(\dfrac{1}{a}\right)}.
        \end{equation*}
        Esto termina la demostración de \eqref{eq:11-20}.

        \begin{figure}[H]
            \centering
            \includegraphics{figuras/figura11-4.pdf}
            \caption{}
        \end{figure}

        Si $a>1$, utilizamos como contorno $R$ el dibujado en la figura 11.5, en vez del
        anterior. Aquí $b>c>0$ y $T>c$. Ahora $a^z/z$ tiene un polo de primer orden en $z=0$
        con residuo 1 puesto que
        \begin{equation*}
            a^z=e^{z\log a}=1+z\log a+O(\abs{z}^2)\qquad\text{cuando }z\to0.
        \end{equation*}

        \begin{figure}[H]
            \centering
            \includegraphics{figuras/figura11-5.pdf}
            \caption{}
        \end{figure}

        Por consiguiente
        \begin{equation*}
            2\pi i=\left(\int_{c-iT}^{c+iT}+\int_{c+iT}^{-b+iT}+\int_{-b+iT}^{-b-iT}+\int_{-b-iT}^{c-iT}\right)a^z\,\frac{dz}{z},
        \end{equation*}
        luego
        \begin{equation*}
            \frac{1}{2\pi i}\int_{c-iT}^{c+iT}a^z\,\frac{dz}{z}-1=\frac{1}{2\pi i}\left(\int_{-b+iT}^{c+iT}+\int_{-b-iT}^{-b+iT}+\int_{c-iT}^{-b-iT}\right)a^z\,\frac{dz}{z}.
        \end{equation*}
        Ahora calculamos las integrales de la derecha. Obtenemos
        \begin{align*}
            \abs{\int_{-b+iT}^{c+iT}a^z\,\frac{dz}{z}}&\leq\int_{-b}^c\frac{a^x\,dx}{T}\leq\frac{1}{T}\int_{-\infty}^ca^x\,dx=\frac{1}{T}\,\frac{a^c}{\log a},\\
            \abs{\int_{-b-iT}^{-b+iT}a^z\,\frac{dz}{z}}&\leq2T\,\frac{a^{-b}}{b},\\
            \abs{\int_{c-iT}^{-b-iT}a^z\,\frac{dz}{z}}&\leq\int_{-b}^c\frac{a^x\,dx}{T}\leq\frac{1}{T}\,\frac{a^c}{\log a}.
        \end{align*}
        Y cuando $b\to\infty$ la segunda integral tiende a 0 y se obtiene \eqref{eq:11-21}.

        Cuando $a=1$, la integral se puede tratar directamente. Tenemos
        \begin{equation*}
            \int_{c-iT}^{c+iT}\frac{dz}{z}=\int_{-T}^{T}\frac{i\,dy}{c+iy}=\int_{-T}^{T}\frac{y}{c^2+y^2}\,dy+ic\int_{-T}^{T}\frac{dy}{c^2+y^2}=2ic\int_0^T\frac{dy}{c^2+y^2},
        \end{equation*}
        ya que al ser la función que se integra una función impar la otra integral se anula.
        Por lo tanto
        \begin{equation*}
            \frac{1}{2\pi i}\int_{c-iT}^{c+iT}\frac{dz}{z}=\frac{c}{\pi}\int_0^T\frac{dy}{c^2+y^2}=\frac{1}{\pi}\operatorname{arctan}\frac{T}{c}=\frac{1}{2}-\frac{1}{\pi}\operatorname{arctan}\frac{c}{T}.
        \end{equation*}
        El hecho de que $\operatorname{arctan}c/T<c/T$ prueba \eqref{eq:11-22}, y la
        demostración del lema \ref{lem:11-4} queda establecida.
    \end{proof}

    \begin{teorema}[Fórmula de Perron]\label{teo:11-18}
        \index{formula de perron@Fórmula de Perron}Sea $F(s)=\sum_{n=1}^{\infty}f(n)/n^s$ absolutamente convergente para $\sigma>\sigma_a$;
        sean $c>0$, $x>0$ arbitrarios. Entonces, si $\sigma>\sigma_a-c$, tenemos:
        \begin{equation*}
            \frac{1}{2\pi i}\int_{c-\infty i}^{c+\infty i}F(s+z)\,\frac{x^z}{z}\,dz=\sum_{n\leq x}{}^{*}\,\frac{f(n)}{n^s},
        \end{equation*}
        en donde $\sum^{*}$ significa que si $x$ es entero, el último término de la suma se
        multiplicará por $1/2$.
    \end{teorema}

    \begin{proof}
        En la integral, $c$ es la parte real de $z$, luego la serie relativa a $F(s+z)$ es
        absoluta y uniformemente convergente sobre conjuntos compactos del semiplano
        $\sigma+c>\sigma_a$. Por consiguiente
        \begin{align*}
            \int_{c-iT}^{c+iT}F(s+z)\,\frac{x^z}{z}\,dz&=\int_{c-iT}^{c+iT}\sum_{n=1}^{\infty}\frac{f(n)}{n^{s+z}}\,\frac{x^z}{z}\,dz\\
            &=\sum_{n=1}^{\infty}\frac{f(n)}{n^s}\int_{c-iT}^{c+iT}\left(\frac{x}{n}\right)^z\frac{dz}{z}\\
            &=\sum_{n<x}\frac{f(n)}{n^s}\int_{c-iT}^{c+iT}\left(\frac{x}{n}\right)^z\frac{dz}{z}+\sum_{n>x}\frac{f(n)}{n^s}\int_{c-iT}^{c+iT}\left(\frac{x}{n}\right)^z\frac{dz}{z}\\
            &\quad+{}'\frac{f(x)}{x^s}\int_{c-iT}^{c+iT}\frac{dz}{z},
        \end{align*}
        en donde el símbolo $+'$ indica que el último término interviene sólo cuando $x$ es un
        entero. En la suma finita $\sum_{n<x}$ podemos pasar al límite, término a término,
        haciendo que $T\to\infty$, y la integral es $2\pi i$ por el lema \ref{lem:11-4}.
        (Aquí $a=x/n$, $a>1$.) El último término (si aparece) produce $\pi if(x)x^{-s}$ y el
        teorema quedará definitivamente establecido en cuanto demostremos que
        \begin{equation}\label{eq:11-23}
            \lim_{T\to\infty}\sum_{n>x}\frac{f(n)}{n^s}\int_{c-iT}^{c+iT}\left(\frac{x}{n}\right)^z\frac{dz}{z}=0.
        \end{equation}
        Sabemos que $\int_{c-i\infty}^{c+i\infty}(x/n)^z(dz/z)=0$ si $n>x$, pero para probar
        \eqref{eq:11-23} es preciso estimar cómo tiende a cero $\int_{c-iT}^{c+iT}$.

        Del lema \ref{lem:11-4} obtenemos la acotación
        \begin{equation*}
            \abs{\int_{c-iT}^{c+iT}a^z\,\frac{dz}{z}}\leq\frac{2}{T}\,\frac{a^c}{\log\dfrac{1}{a}}\qquad\text{si }0<a<1.
        \end{equation*}
        Aquí $a=x/n$, con $n>x$. En efecto, $n\geq[x]+1$, o sea que
        $1/a=n/x\geq([x]+1)/x$. Luego
        \begin{align*}
            \abs{\sum_{n>x}\frac{f(n)}{n^s}\int_{c-iT}^{c+iT}\left(\frac{x}{n}\right)^z\frac{dz}{z}}&\leq\sum_{n>x}\frac{\abs{f(n)}}{n^{\sigma}}\,\frac{2}{T}\left(\frac{x}{n}\right)^c\frac{1}{\log\left(\dfrac{[x]+1}{x}\right)}\\
            &=\frac{2}{T}\,\frac{x^c}{\log\left(\dfrac{[x]+1}{x}\right)}\sum_{n>x}\frac{\abs{f(n)}}{n^{\sigma+c}}\to0\qquad\text{cuando }T\to\infty.
        \end{align*}
        Hemos demostrado, pues, la fórmula de Perron\index{formula de perron@Fórmula de Perron}.
    \end{proof}

    Nota. Si $c>\sigma_a$ la fórmula de Perron\index{formula de perron@Fórmula de Perron} es válida para $s=0$ y obtenemos la siguiente
    representación integral de las sumas parciales de los coeficientes:
    \begin{equation*}
        \frac{1}{2\pi i}\int_{c-\infty i}^{c+\infty i}F(z)\,\frac{x^z}{z}\,dz=\sum_{n\leq x}{}^{*}f(n).
    \end{equation*}

    \section*{Ejercicios del capítulo 11}

    \begin{ejercicio}
        Obtener las siguientes identidades, válidas para $\sigma>1$:
        \begin{enumerate}
            \item[(a)] $\displaystyle\zeta(s)=s\int_1^{\infty}\frac{[x]}{x^{s+1}}\,dx$.
            \item[(b)] $\displaystyle\sum_p\frac{1}{p^s}=s\int_1^{\infty}\frac{\pi(x)}{x^{s+1}}\,dx$, en donde la suma se halla extendida a todos los primos.
            \item[(c)] $\displaystyle\frac{1}{\zeta(s)}=s\int_1^{\infty}\frac{M(x)}{x^{s+1}}\,dx$, en donde $M(x)=\sum_{n\leq x}\mu(n)$.
            \item[(d)] $\displaystyle-\frac{\zeta'(s)}{\zeta(s)}=s\int_1^{\infty}\frac{\psi(x)}{x^{s+1}}\,dx$, en donde $\psi(x)=\sum_{n\leq x}\Lambda(n)$.
            \item[(e)] $\displaystyle L(s,\chi)=s\int_1^{\infty}\frac{A(x)}{x^{s+1}}\,dx$, en donde $A(x)=\sum_{n\leq x}\chi(n)$.
        \end{enumerate}
        Probar que (e) vale también para $\sigma>0$ si $\chi$ es un carácter no principal.
        [\textit{Indicación:} Teorema 4.2.]
    \end{ejercicio}

    \begin{ejercicio}
        Suponemos que la serie $\sum_{n=1}^{\infty}f(n)$ converge y tiene suma $A$, y
        definimos $A(x)=\sum_{n\leq x}f(n)$.
        \begin{enumerate}
            \item[(a)] Probar que la serie de Dirichlet $F(s)=\sum_{n=1}^{\infty}f(n)n^{-s}$
            converge para cada $s$ con $\sigma>0$ y que
            \begin{equation*}
                \sum_{n=1}^{\infty}\frac{f(n)}{n^s}=A-s\int_1^{\infty}\frac{R(x)}{x^{s+1}}\,dx,
            \end{equation*}
            en donde $R(x)=A-A(x)$. [\textit{Indicación:} teorema 4.2.]
            \item[(b)] Deducir que $F(\sigma)\to A$ cuando $\sigma\to0+$.
            \item[(c)] Si $\sigma>0$ y $N>1$ es un entero, probar que
            \begin{equation*}
                F(s)=\sum_{n=1}^{N}\frac{f(n)}{n^s}-\frac{A(N)}{N^s}+s\int_N^{\infty}\frac{A(y)}{y^{s+1}}\,dy.
            \end{equation*}
            \item[(d)] Escribir $s=\sigma+it$, tomar $N=1+[\abs{t}]$ en la parte (c) y probar que
            \begin{equation*}
                \abs{F(\sigma+it)}=O(\abs{t}^{1-\sigma})\qquad\text{si }0<\sigma<1.
            \end{equation*}
        \end{enumerate}
    \end{ejercicio}

    \begin{ejercicio}
        \begin{enumerate}
            \item[(a)] Probar que la serie $\sum n^{-1-it}$ posee sumas parciales acotadas si
            $t\neq0$. Cuando $t=0$ las sumas parciales no están acotadas.
            \item[(b)] Probar que la serie $\sum n^{-1-it}$ diverge para todo real $t$. Con
            otras palabras, la serie de Dirichlet relativa a $\zeta(s)$ diverge en toda la
            recta $\sigma=1$.
        \end{enumerate}
    \end{ejercicio}

    \begin{ejercicio}
        Sea $F(s)=\sum_{n=1}^{\infty}f(n)n^{-s}$, en donde $f(n)$ es completamente
        multiplicativa y la serie converge absolutamente para $\sigma>\sigma_a$. Probar que, si
        $\sigma>\sigma_a$, tenemos
        \begin{equation*}
            \frac{F'(s)}{F(s)}=-\sum_{n=1}^{\infty}\frac{f(n)\Lambda(n)}{n^s}.
        \end{equation*}
    \end{ejercicio}

    En los ejercicios siguientes, $\lambda(n)$ es la función de Liouville\index{funcion lambda(n) de liouville@Función $\lambda(n)$ de Liouville}\index{liouville, joseph@Liouville, Joseph}, $d(n)$ es el número
    de divisores de $n$, $\nu(n)$ y $\kappa(n)$ están definidas como sigue: $\nu(1)=0$,
    $\kappa(1)=1$; si $n=p_1^{a_1}\cdots p_k^{a_k}$, entonces $\nu(n)=k$ y
    $\kappa(n)=a_1a_2\cdots a_k$. Probar que las identidades de los ejercicios 5 al 10 son
    válidas para $\sigma>1$.

    \begin{ejercicio}
        $\displaystyle\sum_{n=1}^{\infty}\frac{d(n^2)}{n^s}=\frac{\zeta^3(s)}{\zeta(2s)}$.
    \end{ejercicio}

    \begin{ejercicio}
        $\displaystyle\sum_{n=1}^{\infty}\frac{\nu(n)}{n^s}=\zeta(s)\sum_p\frac{1}{p^s}$.
    \end{ejercicio}

    \begin{ejercicio}
        $\displaystyle\sum_{n=1}^{\infty}\frac{2^{\nu(n)}}{n^s}=\frac{\zeta^2(s)}{\zeta(2s)}$.
    \end{ejercicio}

    \begin{ejercicio}
        $\displaystyle\sum_{n=1}^{\infty}\frac{2^{\nu(n)}\lambda(n)}{n^s}=\frac{\zeta(2s)}{\zeta^2(s)}$.
    \end{ejercicio}

    \begin{ejercicio}
        $\displaystyle\sum_{n=1}^{\infty}\frac{\kappa(n)}{n^s}=\frac{\zeta(s)\zeta(2s)\zeta(3s)}{\zeta(6s)}$.
    \end{ejercicio}

    \begin{ejercicio}
        $\displaystyle\sum_{n=1}^{\infty}\frac{3^{\nu(n)}\kappa(n)}{n^s}=\frac{\zeta^3(s)}{\zeta(3s)}$.
    \end{ejercicio}

    \begin{ejercicio}
        Expresar la suma de la serie $\sum_{n=1}^{\infty}3^{\nu(n)}\kappa(n)\lambda(n)n^{-s}$ en
        términos de la función zeta de Riemann.
    \end{ejercicio}

    \begin{ejercicio}
        Sea $f$ una función completamente multiplicativa tal que $f(p)=f(p)^2$ para cada
        primo $p$. Si la serie $\sum f(n)n^{-s}$ converge absolutamente para $\sigma>\sigma_a$
        y tiene suma $F(s)$, probar que $F(s)\neq0$ y que
        \begin{equation*}
            \sum_{n=1}^{\infty}\frac{f(n)\lambda(n)}{n^s}=\frac{F(2s)}{F(s)}\qquad\text{si }\sigma>\sigma_a.
        \end{equation*}
    \end{ejercicio}

    \begin{ejercicio}
        Sea $f$ una función multiplicativa tal que $f(p)=f(p)^2$ para cada primo $p$. Si la
        serie $\sum\mu(n)f(n)n^{-s}$ converge absolutamente para $\sigma>\sigma_a$ y tiene
        suma $F(s)$, probar que $F(s)\neq0$ y que
        \begin{equation*}
            \sum_{n=1}^{\infty}\frac{f(n)\abs{\mu(n)}}{n^s}=\frac{F(2s)}{F(s)}\qquad\text{si }\sigma>\sigma_a.
        \end{equation*}
    \end{ejercicio}

    \begin{ejercicio}
        Sea $f$ una función multiplicativa\index{funcion multiplicativa@Función multiplicativa} tal que $\sum f(n)n^{-s}$ converja absolutamente
        para $\sigma>\sigma_a$. Si $p$ es primo y $\sigma>\sigma_a$ probar que
        \begin{equation*}
            (1+f(p)p^{-s})\sum_{n=1}^{\infty}\frac{f(n)\mu(n)}{n^s}=(1-f(p)p^{-s})\sum_{n=1}^{\infty}\frac{f(n)\mu(n)\mu(p,n)}{n^s},
        \end{equation*}
        en donde $\mu(p,n)$ es la función de Möbius evaluada en el mcd de $p$ y $n$.
        [\textit{Indicación:} Productos de Euler\index{productos de euler@Productos de Euler}.]
    \end{ejercicio}

    \begin{ejercicio}
        Probar que
        \begin{equation*}
            \sum_{\substack{m=1\\(m,n)=1}}^{\infty}\sum_{n=1}^{\infty}\frac{1}{m^2n^2}=\frac{\zeta^2(2)}{\zeta(4)}.
        \end{equation*}
        En general, si cada $s_i$ tiene parte real $\sigma_i>1$, expresar la suma múltiple
        \begin{equation*}
            \sum_{\substack{m_1=1\\(m_1,\dots,m_r)=1}}^{\infty}\cdots\sum_{m_r=1}^{\infty}m_1^{-s_1}\cdots m_r^{-s_r}
        \end{equation*}
        en términos de la función zeta de Riemann\index{funcion zeta de riemann@Función zeta de Riemann}.
    \end{ejercicio}

    \begin{ejercicio}
        Las integrales de la forma
        \begin{equation}\label{eq:11-24}
            f(s)=\int_1^{\infty}\frac{A(x)}{x^s}\,dx,
        \end{equation}
        en donde $A(x)$ es integrable Riemann\index{riemann, georg friedrich bernhard@Riemann, Georg Friedrich Bernhard} en cada intervalo compacto $[1,a]$, tienen algunas
        propiedades semejantes a las de las series de Dirichlet. Por ejemplo, poseen un
        semiplano de convergencia\index{semiplano de convergencia@Semiplano de convergencia} absoluta $\sigma>\sigma_a$ y un semiplano de convergencia
        $\sigma>\sigma_c$ en el que $f(s)$ es analítica. Este ejercicio describe una
        proposición análoga a la del teorema \ref{teo:11-13} (Teorema de Landau\index{landau, edmund@Landau, Edmund}\index{teorema@Teorema!de landau@de Landau}).

        Sea $f(s)$ la función representada en el semiplano $\sigma>\sigma_c$ por
        \eqref{eq:11-24}, en donde $\sigma_c$ es finito, y supongamos que $A(x)$ es una función
        que toma valores reales y que no cambia de signo para $x\geq x_0$. Probar que $f(s)$
        tiene una singularidad sobre el eje real en el punto $s=\sigma_c$.
    \end{ejercicio}

    \begin{ejercicio}
        Sea $\lambda_a(n)=\sum_{d\mid n}d^a\lambda(d)$, en donde $\lambda(n)$ es la función de
        Liouville\index{liouville, joseph@Liouville, Joseph}. Probar que, si $\sigma>\max\{1,\operatorname{Re}(a)+1\}$, tenemos
        \begin{equation*}
            \sum_{n=1}^{\infty}\frac{\lambda_a(n)}{n^s}=\frac{\zeta(s)\zeta(2s-2a)}{\zeta(s-a)}
        \end{equation*}
        y
        \begin{equation*}
            \sum_{n=1}^{\infty}\frac{\lambda(n)\lambda_a(n)}{n^s}=\frac{\zeta(2s)\zeta(s-a)}{\zeta(s)}.
        \end{equation*}
    \end{ejercicio}

\chapter{Las funciones \texorpdfstring{$\zeta(s)$}{ζ(s)} y \texorpdfstring{$L(s,\chi)$}{L(s,χ)}}

    \section{INTRODUCCIÓN}

    Este capítulo desarrolla otras propiedades de la función zeta de Riemann $\zeta(s)$ y de\label{sim:zeta}\label{sim:zsa}
    las $L$-funciones de Dirichlet $L(s,\chi)$ definidas para $\sigma>1$ por las series
    \begin{equation*}
        \zeta(s)=\sum_{n=1}^{\infty}\frac{1}{n^s}\qquad\text{y}\qquad L(s,\chi)=\sum_{n=1}^{\infty}\frac{\chi(n)}{n^s}.
    \end{equation*}
    Como en el capítulo anterior escribimos $s=\sigma+it$. Es posible unificar el tratamiento
    de ambas funciones $\zeta(s)$ y $L(s,\chi)$ introduciendo la función zeta de Hurwitz\index{funcion zeta de hurwitz@Función zeta de Hurwitz}\index{hurwitz, adolf@Hurwitz, Adolf}
    $\zeta(s,a)$, definida para $\sigma>1$ por la serie
    \begin{equation*}
        \zeta(s,a)=\sum_{n=0}^{\infty}\frac{1}{(n+a)^s}.
    \end{equation*}
    Aquí $a$ es un número real fijo, $0<a\leq1$. Cuando $a=1$ obtenemos la función zeta de
    Riemann, $\zeta(s)=\zeta(s,1)$. También es posible expresar $L(s,\chi)$ por medio de la
    función zeta de Hurwitz\index{funcion zeta de hurwitz@Función zeta de Hurwitz}. Si $\chi$ es un carácter mód $k$ reordenamos los términos de la
    serie correspondiente a $L(s,\chi)$ de acuerdo con las clases de restos mód $k$. Esto es,
    escribimos
    \begin{equation*}
        n=qk+r,\qquad\text{en donde }1\leq r\leq k\text{ y }q=0,1,2,\dots,
    \end{equation*}
    y obtenemos
    \begin{equation*}
        L(s,\chi)=\sum_{n=1}^{\infty}\frac{\chi(n)}{n^s}=\sum_{r=1}^{k}\sum_{q=0}^{\infty}\frac{\chi(qk+r)}{(qk+r)^s}
        =\frac{1}{k^s}\sum_{r=1}^{k}\chi(r)\sum_{q=0}^{\infty}\frac{1}{\left(q+\dfrac{r}{k}\right)^s}
        =k^{-s}\sum_{r=1}^{k}\chi(r)\zeta\left(s,\frac{r}{k}\right).
    \end{equation*}
    Esta representación de $L(s,\chi)$ como combinación lineal de funciones zeta de Hurwitz\index{hurwitz, adolf@Hurwitz, Adolf}
    demuestra que en última instancia las propiedades de las $L$-funciones dependen de las
    propiedades de $\zeta(s,a)$.

    Nuestro propósito consiste en obtener la prolongación analítica de $\zeta(s,a)$ al otro
    lado de la recta $\sigma=1$, lo cual se hace a través de una representación integral de
    $\zeta(s,a)$ que se obtiene de la fórmula integral correspondiente a la función gamma\index{funcion gamma@Función gamma}
    $\Gamma(s)$.

    \section{PROPIEDADES DE LA FUNCIÓN GAMMA}\label{sim:Gam}
\index{funcion gamma@Función gamma}
    A lo largo del capítulo necesitaremos ciertas propiedades básicas de la función
    $\Gamma(s)$. Las citamos a continuación para fácil referencia, si bien no las precisaremos
    todas. Las demostraciones se pueden encontrar en gran número de textos relativos a la
    teoría de las funciones de variable compleja.

    Para $\sigma>0$ tenemos la representación integral
    \begin{equation}\label{eq:12-1}
        \Gamma(s)=\int_0^{\infty}x^{s-1}e^{-x}\,dx.
    \end{equation}
    La función definida de esta forma para $\sigma>0$ se puede prolongar al otro lado de la
    recta $\sigma=0$, y $\Gamma(s)$ existe como función de $s$ y es analítica en todo el plano
    complejo salvo para polos simples en los puntos
    \begin{equation*}
        s=0,-1,-2,-3,\dots,
    \end{equation*}
    con residuo $(-1)^n/n!$ en $s=-n$. Tenemos además la representación
    \begin{equation*}
        \Gamma(s)=\lim_{n\to\infty}\frac{n^sn!}{s(s+1)\cdots(s+n)}\qquad\text{para }s\neq0,-1,-2,\dots,
    \end{equation*}
    y la fórmula producto
    \begin{equation*}
        \frac{1}{\Gamma(s)}=se^{Cs}\prod_{n=1}^{\infty}\left(1+\frac{s}{n}\right)e^{-s/n}\qquad\text{para todo }s,
    \end{equation*}
    en donde $C$ es la constante de Euler\index{constante de euler@Constante de Euler}. Como el producto converge para todo $s$,
    $\Gamma(s)$ nunca vale cero. La función gamma\index{funcion gamma@Función gamma} satisface dos ecuaciones funcionales\index{ecuacion funcional@Ecuación funcional}
    \begin{equation}\label{eq:12-2}
        \Gamma(s+1)=s\Gamma(s)
    \end{equation}
    y
    \begin{equation}\label{eq:12-3}
        \Gamma(s)\Gamma(1-s)=\frac{\pi}{\operatorname{sen}\pi s},
    \end{equation}
    válidas para todo $s$, y una fórmula de multiplicación
    \begin{equation}\label{eq:12-4}
        \Gamma(s)\Gamma\left(s+\frac{1}{m}\right)\cdots\Gamma\left(s+\frac{m-1}{m}\right)=(2\pi)^{(m-1)/2}m^{(1/2)-ms}\Gamma(ms),
    \end{equation}
    válida para todo $s$ y todo entero $m\geq1$.

    Utilizaremos la representación integral \eqref{eq:12-1}, las ecuaciones funcionales
    \eqref{eq:12-2} y \eqref{eq:12-3}, y el hecho de que $\Gamma(s)$ existe en todo el plano
    con polos simples en los enteros $s=0,-1,-2,\dots$ Observamos además que $\Gamma(n+1)=n!$
    si $n$ es un entero no negativo.

    \section{REPRESENTACIÓN INTEGRAL PARA LA FUNCIÓN ZETA DE HURWITZ}
\index{funcion zeta de hurwitz@Función zeta de Hurwitz}
    La función zeta de Hurwitz\index{funcion zeta de hurwitz@Función zeta de Hurwitz} $\zeta(s,a)$ se halla inicialmente definida para $\sigma>1$ por
    la serie
    \begin{equation*}
        \zeta(s,a)=\sum_{n=0}^{\infty}\frac{1}{(n+a)^s}.
    \end{equation*}

    \begin{teorema}\label{teo:12-1}
        La serie que define $\zeta(s,a)$ converge absolutamente para $\sigma>1$. La convergencia
        es uniforme en cada semiplano $\sigma\geq1+\delta$, $\delta>0$, luego $\zeta(s,a)$ es
        una función analítica de $s$ en el semiplano $\sigma>1$.
    \end{teorema}

    \begin{proof}
        Todas estas afirmaciones se siguen de las desigualdades
        \begin{equation*}
            \sum_{n=1}^{\infty}\abs{(n+a)^{-s}}=\sum_{n=1}^{\infty}(n+a)^{-\sigma}\leq\sum_{n=1}^{\infty}(n+a)^{-(1+\delta)}.\qedhere
        \end{equation*}
    \end{proof}

    \begin{teorema}\label{teo:12-2}
        Para $\sigma>1$ tenemos la representación integral
        \begin{equation}\label{eq:12-5}
            \Gamma(s)\zeta(s,a)=\int_0^{\infty}\frac{x^{s-1}e^{-ax}}{1-e^{-x}}\,dx.
        \end{equation}
        En particular, cuando $a=1$, tenemos
        \begin{equation*}
            \Gamma(s)\zeta(s)=\int_0^{\infty}\frac{x^{s-1}e^{-x}}{1-e^{-x}}\,dx.
        \end{equation*}
    \end{teorema}

    \begin{proof}
        En primer lugar hacemos $s$ real, $s>1$, y entonces extendemos el resultado a todo $s$
        complejo por prolongación analítica\index{prolongacion analitica@Prolongación analítica}.

        En la integral dada para $\Gamma(s)$ efectuamos el cambio de variable $x=(n+a)t$, en
        donde $n\geq0$, para obtener
        \begin{equation*}
            \Gamma(s)=\int_0^{\infty}e^{-x}x^{s-1}\,dx=(n+a)^s\int_0^{\infty}e^{-(n+a)t}t^{s-1}\,dt,
        \end{equation*}
        o
        \begin{equation*}
            (n+a)^{-s}\Gamma(s)=\int_0^{\infty}e^{-nt}e^{-at}t^{s-1}\,dt.
        \end{equation*}
        Sumando respecto a todos los $n\geq0$ obtenemos
        \begin{equation*}
            \zeta(s,a)\Gamma(s)=\sum_{n=0}^{\infty}\int_0^{\infty}e^{-nt}e^{-at}t^{s-1}\,dt,
        \end{equation*}
        siendo la serie de la derecha convergente para $\sigma>1$. Ahora deseamos intercambiar
        la suma y la integral. La manera más simple para justificarlo consiste en considerar la
        integral como de Lebesgue. Puesto que el integrando es no negativo, el teorema de
        convergencia de Levi (teorema 10.25 de la referencia \cite{apostol1976}) nos dice que la serie
        \begin{equation*}
            \sum_{n=0}^{\infty}e^{-nt}e^{-at}t^{s-1}
        \end{equation*}
        converge casi para todo $t$ hacia una función suma que es integrable de Lebesgue en
        $[0,+\infty)$ y que
        \begin{equation*}
            \zeta(s,a)\Gamma(s)=\sum_{n=0}^{\infty}\int_0^{\infty}e^{-nt}e^{-at}t^{s-1}\,dt=\int_0^{\infty}\sum_{n=0}^{\infty}e^{-nt}e^{-at}t^{s-1}\,dt.
        \end{equation*}
        Pero si $t>0$ tenemos $0<e^{-t}<1$ y entonces
        \begin{equation*}
            \sum_{n=0}^{\infty}e^{-nt}=\frac{1}{1-e^{-t}},
        \end{equation*}
        en donde la serie es geométrica. Por consiguiente tenemos
        \begin{equation*}
            \sum_{n=0}^{\infty}e^{-nt}e^{-at}t^{s-1}=\frac{e^{-at}t^{s-1}}{1-e^{-t}}
        \end{equation*}
        casi para todo $t$ en $(0,+\infty)$, de hecho para todo $t$ salvo en 0, luego
        \begin{equation*}
            \zeta(s,a)\Gamma(s)=\int_0^{\infty}\sum_{n=0}^{\infty}e^{-nt}e^{-at}t^{s-1}\,dt=\int_0^{\infty}\frac{e^{-at}t^{s-1}}{1-e^{-t}}\,dt.
        \end{equation*}
        Esto prueba \eqref{eq:12-5} para $s$ real $>1$. Para extender este resultado a todo
        número complejo $s$ con $\sigma>1$ observamos que ambos miembros son analíticos para
        $\sigma>1$. Para demostrar que el miembro de la derecha es analítico suponemos
        $1+\delta\leq\sigma\leq c$, en donde $c>1$ y $\delta>0$ y escribimos
        \begin{equation*}
            \int_0^{\infty}\abs{\frac{e^{-at}t^{s-1}}{1-e^{-t}}}\,dt\leq\int_0^{\infty}\frac{e^{-at}t^{\sigma-1}}{1-e^{-t}}\,dt=\left(\int_0^1+\int_1^{\infty}\right)\frac{e^{-at}t^{\sigma-1}}{1-e^{-t}}\,dt.
        \end{equation*}
        Si $0\leq t\leq1$ tenemos $t^{\sigma-1}\leq t^{\delta}$, y, si $t\geq1$, tenemos
        $t^{\sigma-1}<t^{c-1}$. Además, como $e^t-1\geq t$ para $t\geq0$ tenemos
        \begin{equation*}
            \int_0^1\frac{e^{-at}t^{\sigma-1}}{1-e^{-t}}\,dt\leq\int_0^1\frac{e^{(1-a)t}t^{\delta}}{e^t-1}\,dt\leq e^{(1-a)}\int_0^1t^{\delta-1}\,dt=\frac{e^{1-a}}{\delta},
        \end{equation*}
        y
        \begin{equation*}
            \int_1^{\infty}\frac{e^{-at}t^{\sigma-1}}{1-e^{-t}}\,dt\leq\int_1^{\infty}\frac{e^{-at}t^{c-1}}{1-e^{-t}}\,dt\leq\int_0^{\infty}\frac{e^{-at}t^{c-1}}{1-e^{-t}}\,dt=\Gamma(c)\zeta(c,a).
        \end{equation*}
        Esto prueba que la integral de \eqref{eq:12-5} converge uniformemente en cada intervalo
        $1+\delta\leq\sigma\leq c$, en donde $\delta>0$, y por consiguiente representa una
        función analítica en cada intervalo, por lo tanto también la representa en el semiplano
        $\sigma>1$. Por consiguiente, por prolongación analítica, \eqref{eq:12-5} se verifica
        para todo $s$ con $\sigma>1$.
    \end{proof}

    \section{UNA REPRESENTACIÓN DE LA FUNCIÓN ZETA DE HURWITZ MEDIANTE UNA INTEGRAL DE CONTORNO}
\index{funcion zeta de hurwitz@Función zeta de Hurwitz}
    Para extender $\zeta(s,a)$ al otro lado de la recta $\sigma=1$ deducimos otra
    representación, en términos de una integral de contorno. El contorno $C$ es un lazo en
    torno del eje real negativo, tal como se indica en la figura 12.1. El lazo está compuesto
    de tres partes $C_1$, $C_2$, $C_3$. $C_2$ es una circunferencia de radio $c<2\pi$,
    orientada positivamente, con centro en el origen, y $C_1$ y $C_3$ son los lados superior
    e inferior de un <<corte>> en el plano complejo a lo largo del eje real negativo, recorrido
    tal como indica la figura 12.1.

    \begin{figure}[H]
        \centering
        \includegraphics{figuras/figura12-1.pdf}
        \caption{}
    \end{figure}

    Esto significa que, sobre $C_1$, utilizamos la parametrización $z=re^{-\pi i}$ y, sobre
    $C_3$, $z=re^{\pi i}$, en donde $r$ varía de $c$ a $+\infty$.

    \begin{teorema}\label{teo:12-3}
        Si $0<a\leq1$, la función definida por la integral de contorno
        \begin{equation*}
            I(s,a)=\frac{1}{2\pi i}\int_C\frac{z^{s-1}e^{az}}{1-e^z}\,dz
        \end{equation*}
        es una función entera de $s$. Además, tenemos
        \begin{equation}\label{eq:12-6}
            \zeta(s,a)=\Gamma(1-s)I(s,a)\qquad\text{si }\sigma>1.
        \end{equation}
    \end{teorema}

    \begin{proof}
        Aquí $z^s$ significa $r^se^{-\pi is}$ sobre $C_1$ y $r^se^{\pi is}$ sobre $C_3$.
        Consideramos un disco compacto arbitrario $\abs{s}\leq M$ y vemos que las integrales a
        lo largo de $C_1$ y $C_3$ convergen uniformemente en tal disco. Al ser el integrando
        una función entera de $s$ tenemos que $I(s,a)$ es una función entera.

        A lo largo de $C_1$ tenemos, para $r\geq1$,
        \begin{equation*}
            \abs{z^{s-1}}=r^{\sigma-1}\abs{e^{-\pi i(\sigma-1+it)}}=r^{\sigma-1}e^{\pi t}\leq r^{M-1}e^{\pi M}
        \end{equation*}
        ya que $\abs{s}\leq M$. Análogamente, a lo largo de $C_3$ tenemos, para $r\geq1$,
        \begin{equation*}
            \abs{z^{s-1}}=r^{\sigma-1}\abs{e^{\pi i(\sigma-1+it)}}=r^{\sigma-1}e^{-\pi t}\leq r^{M-1}e^{\pi M}.
        \end{equation*}
        Por lo tanto sobre $C_1$ y sobre $C_3$ tenemos, para $r\geq1$,
        \begin{equation*}
            \abs{\frac{z^{s-1}e^{az}}{1-e^z}}\leq\frac{r^{M-1}e^{\pi M}e^{-ar}}{1-e^{-r}}=\frac{r^{M-1}e^{\pi M}e^{(1-a)r}}{e^r-1}.
        \end{equation*}
        Pero $e^r-1>e^r/2$ cuando $r>\log2$, luego el integrando está acotado por
        $Ar^{M-1}e^{-ar}$, en donde $A$ es una constante que depende de $M$ pero no depende de
        $r$. Puesto que $\int_c^{\infty}r^{M-1}e^{-ar}\,dr$ converge si $c>0$ hemos demostrado
        que las integrales a lo largo de $C_1$ y de $C_3$ convergen uniformemente sobre cada
        disco compacto $\abs{s}\leq M$, y por lo tanto que $I(s,a)$ es una función entera de
        $s$.

        Para probar \eqref{eq:12-6} escribimos
        \begin{equation*}
            2\pi iI(s,a)=\left(\int_{C_1}+\int_{C_2}+\int_{C_3}\right)z^{s-1}g(z)\,dz
        \end{equation*}
        en donde $g(z)=e^{az}/(1-e^z)$. Sobre $C_1$ y $C_3$ tenemos $g(z)=g(-r)$, y sobre
        $C_2$ escribimos $z=ce^{i\theta}$, en donde $-\pi\leq\theta\leq\pi$. Esto nos
        proporciona
        \begin{align*}
            2\pi iI(s,a)&=\int_{\infty}^{c}r^{s-1}e^{-\pi is}g(-r)\,dr+i\int_{-\pi}^{\pi}c^{s-1}e^{i(s-1)\theta}ce^{i\theta}g(ce^{i\theta})\,d\theta\\
            &\quad+\int_c^{\infty}r^{s-1}e^{\pi is}g(-r)\,dr\\
            &=2i\operatorname{sen}(\pi s)\int_c^{\infty}r^{s-1}g(-r)\,dr+ic^s\int_{-\pi}^{\pi}e^{is\theta}g(ce^{i\theta})\,d\theta.
        \end{align*}
        Si dividimos por $2i$, obtenemos
        \begin{equation*}
            \pi I(s,a)=\operatorname{sen}(\pi s)I_1(s,c)+I_2(s,c).
        \end{equation*}
        Ahora hacemos que $c\to0$. Obtenemos
        \begin{equation*}
            \lim_{c\to0}I_1(s,c)=\int_0^{\infty}\frac{r^{s-1}e^{-ar}}{1-e^{-r}}\,dr=\Gamma(s)\zeta(s,a),
        \end{equation*}
        si $\sigma>1$. A continuación vemos que $\lim_{c\to0}I_2(s,c)=0$. Para ello observamos
        que $g(z)$ es analítica en $\abs{z}<2\pi$ excepto en un polo de primer orden en $z=0$.
        Por consiguiente $zg(z)$ es analítica por todo el interior de $\abs{z}<2\pi$ y por lo
        tanto acotada a él, es decir $\abs{g(z)}\leq A/\abs{z}$, en donde $\abs{z}=c<2\pi$ y $A$
        es constante. Por consiguiente tenemos
        \begin{equation*}
            \abs{I_2(s,c)}\leq\frac{c^{\sigma}}{2}\int_{-\pi}^{\pi}e^{-t\theta}\,\frac{A}{c}\,d\theta\leq Ae^{\pi\abs{t}}c^{\sigma-1}.
        \end{equation*}
        Si $\sigma>1$ y $c\to0$ obtenemos que $I_2(s,c)\to0$, luego
        $\pi I(s,a)=\operatorname{sen}(\pi s)\Gamma(s)\zeta(s,a)$. Como
        $\Gamma(s)\Gamma(1-s)=\pi/\operatorname{sen}\pi s$ hemos demostrado \eqref{eq:12-6}.
    \end{proof}

    \section{LA PROLONGACIÓN ANALÍTICA DE LA FUNCIÓN ZETA DE HURWITZ}
\index{funcion zeta de hurwitz@Función zeta de Hurwitz}\index{prolongacion analitica@Prolongación analítica}
    En la ecuación $\zeta(s,a)=\Gamma(1-s)I(s,a)$ válida para $\sigma>1$, las funciones
    $I(s,a)$ y $\Gamma(1-s)$ son significativas para cada complejo $s$. Por consiguiente
    podemos utilizar esta ecuación para definir $\zeta(s,a)$ para $\sigma\leq1$.

    \begin{definicion}
        Si $\sigma\leq1$ definimos $\zeta(s,a)$ por medio de la ecuación
        \begin{equation}\label{eq:12-7}
            \zeta(s,a)=\Gamma(1-s)I(s,a).
        \end{equation}
    \end{definicion}

    Esta ecuación proporciona la prolongación analítica de $\zeta(s,a)$ en el plano $s$
    entero.

    \begin{teorema}\label{teo:12-4}
        La función $\zeta(s,a)$ definida de esta forma es analítica para todo $s$ excepto en un
        polo simple en $s=1$ con residuo 1.
    \end{teorema}

    \begin{proof}
        Puesto que $I(s,a)$ es entera las únicas singularidades posibles de $\zeta(s,a)$ son
        los polos de $\Gamma(1-s)$, esto es, los puntos $s=1,2,3,\dots$ Pero el teorema
        \ref{teo:12-1} prueba que $\zeta(s,a)$ es analítica en $s=2,3,\dots$, luego $s=1$ es
        el único polo posible de $\zeta(s,a)$.

        Ahora veremos que en $s=1$ posee un polo con residuo 1. Si $s$ es un entero, $s=n$, el
        integrando de la integral de contorno de $I(s,a)$ tomará el mismo valor sobre $C_1$
        que sobre $C_3$ y por lo tanto las integrales a lo largo de $C_1$ y de $C_3$ se
        simplificarán, quedando
        \begin{equation*}
            I(n,a)=\frac{1}{2\pi i}\int_{C_2}\frac{z^{n-1}e^{az}}{1-e^z}\,dz=\operatorname*{Res}_{z=0}\frac{z^{n-1}e^{az}}{1-e^z}.
        \end{equation*}
        En particular cuando $s=1$ tenemos
        \begin{equation*}
            I(1,a)=\operatorname*{Res}_{z=0}\frac{e^{az}}{1-e^z}=\lim_{z\to0}\frac{ze^{az}}{1-e^z}=\lim_{z\to0}\frac{z}{1-e^z}=\lim_{z\to0}\frac{-1}{e^z}=-1.
        \end{equation*}
        Para calcular el residuo de $\zeta(s,a)$ en $s=1$ calculamos el límite
        \begin{align*}
            \lim_{s\to1}(s-1)\zeta(s,a)&=-\lim_{s\to1}(1-s)\Gamma(1-s)I(s,a)=-I(1,a)\lim_{s\to1}\Gamma(2-s)\\
            &=\Gamma(1)=1.
        \end{align*}
        Esto demuestra que $\zeta(s,a)$ tiene un polo simple en $s=1$ con residuo 1.
    \end{proof}

    Nota. Como $\zeta(s,a)$ es analítica en $s=2,3,\dots$ y $\Gamma(1-s)$ tiene polos en
    dichos puntos, la ecuación \eqref{eq:12-7} implica que $I(s,a)$ debe anularse en estos
    puntos.

    \section[PROLONGACIÓN ANALÍTICA DE $\zeta(s)$ Y $L(s,\chi)$]{PROLONGACIÓN ANALÍTICA DE \texorpdfstring{$\zeta(s)$}{ζ(s)} Y \texorpdfstring{$L(s,\chi)$}{L(s,χ)}}
\index{prolongacion analitica@Prolongación analítica}
    En la introducción probábamos que, para $\sigma>1$, se tenía
    \begin{equation*}
        \zeta(s)=\zeta(s,1)
    \end{equation*}
    y
    \begin{equation}\label{eq:12-8}
        L(s,\chi)=k^{-s}\sum_{r=1}^{k}\chi(r)\zeta\left(s,\frac{r}{k}\right),
    \end{equation}
    en donde $\chi$ es un carácter de Dirichlet mód $k$. Utilizamos ahora estas fórmulas como
    \textit{definiciones} de las funciones $\zeta(s)$ y $L(s,\chi)$ para $\sigma\leq1$. De
    esta forma obtenemos la prolongación analítica de $\zeta(s)$ y de $L(s,\chi)$ al otro lado
    de la recta $\sigma=1$.

    \begin{teorema}\label{teo:12-5}
        \begin{enumerate}
            \item[(a)] La función zeta de Riemann\index{funcion zeta de riemann@Función zeta de Riemann} $\zeta(s)$ es analítica para todo $s$ salvo en
            un polo simple en $s=1$ con residuo 1.
            \item[(b)] Para el carácter principal\index{caracter principal@Carácter principal} $\chi_1$ mód $k$, la $L$-función $L(s,\chi_1)$
            es analítica para todo $s$ salvo para un polo simple en $s=1$ con residuo
            $\varphi(k)/k$.
            \item[(c)] Si $\chi\neq\chi_1$, $L(s,\chi)$ es una función entera de $s$.
        \end{enumerate}
    \end{teorema}

    \begin{proof}
        La parte (a) se sigue inmediatamente del teorema \ref{teo:12-4}. Para probar (b) y (c)
        utilizamos la relación
        \begin{equation*}
            \sum_{r\bmod k}\chi(r)=
            \begin{cases}
                0&\text{si }\chi\neq\chi_1,\\
                \varphi(k)&\text{si }\chi=\chi_1.
            \end{cases}
        \end{equation*}
        Como $\zeta(s,r/k)$ tiene un polo simple en $s=1$ con residuo 1, la función
        $\chi(r)\zeta(s,r/k)$ tiene un polo simple en $s=1$ con residuo $\chi(r)$. Por
        consiguiente
        \begin{equation*}
            \operatorname*{Res}_{s=1}L(s,\chi)=\lim_{s\to1}(s-1)L(s,\chi)=\lim_{s\to1}(s-1)k^{-s}\sum_{r=1}^{k}\chi(r)\zeta\left(s,\frac{r}{k}\right)
            =\frac{1}{k}\sum_{r=1}^{k}\chi(r)=
            \begin{cases}
                0&\text{si }\chi\neq\chi_1,\\
                \dfrac{\varphi(k)}{k}&\text{si }\chi=\chi_1.
            \end{cases}\qedhere
        \end{equation*}
    \end{proof}

    \section{LA FÓRMULA DE HURWITZ PARA \texorpdfstring{$\zeta(s,a)$}{ζ(s,a)}}
\index{formula de hurwitz para zeta(s,a)@Fórmula de Hurwitz para $\zeta(s,a)$}
    La función $\zeta(s,a)$ originalmente se definió para $\sigma>1$, mediante una serie
    infinita. Hurwitz\index{hurwitz, adolf@Hurwitz, Adolf} obtuvo otra representación en serie de $\zeta(s,a)$ válida en el
    semiplano $\sigma<0$. Antes de establecer esta fórmula discutiremos un lema que se
    utilizará en su demostración.

    \begin{lema}\label{lem:12-1}
        $S(r)$ designa la región que queda cuando quitamos del $z$-plano todos los discos
        circulares abiertos de radio $r$, $0<r<\pi$, con centros en los puntos $z=2n\pi i$,
        $n=0,\pm1,\pm2,\dots$ Entonces, si $0<a\leq1$, la función
        \begin{equation*}
            g(z)=\frac{e^{az}}{1-e^z}
        \end{equation*}
        está acotada en $S(r)$. (La cota depende de $r$.)
    \end{lema}

    \begin{proof}
        Escribimos $z=x+iy$ y consideramos el rectángulo agujereado
        \begin{equation*}
            Q(r)=\{z:\abs{x}\leq1,\ \abs{y}\leq\pi,\ \abs{z}\geq r\},
        \end{equation*}
        dibujado en la figura 12.2.

        \begin{figure}[H]
            \centering
            \includegraphics{figuras/figura12-2.pdf}
            \caption{}
        \end{figure}

        Este es un conjunto compacto, luego $g$ está acotada en $Q(r)$. Además, puesto que
        $\abs{g(z+2\pi i)}=\abs{g(z)}$, $g$ está acotada en la banda con infinitos agujeros
        \begin{equation*}
            \{z:\abs{x}\leq1,\ \abs{z-2n\pi i}\geq r,\ n=0,\pm1,\pm2,\dots\}.
        \end{equation*}
        Ahora demostraremos que $g$ está acotada en el exterior de esta banda. Suponemos
        $\abs{x}\geq1$ y consideramos
        \begin{equation*}
            \abs{g(z)}=\abs{\frac{e^{az}}{1-e^z}}=\frac{e^{ax}}{\abs{1-e^z}}\leq\frac{e^{ax}}{\abs{1-e^x}}.
        \end{equation*}
        Para $x\geq1$ tenemos $\abs{1-e^x}=e^x-1$ y $e^{ax}\leq e^x$, por lo tanto
        \begin{equation*}
            \abs{g(z)}\leq\frac{e^x}{e^x-1}=\frac{1}{1-e^{-x}}\leq\frac{1}{1-e^{-1}}=\frac{e}{e-1}.
        \end{equation*}
        Además, cuando $x\leq-1$ tenemos $\abs{1-e^x}=1-e^x$, por lo tanto
        \begin{equation*}
            \abs{g(z)}\leq\frac{e^{ax}}{1-e^x}\leq\frac{1}{1-e^x}\leq\frac{1}{1-e^{-1}}=\frac{e}{e-1}.
        \end{equation*}
        Por consiguiente $\abs{g(z)}\leq e/(e-1)$ para $\abs{x}\geq1$ y la demostración del
        lema queda terminada.
    \end{proof}

    Ahora volvemos a la fórmula de Hurwitz\index{formula de hurwitz para zeta(s,a)@Fórmula de Hurwitz para $\zeta(s,a)$}. Ésta contiene otra serie de Dirichlet $F(x,s)$
    dada por
    \begin{equation}\label{eq:12-9}
        F(x,s)=\sum_{n=1}^{\infty}\frac{e^{2\pi inx}}{n^s},
    \end{equation}
    en donde $x$ es real y $\sigma>1$. Obsérvese que $F(x,s)$ es una función periódica en $x$\label{sim:Fxs}
    de período 1 y que $F(1,s)=\zeta(s)$. La serie converge absolutamente si $\sigma>1$. Si
    $x$ no es entero la serie converge también (condicionalmente) para $\sigma>0$ ya que,
    para cada $x$ fijo no entero, los coeficientes poseen sumas parciales acotadas.

    Nota. Nos referiremos a $F(x,s)$ llamándola \textit{función zeta periódica\index{funcion zeta periodica@Función zeta periódica}}.

    \begin{teorema}[Fórmula de Hurwitz]\label{teo:12-6}
        \index{formula de hurwitz para zeta(s,a)@Fórmula de Hurwitz para $\zeta(s,a)$}\index{hurwitz, adolf@Hurwitz, Adolf}Si $0<a\leq1$ y $\sigma>1$ tenemos
        \begin{equation}\label{eq:12-10}
            \zeta(1-s,a)=\frac{\Gamma(s)}{(2\pi)^s}\left\{e^{-\pi is/2}F(a,s)+e^{\pi is/2}F(-a,s)\right\}.
        \end{equation}
        Si $a\neq1$ esta representación es válida también para $\sigma>0$.
    \end{teorema}

    \begin{proof}
        Consideremos la función
        \begin{equation*}
            I_N(s,a)=\frac{1}{2\pi i}\int_{C(N)}\frac{z^{s-1}e^{az}}{1-e^z}\,dz,
        \end{equation*}
        en donde $C(N)$ es el contorno descrito en la figura 12.3, y $N$ es un entero.

        \begin{figure}[H]
            \centering
            \includegraphics{figuras/figura12-3.pdf}
            \caption{}
        \end{figure}

        En primer lugar vemos que $\lim_{N\to\infty}I_N(s,a)=I(s,a)$ si $\sigma<0$. Para ello
        es suficiente probar que la integral a lo largo de la circunferencia exterior tiende a
        0 cuando $N\to\infty$.

        Sobre la circunferencia exterior tenemos $z=Re^{i\theta}$, $-\pi\leq\theta\leq\pi$,
        luego
        \begin{equation*}
            \abs{z^{s-1}}=\abs{R^{s-1}e^{i\theta(s-1)}}=R^{\sigma-1}e^{-t\theta}\leq R^{\sigma-1}e^{\pi\abs{t}}.
        \end{equation*}
        Pero la circunferencia exterior pertenece al conjunto $S(r)$ del lema \ref{lem:12-1},
        por lo que el integrando está acotado por $Ae^{\pi\abs{t}}R^{\sigma-1}$, en donde $A$
        es la cota de $\abs{g(z)}$ introducida en el lema \ref{lem:12-1}; luego la integral
        está acotada por
        \begin{equation*}
            2\pi Ae^{\pi\abs{t}}R^{\sigma},
        \end{equation*}
        que $\to0$ cuando $R\to\infty$ si $\sigma<0$. Por consiguiente, si reemplazamos $s$ por
        $1-s$ vemos que
        \begin{equation}\label{eq:12-11}
            \lim_{N\to\infty}I_N(1-s,a)=I(1-s,a)\qquad\text{si }\sigma>1.
        \end{equation}
        Ahora calculamos $I_N(1-s,a)$ explícitamente mediante el teorema de residuos de
        Cauchy\index{cauchy, augustin-louis@Cauchy, Augustin-Louis}. Tenemos
        \begin{equation*}
            I_N(1-s,a)=-\sum_{\substack{n=-N\\n\neq0}}^{N}R(n)=-\sum_{n=1}^{N}\{R(n)+R(-n)\}
        \end{equation*}
        en donde
        \begin{equation*}
            R(n)=\operatorname*{Res}_{z=2n\pi i}\left(\frac{z^{-s}e^{az}}{1-e^z}\right).
        \end{equation*}
        Ahora bien
        \begin{equation*}
            R(n)=\lim_{z\to2n\pi i}(z-2n\pi i)\frac{z^{-s}e^{az}}{1-e^z}=\frac{e^{2n\pi ia}}{(2n\pi i)^s}\lim_{z\to2n\pi i}\frac{z-2n\pi i}{1-e^z}=-\frac{e^{2n\pi ia}}{(2n\pi i)^s},
        \end{equation*}
        luego
        \begin{equation*}
            I_N(1-s,a)=\sum_{n=1}^{N}\frac{e^{2n\pi ia}}{(2n\pi i)^s}+\sum_{n=1}^{N}\frac{e^{-2n\pi ia}}{(-2n\pi i)^s}.
        \end{equation*}
        Pero $i^{-s}=e^{-\pi is/2}$ y $(-i)^{-s}=e^{\pi is/2}$, luego
        \begin{equation*}
            I_N(1-s,a)=\frac{e^{-\pi is/2}}{(2\pi)^s}\sum_{n=1}^{N}\frac{e^{2n\pi ia}}{n^s}+\frac{e^{\pi is/2}}{(2\pi)^s}\sum_{n=1}^{N}\frac{e^{-2n\pi ia}}{n^s}.
        \end{equation*}
        Si hacemos que $N\to\infty$ y utilizamos \eqref{eq:12-11} obtenemos
        \begin{equation*}
            I(1-s,a)=\frac{e^{-\pi is/2}}{(2\pi)^s}F(a,s)+\frac{e^{\pi is/2}}{(2\pi)^s}F(-a,s).
        \end{equation*}
        Luego
        \begin{equation*}
            \zeta(1-s,a)=\Gamma(s)I(1-s,a)=\frac{\Gamma(s)}{(2\pi)^s}\left\{e^{-\pi is/2}F(a,s)+e^{\pi is/2}F(-a,s)\right\}.\qedhere
        \end{equation*}
    \end{proof}

    \section{LA ECUACIÓN FUNCIONAL PARA LA FUNCIÓN ZETA DE RIEMANN}
\index{ecuacion funcional@Ecuación funcional}\index{funcion zeta de riemann@Función zeta de Riemann}
    La primera aplicación de la fórmula de Hurwitz\index{formula de hurwitz para zeta(s,a)@Fórmula de Hurwitz para $\zeta(s,a)$} es la ecuación funcional de Riemann para
    $\zeta(s)$.

    \begin{teorema}\label{teo:12-7}
        Para todo $s$ tenemos
        \begin{equation}\label{eq:12-12}
            \zeta(1-s)=2(2\pi)^{-s}\Gamma(s)\cos\left(\frac{\pi s}{2}\right)\zeta(s)
        \end{equation}
        o, lo que es equivalente,
        \begin{equation}\label{eq:12-13}
            \zeta(s)=2(2\pi)^{s-1}\Gamma(1-s)\operatorname{sen}\left(\frac{\pi s}{2}\right)\zeta(1-s).
        \end{equation}
    \end{teorema}

    \begin{proof}
        Hacemos $a=1$ en la fórmula de Hurwitz\index{hurwitz, adolf@Hurwitz, Adolf} y obtenemos, para $\sigma>1$,
        \begin{equation*}
            \zeta(1-s)=\frac{\Gamma(s)}{(2\pi)^s}\left\{e^{-\pi is/2}\zeta(s)+e^{\pi is/2}\zeta(s)\right\}=\frac{\Gamma(s)}{(2\pi)^s}\,2\cos\left(\frac{\pi s}{2}\right)\zeta(s).
        \end{equation*}
        Esto prueba \eqref{eq:12-12} para $\sigma>1$ y el resultado se verifica para todo $s$
        por prolongación analítica\index{prolongacion analitica@Prolongación analítica}. Para deducir \eqref{eq:12-13} de \eqref{eq:12-12}
        reemplazamos $s$ por $1-s$.
    \end{proof}

    Nota. Hacemos $s=2n+1$ en \eqref{eq:12-12} en donde $n=1,2,3,\dots$ y entonces el factor
    $\cos(\pi s/2)$ se anula y obtenemos los llamados \textit{ceros triviales\index{ceros triviales de zeta(s)@Ceros triviales de $\zeta(s)$}} de $\zeta(s)$,
    \begin{equation*}
        \zeta(-2n)=0\qquad\text{para }n=1,2,3,\dots
    \end{equation*}

    La ecuación funcional se puede expresar de forma más sencilla utilizando la fórmula de
    duplicación de Legendre relativa a la función gamma\index{funcion gamma@Función gamma},
    \begin{equation*}
        2\pi^{1/2}2^{-2s}\Gamma(2s)=\Gamma(s)\Gamma\left(s+\frac{1}{2}\right),
    \end{equation*}
    que es el caso especial $m=2$ de la ecuación \eqref{eq:12-4}. Si substituimos $s$ por
    $(1-s)/2$, ésta se transforma en
    \begin{equation*}
        2^s\pi^{1/2}\Gamma(1-s)=\Gamma\left(\frac{1-s}{2}\right)\Gamma\left(1-\frac{s}{2}\right).
    \end{equation*}
    Pero
    \begin{equation*}
        \Gamma\left(\frac{s}{2}\right)\Gamma\left(1-\frac{s}{2}\right)=\frac{\pi}{\operatorname{sen}\dfrac{\pi s}{2}}
    \end{equation*}
    nos la transforma en
    \begin{equation*}
        \Gamma(1-s)\operatorname{sen}\frac{\pi s}{2}=\frac{2^{-s}\pi^{1/2}\Gamma\left(\dfrac{1-s}{2}\right)}{\Gamma\left(\dfrac{s}{2}\right)}.
    \end{equation*}
    Este resultado lo utilizamos para substituirlo en el producto $\Gamma(1-s)\operatorname{sen}(\pi s/2)$
    de \eqref{eq:12-13} y obtenemos
    \begin{equation*}
        \pi^{-s/2}\Gamma\left(\frac{s}{2}\right)\zeta(s)=\pi^{-(1-s)/2}\Gamma\left(\frac{1-s}{2}\right)\zeta(1-s).
    \end{equation*}
    Con otras palabras, la ecuación funcional\index{ecuacion funcional@Ecuación funcional} toma la forma
    \begin{equation*}
        \Phi(s)=\Phi(1-s),
    \end{equation*}
    en donde
    \begin{equation*}
        \Phi(s)=\pi^{-s/2}\Gamma\left(\frac{s}{2}\right)\zeta(s).
    \end{equation*}
    La función $\Phi(s)$ tiene polos simples en $s=0$ y en $s=1$. Siguiendo a Riemann\index{riemann, georg friedrich bernhard@Riemann, Georg Friedrich Bernhard},
    multiplicamos $\Phi(s)$ por $s(s-1)/2$ para quitar los polos y definimos
    \begin{equation*}
        \xi(s)=\frac{1}{2}s(s-1)\Phi(s).
    \end{equation*}
    Entonces $\xi(s)$ es una función entera de $s$ y satisface la ecuación funcional
    \begin{equation*}
        \xi(s)=\xi(1-s).
    \end{equation*}

    \section{UNA ECUACIÓN FUNCIONAL PARA LA FUNCIÓN ZETA DE HURWITZ}
\index{funcion zeta de hurwitz@Función zeta de Hurwitz}
    La ecuación funcional\index{ecuacion funcional@Ecuación funcional} para $\zeta(s)$ es un caso especial de una ecuación funcional para
    $\zeta(s,a)$ cuando $a$ es racional.

    \begin{teorema}\label{teo:12-8}
        Si $h$ y $k$ son enteros, $1\leq h\leq k$, entonces para todo $s$ tenemos
        \begin{equation}\label{eq:12-14}
            \zeta\left(1-s,\frac{h}{k}\right)=\frac{2\Gamma(s)}{(2\pi k)^s}\sum_{r=1}^{k}\cos\left(\frac{\pi s}{2}-\frac{2\pi rh}{k}\right)\zeta\left(s,\frac{r}{k}\right).
        \end{equation}
    \end{teorema}

    \begin{proof}
        Este resultado se obtiene del hecho de que la función $F(x,s)$ es una combinación
        lineal de funciones zeta de Hurwitz cuando $x$ es racional. En efecto, si $x=h/k$,
        podemos cambiar el orden de los términos de \eqref{eq:12-9} de acuerdo con las clases
        de restos mód $k$ y escribir
        \begin{equation*}
            n=qk+r,\qquad\text{en donde }1\leq r\leq k\text{ y }q=0,1,2,\dots
        \end{equation*}
        Esto nos da, para $\sigma>1$,
        \begin{align*}
            F\left(\frac{h}{k},s\right)&=\sum_{n=1}^{\infty}\frac{e^{2\pi inh/k}}{n^s}=\sum_{r=1}^{k}\sum_{q=0}^{\infty}\frac{e^{2\pi irh/k}}{(qk+r)^s}=\frac{1}{k^s}\sum_{r=1}^{k}e^{2\pi irh/k}\sum_{q=0}^{\infty}\frac{1}{\left(q+\dfrac{r}{k}\right)^s}\\
            &=k^{-s}\sum_{r=1}^{k}e^{2\pi irh/k}\zeta\left(s,\frac{r}{k}\right).
        \end{align*}
        Por consiguiente, si hacemos $a=h/k$ en la fórmula de Hurwitz\index{formula de hurwitz para zeta(s,a)@Fórmula de Hurwitz para $\zeta(s,a)$}\index{hurwitz, adolf@Hurwitz, Adolf} obtenemos
        \begin{align*}
            \zeta\left(1-s,\frac{h}{k}\right)&=\frac{\Gamma(s)}{(2\pi k)^s}\sum_{r=1}^{k}\left(e^{-\pi is/2}e^{2\pi irh/k}+e^{\pi is/2}e^{-2\pi irh/k}\right)\zeta\left(s,\frac{r}{k}\right)\\
            &=\frac{2\Gamma(s)}{(2\pi k)^s}\sum_{r=1}^{k}\cos\left(\frac{\pi s}{2}-\frac{2\pi rh}{k}\right)\zeta\left(s,\frac{r}{k}\right),
        \end{align*}
        que prueba \eqref{eq:12-14} para $\sigma>1$. El resultado vale para todo $s$ por
        prolongación analítica.
    \end{proof}

    Conviene observar que cuando $h=k=1$, sólo existe un término en la suma de
    \eqref{eq:12-14} y se obtiene la ecuación funcional de Riemann.

    \section[LA ECUACIÓN FUNCIONAL PARA $L$-FUNCIONES]{LA ECUACIÓN FUNCIONAL PARA \texorpdfstring{$L$}{L}-FUNCIONES}
\index{ecuacion funcional@Ecuación funcional}
    También podemos utilizar la fórmula de Hurwitz\index{formula de hurwitz para zeta(s,a)@Fórmula de Hurwitz para $\zeta(s,a)$} para deducir una ecuación funcional para
    las $L$-funciones de Dirichlet. En primer lugar probaremos que basta considerar solamente
    los caracteres primitivos mód $k$.

    \begin{teorema}\label{teo:12-9}
        Sea $\chi$ un carácter de Dirichlet mód $k$, sea $d$ un módulo inducido, y escribamos
        \begin{equation*}
            \chi(n)=\psi(n)\chi_1(n),
        \end{equation*}
        en donde $\psi$ es un carácter mód $d$ y $\chi_1$ es el carácter principal mód $k$.
        Entonces, para todo $s$ tenemos
        \begin{equation*}
            L(s,\chi)=L(s,\psi)\prod_{p\mid k}\left(1-\frac{\psi(p)}{p^s}\right).
        \end{equation*}
    \end{teorema}

    \begin{proof}
        Primeramente hacemos $\sigma>1$ y utilizamos el producto de Euler\index{productos de euler@Productos de Euler}
        \begin{equation*}
            L(s,\chi)=\prod_p\frac{1}{1-\dfrac{\chi(p)}{p^s}}.
        \end{equation*}
        Al ser $\chi(p)=\psi(p)\chi_1(p)$ y $\chi_1(p)=0$ si $p\mid k$ y $\chi_1(p)=1$ si
        $p\nmid k$ obtenemos
        \begin{align*}
            L(s,\chi)&=\prod_{p\nmid k}\frac{1}{1-\dfrac{\psi(p)}{p^s}}=\prod_p\frac{1}{1-\dfrac{\psi(p)}{p^s}}\cdot\prod_{p\mid k}\left(1-\frac{\psi(p)}{p^s}\right)\\
            &=L(s,\psi)\prod_{p\mid k}\left(1-\frac{\psi(p)}{p^s}\right).
        \end{align*}
        Esto prueba el teorema para $\sigma>1$ y lo extendemos a todo $s$ por prolongación
        analítica.
    \end{proof}

    Nota. Si en el teorema anterior elegimos $d$ de forma que sea el conductor\index{conductor de un caracter@Conductor de un carácter} de $\chi$,
    entonces $\psi$ es un carácter primitivo mód $d$. Esto prueba que cada $L$-serie
    $L(s,\chi)$ es igual a la $L$-serie $L(s,\psi)$ de un carácter primitivo, multiplicada por
    un número finito de factores.

    Para deducir la ecuación funcional\index{ecuacion funcional@Ecuación funcional} para $L$-funciones a partir de la fórmula de Hurwitz\index{formula de hurwitz para zeta(s,a)@Fórmula de Hurwitz para $\zeta(s,a)$}\index{hurwitz, adolf@Hurwitz, Adolf},
    ante todo expresaremos $L(s,\chi)$ en términos de la función zeta periódica\index{funcion zeta periodica@Función zeta periódica} $F(x,s)$.

    \begin{teorema}\label{teo:12-10}
        Sea $\chi$ un carácter primitivo mód $k$. Entonces, para $\sigma>1$, tenemos
        \begin{equation}\label{eq:12-15}
            G(1,\bar{\chi})L(s,\chi)=\sum_{h=1}^{k}\bar{\chi}(h)F\left(\frac{h}{k},s\right),
        \end{equation}
        en donde $G(m,\chi)$ es la suma de Gauss asociada a $\chi$,
        \begin{equation*}
            G(m,\chi)=\sum_{r=1}^{k}\chi(r)e^{2\pi irm/k}.
        \end{equation*}
    \end{teorema}

    \begin{proof}
        Hacemos $x=h/k$ en \eqref{eq:12-9}, multiplicamos por $\bar{\chi}(h)$, sumamos respecto
        de $h$ y obtenemos
        \begin{equation*}
            \sum_{h=1}^{k}\bar{\chi}(h)F\left(\frac{h}{k},s\right)=\sum_{h=1}^{k}\sum_{n=1}^{\infty}\bar{\chi}(h)e^{2\pi inh/k}n^{-s}=\sum_{n=1}^{\infty}n^{-s}\sum_{h=1}^{k}\bar{\chi}(h)e^{2\pi inh/k}=\sum_{n=1}^{\infty}n^{-s}G(n,\bar{\chi}).
        \end{equation*}
        Pero $G(n,\bar{\chi})$ es separable puesto que $\bar{\chi}$ es primitivo, luego
        $G(n,\bar{\chi})=\chi(n)G(1,\bar{\chi})$, luego
        \begin{equation*}
            \sum_{h=1}^{k}\bar{\chi}(h)F\left(\frac{h}{k},s\right)=G(1,\bar{\chi})\sum_{n=1}^{\infty}\chi(n)n^{-s}=G(1,\bar{\chi})L(s,\chi).\qedhere
        \end{equation*}
    \end{proof}

    \begin{teorema}[Ecuación funcional para $L$-funciones de Dirichlet]\label{teo:12-11}
        Si $\chi$ es un carácter primitivo mód $k$, entonces, para todo $s$, tenemos
        \begin{equation}\label{eq:12-16}
            L(1-s,\chi)=\frac{k^{s-1}\Gamma(s)}{(2\pi)^s}\left\{e^{-\pi is/2}+\chi(-1)e^{\pi is/2}\right\}G(1,\chi)L(s,\bar{\chi}).
        \end{equation}
    \end{teorema}

    \begin{proof}
        Hacemos $x=h/k$ en la fórmula de Hurwitz\index{formula de hurwitz para zeta(s,a)@Fórmula de Hurwitz para $\zeta(s,a)$}, a continuación multiplicamos cada miembro por
        $\chi(h)$ y sumamos respecto de $h$. Ello nos proporciona
        \begin{equation*}
            \sum_{h=1}^{k}\chi(h)\zeta\left(1-s,\frac{h}{k}\right)=\frac{\Gamma(s)}{(2\pi)^s}\left\{e^{-\pi is/2}\sum_{h=1}^{k}\chi(h)F\left(\frac{h}{k},s\right)+e^{\pi is/2}\sum_{h=1}^{k}\chi(h)F\left(\frac{-h}{k},s\right)\right\}.
        \end{equation*}
        Como $F(x,s)$ es periódica en $x$ de período 1 y $\chi(h)=\chi(-1)\chi(-h)$ podemos
        escribir
        \begin{align*}
            \sum_{h\bmod k}\chi(h)F\left(\frac{-h}{k},s\right)&=\chi(-1)\sum_{h\bmod k}\chi(-h)F\left(\frac{-h}{k},s\right)\\
            &=\chi(-1)\sum_{h\bmod k}\chi(k-h)F\left(\frac{k-h}{k},s\right)\\
            &=\chi(-1)\sum_{h\bmod k}\chi(h)F\left(\frac{h}{k},s\right),
        \end{align*}
        y la fórmula precedente se transforma en
        \begin{equation*}
            \sum_{h=1}^{k}\chi(h)\zeta\left(1-s,\frac{h}{k}\right)=\frac{\Gamma(s)}{(2\pi)^s}\left\{e^{-\pi is/2}+\chi(-1)e^{\pi is/2}\right\}\sum_{h=1}^{k}\chi(h)F\left(\frac{h}{k},s\right).
        \end{equation*}
        Ahora multiplicamos ambos miembros por $k^{s-1}$ y utilizamos \eqref{eq:12-15}, con
        $\chi$ y $\bar{\chi}$ intercambiados, para obtener \eqref{eq:12-16}.
    \end{proof}

    \section{CÁLCULO DE \texorpdfstring{$\zeta(-n,a)$}{ζ(-n,a)}}\label{sim:Bn}

    El valor de $\zeta(-n,a)$ se puede calcular de forma explícita si $n$ es un entero no
    negativo. Tomamos $s=-n$ en la relación $\zeta(s,a)=\Gamma(1-s)I(s,a)$ y obtenemos
    \begin{equation*}
        \zeta(-n,a)=\Gamma(1+n)I(-n,a)=n!\,I(-n,a).
    \end{equation*}
    Además tenemos
    \begin{equation*}
        I(-n,a)=\operatorname*{Res}_{z=0}\left(\frac{z^{-n-1}e^{az}}{1-e^z}\right).
    \end{equation*}
    El cálculo de este residuo conduce a una clase interesante de funciones que se conocen
    con el nombre de \textit{polinomios de Bernoulli\index{bernoulli, jacques@Bernoulli, Jacques}\index{bernoulli, polinomios@Bernoulli, polinomios}}.

    \begin{definicion}
        Para cada complejo $x$ definimos la función $B_n(x)$ por la ecuación
        \begin{equation*}
            \frac{ze^{xz}}{e^z-1}=\sum_{n=0}^{\infty}\frac{B_n(x)}{n!}z^n,\qquad\text{en donde }\abs{z}<2\pi.
        \end{equation*}
        Los números $B_n(0)$ se llaman números de Bernoulli\index{bernoulli, jacques@Bernoulli, Jacques}\index{bernoulli, numeros@Bernoulli, números} y se designan $B_n$. Entonces
        \begin{equation*}
            \frac{z}{e^z-1}=\sum_{n=0}^{\infty}\frac{B_n}{n!}z^n,\qquad\text{en donde }\abs{z}<2\pi.
        \end{equation*}
    \end{definicion}

    \begin{teorema}\label{teo:12-12}
        Las funciones $B_n(x)$ son polinomios en $x$ dados por
        \begin{equation*}
            B_n(x)=\sum_{k=0}^{n}\binom{n}{k}B_kx^{n-k}.
        \end{equation*}
    \end{teorema}

    \begin{proof}
        Tenemos
        \begin{equation*}
            \sum_{n=0}^{\infty}\frac{B_n(x)}{n!}z^n=\frac{z}{e^z-1}\cdot e^{xz}=\left(\sum_{n=0}^{\infty}\frac{B_n}{n!}z^n\right)\left(\sum_{n=0}^{\infty}\frac{x^n}{n!}z^n\right).
        \end{equation*}
        Igualando los coeficientes de $z^n$ obtenemos
        \begin{equation*}
            \frac{B_n(x)}{n!}=\sum_{k=0}^{n}\frac{B_k}{k!}\,\frac{x^{n-k}}{(n-k)!}
        \end{equation*}
        de donde se sigue el teorema.
    \end{proof}

    \begin{teorema}\label{teo:12-13}
        Para cada entero $n\geq0$ tenemos
        \begin{equation}\label{eq:12-17}
            \zeta(-n,a)=-\frac{B_{n+1}(a)}{n+1}.
        \end{equation}
    \end{teorema}

    \begin{proof}
        Como ya hemos indicado anteriormente, tenemos $\zeta(-n,a)=n!\,I(-n,a)$. Ahora bien
        \begin{equation*}
            I(-n,a)=\operatorname*{Res}_{z=0}\left(\frac{z^{-n-1}e^{az}}{1-e^z}\right)=-\operatorname*{Res}_{z=0}\left(z^{-n-2}\,\frac{ze^{az}}{e^z-1}\right)
            =-\operatorname*{Res}_{z=0}\left(z^{-n-2}\sum_{m=0}^{\infty}\frac{B_m(a)}{m!}z^m\right)=-\frac{B_{n+1}(a)}{(n+1)!},
        \end{equation*}
        de donde se obtiene \eqref{eq:12-17}.
    \end{proof}

    \section{PROPIEDADES DE LOS NÚMEROS DE BERNOULLI Y DE LOS POLINOMIOS DE BERNOULLI}
\index{bernoulli, numeros@Bernoulli, números}\index{bernoulli, polinomios@Bernoulli, polinomios}
    \begin{teorema}\label{teo:12-14}
        Los polinomios de Bernoulli\index{bernoulli, polinomios@Bernoulli, polinomios} $B_n(x)$ satisfacen la ecuación de diferencias
        \begin{equation}\label{eq:12-18}
            B_n(x+1)-B_n(x)=nx^{n-1}\qquad\text{si }n\geq1.
        \end{equation}
        Por consiguiente tenemos
        \begin{equation}\label{eq:12-19}
            B_n(0)=B_n(1)\qquad\text{si }n\geq2.
        \end{equation}
    \end{teorema}

    \begin{proof}
        Tenemos la identidad
        \begin{equation*}
            z\,\frac{e^{(x+1)z}}{e^z-1}-z\,\frac{e^{xz}}{e^z-1}=ze^{xz}
        \end{equation*}
        de la que resulta
        \begin{equation*}
            \sum_{n=0}^{\infty}\frac{B_n(x+1)-B_n(x)}{n!}z^n=\sum_{n=0}^{\infty}\frac{x^n}{n!}z^{n+1}.
        \end{equation*}
        Igualando los coeficientes de $z^n$ obtenemos \eqref{eq:12-18}. Haciendo $x=0$ en
        \eqref{eq:12-18} se deduce \eqref{eq:12-19}.
    \end{proof}

    \begin{teorema}\label{teo:12-15}
        Si $n\geq2$ tenemos
        \begin{equation*}
            B_n=\sum_{k=0}^{n}\binom{n}{k}B_k.
        \end{equation*}
    \end{teorema}

    \begin{proof}
        Este resultado se obtiene haciendo $x=1$ en el teorema \ref{teo:12-12} y utilizando
        \eqref{eq:12-19}.
    \end{proof}

    El teorema \ref{teo:12-15} nos proporciona una fórmula recurrente para calcular los
    números de Bernoulli\index{bernoulli, jacques@Bernoulli, Jacques}\index{bernoulli, numeros@Bernoulli, números}. La definición nos da $B_0=1$, y el teorema \ref{teo:12-15}
    proporciona sucesivamente los valores
    \begin{gather*}
        B_0=1,\qquad B_1=-\frac{1}{2},\qquad B_2=\frac{1}{6},\qquad B_3=0,\qquad B_4=-\frac{1}{30},\\
        B_5=0,\qquad B_6=\frac{1}{42},\qquad B_7=0,\qquad B_8=-\frac{1}{30},\qquad B_9=0,\\
        B_{10}=\frac{5}{66},\qquad B_{11}=0.
    \end{gather*}
    Conociendo los $B_k$ podemos calcular los polinomios $B_n(x)$ utilizando el teorema
    \ref{teo:12-12}. Los primeros son:
    \begin{gather*}
        B_0(x)=1,\qquad B_1(x)=x-\frac{1}{2},\qquad B_2(x)=x^2-x+\frac{1}{6},\\
        B_3(x)=x^3-\frac{3}{2}x^2+\frac{1}{2}x,\qquad B_4(x)=x^4-2x^3+x^2-\frac{1}{30}.
    \end{gather*}
    Observamos que los teoremas \ref{teo:12-12} y \ref{teo:12-15} se pueden escribir
    simbólicamente como sigue:
    \begin{equation*}
        B_n(x)=(B+x)^n,\qquad B_n=(B+1)^n.
    \end{equation*}
    En estas fórmulas simbólicas los segundos miembros se desarrollan por el teorema del
    binomio y entonces cada potencia $B^k$ se substituye por $B_k$.

    \begin{teorema}\label{teo:12-16}
        Si $n\geq0$ tenemos
        \begin{equation}\label{eq:12-20}
            \zeta(-n)=-\frac{B_{n+1}}{n+1}.
        \end{equation}
        También, si $n\geq1$ tenemos $\zeta(-2n)=0$, por consiguiente $B_{2n+1}=0$.
    \end{teorema}

    \begin{proof}
        Para calcular $\zeta(-n)$ basta tomar simplemente $a=1$ en el teorema
        \ref{teo:12-13}. Ya hemos observado que la ecuación funcional
        \begin{equation}\label{eq:12-21}
            \zeta(1-s)=2(2\pi)^{-s}\Gamma(s)\cos\left(\frac{\pi s}{2}\right)\zeta(s)
        \end{equation}
        implica $\zeta(-2n)=0$ para $n\geq1$, luego $B_{2n+1}=0$ por \eqref{eq:12-20}.
    \end{proof}

    Nota. El resultado $B_{2n-1}=0$ también se obtiene observando que el primer miembro de
    \begin{equation*}
        \frac{z}{e^z-1}+\frac{1}{2}z=1+\sum_{n=2}^{\infty}\frac{B_n}{n!}z^n
    \end{equation*}
    es una función par de $z$.

    \begin{teorema}\label{teo:12-17}
        Si $k$ es un entero positivo tenemos
        \begin{equation}\label{eq:12-22}
            \zeta(2k)=(-1)^{k+1}\frac{(2\pi)^{2k}B_{2k}}{2(2k)!}.
        \end{equation}
    \end{teorema}

    \begin{proof}
        Hacemos $s=2k$ en la ecuación funcional\index{ecuacion funcional@Ecuación funcional} de $\zeta(s)$ y se obtiene
        \begin{equation*}
            \zeta(1-2k)=2(2\pi)^{-2k}\Gamma(2k)\cos(\pi k)\zeta(2k),
        \end{equation*}
        o bien
        \begin{equation*}
            -\frac{B_{2k}}{2k}=2(2\pi)^{-2k}(2k-1)!(-1)^k\zeta(2k).
        \end{equation*}
        Esto implica \eqref{eq:12-22}.
    \end{proof}

    Nota. Si hacemos $s=2k-1$ en \eqref{eq:12-21} ambos miembros se anulan y carecemos de
    información acerca de $\zeta(2k+1)$. Con todo se desconoce una fórmula simple análoga a
    \eqref{eq:12-22} para casos especiales tales como $\zeta(3)$ e incluso para $\zeta(2k+1)$.
    Tampoco se sabe cuándo $\zeta(2k+1)$ es racional o irracional para cada $k$.

    \begin{teorema}\label{teo:12-18}
        Los números de Bernoulli\index{bernoulli, jacques@Bernoulli, Jacques}\index{bernoulli, numeros@Bernoulli, números} $B_{2k}$ tienen signo alternativo. Es decir
        \begin{equation*}
            (-1)^{k+1}B_{2k}>0.
        \end{equation*}
        Además, $\abs{B_{2k}}\to\infty$ cuando $k\to\infty$. De hecho,
        \begin{equation}\label{eq:12-23}
            (-1)^{k+1}B_{2k}\sim\frac{2(2k)!}{(2\pi)^{2k}}\qquad\text{cuando }k\to\infty.
        \end{equation}
    \end{teorema}

    \begin{proof}
        Dado que $\zeta(2k)>0$, \eqref{eq:12-22} prueba que los números $B_{2k}$ cambian de
        signo. La relación asintótica \eqref{eq:12-23} se obtiene del hecho de que
        $\zeta(2k)\to1$ cuando $k\to\infty$.
    \end{proof}

    Nota. De \eqref{eq:12-23} se obtiene $\abs{B_{2k+2}/B_{2k}}\sim k^2/\pi^2$ cuando
    $k\to\infty$. Además, invocando la fórmula de Stirling, $n!\sim(n/e)^n\sqrt{2\pi n}$
    obtenemos
    \begin{equation*}
        (-1)^{k+1}B_{2k}\sim4\pi\sqrt{k}\left(\frac{k}{\pi e}\right)^{2k+1/2}\qquad\text{cuando }k\to\infty.
    \end{equation*}

    El teorema que sigue da el desarrollo de Fourier del polinomio $B_n(x)$ en el intervalo
    $0<x\leq1$.

    \begin{teorema}\label{teo:12-19}
        Si $0<x\leq1$ tenemos
        \begin{equation}\label{eq:12-24}
            B_n(x)=-\frac{n!}{(2\pi i)^n}\sum_{\substack{k=-\infty\\k\neq0}}^{+\infty}\frac{e^{2\pi ikx}}{k^n},
        \end{equation}
        y entonces
        \begin{align*}
            B_{2n}(x)&=(-1)^{n+1}\frac{2(2n)!}{(2\pi)^{2n}}\sum_{k=1}^{\infty}\frac{\cos2\pi kx}{k^{2n}},\\
            B_{2n+1}(x)&=(-1)^{n+1}\frac{2(2n+1)!}{(2\pi)^{2n+1}}\sum_{k=1}^{\infty}\frac{\operatorname{sen}2\pi kx}{k^{2n+1}}.
        \end{align*}
    \end{teorema}

    \begin{proof}
        La ecuación \eqref{eq:12-24} se obtiene inmediatamente haciendo $s=n$ en la fórmula de
        Hurwitz\index{hurwitz, adolf@Hurwitz, Adolf} y aplicando el teorema \ref{teo:12-13}. Las otras dos fórmulas son casos
        especiales de \eqref{eq:12-24}.
    \end{proof}

    Nota. La función $\bar{B}_n(x)$ definida para todo real $x$ por el segundo miembro de
    \eqref{eq:12-24} se llama \textit{$n$-ésima función periódica de Bernoulli\index{bernoulli, funciones periodicas@Bernoulli, funciones periódicas}}. Es periódica\label{sim:Bbar}
    de período 1 y coincide con el polinomio de Bernoulli\index{bernoulli, jacques@Bernoulli, Jacques}\index{bernoulli, polinomios@Bernoulli, polinomios} $B_n(x)$ en el intervalo
    $0<x\leq1$. Entonces tenemos
    \begin{equation*}
        \bar{B}_n(x)=B_n(x-[x]).
    \end{equation*}

    \section{FÓRMULAS PARA \texorpdfstring{$L(0,\chi)$}{L(0,χ)}}

    El teorema \ref{teo:12-13} implica
    \begin{equation*}
        \zeta(0,a)=-B_1(a)=\frac{1}{2}-a.
    \end{equation*}
    En particular $\zeta(0)=\zeta(0,1)=-1/2$. También podemos calcular $L(0,\chi)$ para cada
    carácter de Dirichlet $\chi$.

    \begin{teorema}\label{teo:12-20}
        Sea $\chi$ un carácter cualquiera de Dirichlet mód $k$.
        \begin{enumerate}
            \item[(a)] Si $\chi=\chi_1$ (el carácter principal\index{caracter principal@Carácter principal}), entonces $L(0,\chi_1)=0$.
            \item[(b)] Si $\chi\neq\chi_1$ tenemos
            \begin{equation*}
                L(0,\chi)=-\frac{1}{k}\sum_{r=1}^{k}r\chi(r).
            \end{equation*}
        \end{enumerate}
        Además, $L(0,\chi)=0$ si $\chi(-1)=1$.
    \end{teorema}

    \begin{proof}
        Si $\chi=\chi_1$ utilizamos la fórmula
        \begin{equation*}
            L(s,\chi_1)=\zeta(s)\prod_{p\mid k}(1-p^{-s})
        \end{equation*}
        demostrada para $\sigma>1$ en el capítulo 11. También es válida para todo $s$ por
        prolongación analítica\index{prolongacion analitica@Prolongación analítica}. Cuando $s=0$ el producto se anula, luego $L(0,\chi_1)=0$.

        Si $\chi\neq\chi_1$ tenemos
        \begin{equation*}
            L(0,\chi)=\sum_{r=1}^{k}\chi(r)\zeta\left(0,\frac{r}{k}\right)=\sum_{r=1}^{k}\chi(r)\left(\frac{1}{2}-\frac{r}{k}\right)=-\frac{1}{k}\sum_{r=1}^{k}r\chi(r).
        \end{equation*}
        Ahora bien
        \begin{equation*}
            \sum_{r=1}^{k}r\chi(r)=\sum_{r=1}^{k}(k-r)\chi(k-r)=k\sum_{r=1}^{k}\chi(k-r)-\sum_{r=1}^{k}r\chi(-r)=-\chi(-1)\sum_{r=1}^{k}r\chi(r).
        \end{equation*}
        Por consiguiente, si $\chi(-1)=1$, tenemos $\sum_{r=1}^{k}r\chi(r)=0$.
    \end{proof}

    \section[APROXIMACIÓN DE $\zeta(s,a)$ POR MEDIO DE SUMAS FINITAS]{APROXIMACIÓN DE \texorpdfstring{$\zeta(s,a)$}{ζ(s,a)} POR MEDIO DE SUMAS FINITAS}

    Algunas aplicaciones requieren valorar el orden de crecimiento de $\zeta(\sigma+it,a)$ como
    función de $t$. Esto se deduce de otra representación de $\zeta(s,a)$ obtenida de la
    fórmula de sumación de Euler\index{formula de sumacion de euler@Fórmula de sumación de Euler}. Esta relaciona $\zeta(s,a)$ con las sumas parciales de su
    serie en el semiplano $\sigma>0$ y además proporciona otro camino para extender
    $\zeta(s,a)$ analíticamente al otro lado de la recta $\sigma=1$.

    \begin{teorema}\label{teo:12-21}
        Para todo entero $N\geq0$ y $\sigma>0$ tenemos
        \begin{equation}\label{eq:12-25}
            \zeta(s,a)=\sum_{n=0}^{N}\frac{1}{(n+a)^s}+\frac{(N+a)^{1-s}}{s-1}-s\int_N^{\infty}\frac{x-[x]}{(x+a)^{s+1}}\,dx.
        \end{equation}
    \end{teorema}

    \begin{proof}
        Aplicando la fórmula de sumación de Euler (teorema 3.1) con $f(t)=(t+a)^{-s}$ y con $x$
        e $y$ enteros, obtenemos
        \begin{equation*}
            \sum_{y<n\leq x}\frac{1}{(n+a)^s}=\int_y^x\frac{dt}{(t+a)^s}-s\int_y^x\frac{t-[t]}{(t+a)^{s+1}}\,dt.
        \end{equation*}
        Tomando $y=N$ y haciendo que $x\to\infty$, y siempre $\sigma>1$, obtenemos
        \begin{equation*}
            \sum_{n=N+1}^{\infty}\frac{1}{(n+a)^s}=\int_N^{\infty}\frac{dt}{(t+a)^s}-s\int_N^{\infty}\frac{t-[t]}{(t+a)^{s+1}}\,dt,
        \end{equation*}
        luego
        \begin{equation*}
            \zeta(s,a)-\sum_{n=0}^{N}\frac{1}{(n+a)^s}=\frac{(N+a)^{1-s}}{s-1}-s\int_N^{\infty}\frac{t-[t]}{(t+a)^{s+1}}\,dt.
        \end{equation*}
        Esto prueba \eqref{eq:12-25} para $\sigma>1$. Si $\sigma\geq\delta>0$ la integral se
        halla dominada por $\int_N^{\infty}(t+a)^{-\delta-1}\,dt$ por lo que es uniformemente
        convergente para $\sigma\geq\delta$ y por ende representa una función analítica en el
        semiplano $\sigma>0$. Por consiguiente \eqref{eq:12-25} se sigue cumpliendo para
        $\sigma>0$ por prolongación analítica.
    \end{proof}

    La integral de la derecha de \eqref{eq:12-25} se puede escribir también como serie.
    Descomponemos la integral en suma de integrales en cada una de las cuales $[x]$ es
    constante, es decir $[x]=n$, y obtenemos
    \begin{equation*}
        \int_N^{\infty}\frac{x-[x]}{(x+a)^{s+1}}\,dx=\sum_{n=N}^{\infty}\int_n^{n+1}\frac{x-n}{(x+a)^{s+1}}\,dx=\sum_{n=N}^{\infty}\int_0^1\frac{u}{(u+n+a)^{s+1}}\,du.
    \end{equation*}
    Por consiguiente \eqref{eq:12-25} también se puede escribir en la forma
    \begin{equation}\label{eq:12-26}
        \zeta(s,a)-\sum_{n=0}^{N}\frac{1}{(n+a)^s}=\frac{(N+a)^{1-s}}{s-1}-s\sum_{n=N}^{\infty}\int_0^1\frac{u}{(u+n+a)^{s+1}}\,du
    \end{equation}
    si $\sigma>0$. La integración por partes conduce a representaciones similares en
    sucesivos semiplanos cada vez más amplios, tal como indica el teorema que sigue.

    \begin{teorema}\label{teo:12-22}
        Si $\sigma>-1$ tenemos
        \begin{multline}\label{eq:12-27}
            \zeta(s,a)-\sum_{n=0}^{N}\frac{1}{(n+a)^s}=\frac{(N+a)^{1-s}}{s-1}
            -\frac{s}{2!}\left\{\zeta(s+1,a)-\sum_{n=0}^{N}\frac{1}{(n+a)^{s+1}}\right\}\\
            -\frac{s(s+1)}{2!}\sum_{n=N}^{\infty}\int_0^1\frac{u^2}{(n+a+u)^{s+2}}\,du.
        \end{multline}
        En general, si $\sigma>-m$, en donde $m=1,2,3,\dots$, tenemos
        \begin{multline}\label{eq:12-28}
            \zeta(s,a)-\sum_{n=0}^{N}\frac{1}{(n+a)^s}=\frac{(N+a)^{1-s}}{s-1}
            -\sum_{r=1}^{m}\frac{s(s+1)\cdots(s+r-1)}{(r+1)!}\left\{\zeta(s+r,a)-\sum_{n=0}^{N}\frac{1}{(n+a)^{s+r}}\right\}\\
            -\frac{s(s+1)\cdots(s+m)}{(m+1)!}\sum_{n=N}^{\infty}\int_0^1\frac{u^{m+1}}{(n+a+u)^{s+m+1}}\,du.
        \end{multline}
    \end{teorema}

    \begin{proof}
        La integración por partes implica
        \begin{equation*}
            \int\frac{u\,du}{(n+a+u)^{s+1}}=\frac{u^2}{2(n+a+u)^{s+1}}+\frac{s+1}{2}\int\frac{u^2\,du}{(n+a+u)^{s+2}},
        \end{equation*}
        luego, si $\sigma>0$, tenemos
        \begin{equation*}
            \sum_{n=N}^{\infty}\int_0^1\frac{u\,du}{(n+a+u)^{s+1}}=\frac{1}{2}\sum_{n=N}^{\infty}\frac{1}{(n+a+1)^{s+1}}+\frac{s+1}{2}\sum_{n=N}^{\infty}\int_0^1\frac{u^2\,du}{(n+a+u)^{s+2}}.
        \end{equation*}
        Pero, si $\sigma>0$, la primera suma de la derecha es
        $\zeta(s+1,a)-\sum_{n=0}^{N}(n+a)^{-s-1}$ y \eqref{eq:12-26} implica
        \eqref{eq:12-27}. El resultado también es válido para $\sigma>-1$ por prolongación
        analítica. Repitiendo la integración por partes obtenemos la representación más
        general dada por \eqref{eq:12-28}.
    \end{proof}

    \section[DESIGUALDADES PARA $\abs{\zeta(s,a)}$]{DESIGUALDADES PARA \texorpdfstring{$\abs{\zeta(s,a)}$}{|ζ(s,a)|}}

    Las fórmulas de la sección anterior proporcionan cotas superiores para
    $\abs{\zeta(\sigma+it,a)}$ como función de $t$.

    \begin{teorema}\label{teo:12-23}
        \begin{enumerate}
            \item[(a)] Si $\delta>0$ tenemos
            \begin{equation}\label{eq:12-29}
                \abs{\zeta(s,a)-a^{-s}}\leq\zeta(1+\delta)\qquad\text{si }\sigma\geq1+\delta.
            \end{equation}
            \item[(b)] Si $0<\delta<1$ existe una constante positiva $A(\delta)$, que depende de
            $\delta$ pero no de $s$ ni de $a$, tal que
            \begin{align}
                \abs{\zeta(s,a)-a^{-s}}&\leq A(\delta)\abs{t}^{\delta}&&\text{si }1-\delta\leq\sigma\leq2\text{ y }\abs{t}\geq1,\label{eq:12-30}\\
                \abs{\zeta(s,a)-a^{-s}}&\leq A(\delta)\abs{t}^{1+\delta}&&\text{si }-\delta\leq\sigma\leq\delta\text{ y }\abs{t}\geq1,\label{eq:12-31}\\
                \abs{\zeta(s,a)}&\leq A(\delta)\abs{t}^{m+1+\delta}&&\text{si }-m-\delta\leq\sigma\leq-m+\delta\text{ y }\abs{t}\geq1,\label{eq:12-32}
            \end{align}
            en donde $m=1,2,3,\dots$
        \end{enumerate}
    \end{teorema}

    \begin{proof}
        Para la parte (a) utilizamos la serie que define $\zeta(s,a)$ y obtenemos
        \begin{equation*}
            \abs{\zeta(s,a)-a^{-s}}\leq\sum_{n=1}^{\infty}\frac{1}{(n+a)^{\sigma}}\leq\sum_{n=1}^{\infty}\frac{1}{n^{1+\delta}}=\zeta(1+\delta),
        \end{equation*}
        que implica \eqref{eq:12-29}.

        Para la parte (b) utilizamos la representación de \eqref{eq:12-25} cuando
        $1-\delta\leq\sigma\leq2$ a fin de obtener
        \begin{align*}
            \abs{\zeta(s,a)-a^{-s}}&\leq\sum_{n=1}^{N}\frac{1}{(n+a)^{\sigma}}+\frac{(N+a)^{1-\sigma}}{\abs{s-1}}+\abs{s}\int_N^{\infty}\frac{dx}{(x+a)^{\sigma+1}}\\
            &<1+\int_1^N\frac{dx}{(x+a)^{\sigma}}+\frac{(N+a)^{1-\sigma}}{\abs{s-1}}+\frac{\abs{s}}{\sigma}(N+a)^{-\sigma}.
        \end{align*}
        Puesto que $\sigma>1-\delta>0$, tenemos $(x+a)^{\sigma}\geq(x+a)^{1-\delta}>x^{1-\delta}$
        luego
        \begin{equation*}
            \int_1^N\frac{dx}{(x+a)^{\sigma}}\leq\int_1^N\frac{dx}{x^{1-\delta}}<\frac{N^{\delta}}{\delta}.
        \end{equation*}
        Además, como $\abs{s-1}=\abs{\sigma-1+it}\geq\abs{t}\geq1$ tenemos
        \begin{equation*}
            \frac{(N+a)^{1-\sigma}}{\abs{s-1}}\leq(N+a)^{\delta}\leq(N+1)^{\delta}.
        \end{equation*}
        Finalmente, como $\abs{s}\leq\abs{\sigma}+\abs{t}\leq2+\abs{t}$ obtenemos
        \begin{equation*}
            \frac{\abs{s}}{\sigma}(N+a)^{-\sigma}<\frac{2+\abs{t}}{1-\delta}(N+a)^{\delta-1}<\frac{2+\abs{t}}{1-\delta}\,\frac{1}{N^{1-\delta}}.
        \end{equation*}
        Esto nos proporciona
        \begin{equation*}
            \abs{\zeta(s,a)-a^{-s}}<1+\frac{N^{\delta}}{\delta}+(N+1)^{\delta}+\frac{2+\abs{t}}{1-\delta}\,\frac{N^{\delta}}{N}.
        \end{equation*}
        Ahora hacemos $N=1+[\abs{t}]$. Entonces los últimos tres términos son
        $O(\abs{t}^{\delta})$, en los cuales la constante que aparece en el símbolo $O$ depende
        únicamente de $\delta$. Esto demuestra \eqref{eq:12-30}.

        Para probar \eqref{eq:12-31} utilizamos la representación de \eqref{eq:12-27}, que nos
        da
        \begin{multline*}
            \abs{\zeta(s,a)-a^{-s}}\leq\sum_{n=1}^{N}\frac{1}{(n+a)^{\sigma}}+\frac{(N+a)^{1-\sigma}}{\abs{s-1}}+\frac{1}{2}\abs{s}\left\{\abs{\zeta(s+1,a)-a^{-s-1}}\right\}\\
            +\frac{1}{2}\abs{s}\sum_{n=1}^{N}\frac{1}{(n+a)^{\sigma+1}}+\frac{1}{2}\abs{s}\abs{s+1}\sum_{n=N}^{\infty}\frac{1}{(n+a)^{\sigma+2}}.
        \end{multline*}
        Como en la demostración de \eqref{eq:12-30}, tomamos $N=1+[\abs{t}]$, así que
        $N=O(\abs{t})$, y vemos que cada término de la derecha es $O(\abs{t}^{1+\delta})$, y
        que la constante que aparece en el símbolo $O$ depende únicamente de $\delta$. Las
        desigualdades $-\delta\leq\sigma\leq\delta$ implican $1-\delta\leq1+\sigma\leq1+\delta$,
        luego
        \begin{equation*}
            \sum_{n=1}^{N}\frac{1}{(n+a)^{\sigma}}<1+\int_1^N\frac{dx}{(x+a)^{\sigma}}<1+\frac{(N+a)^{1-\sigma}}{1-\sigma}\leq1+\frac{(N+1)^{1+\delta}}{1-\delta}=O(\abs{t}^{1+\delta}).
        \end{equation*}
        Como $\abs{s-1}\geq\abs{t}\geq1$, el segundo miembro también es $O(\abs{t}^{1+\delta})$.
        Para el tercer término utilizamos \eqref{eq:12-30}, observando que
        $1-\delta\leq\sigma+1\leq1+\delta$ y que $\abs{s}=O(\abs{t})$, y vemos que este
        término también es $O(\abs{t}^{1+\delta})$. Después, se obtiene
        \begin{equation*}
            \abs{s}\sum_{n=1}^{N}\frac{1}{(n+a)^{\sigma+1}}=O\left(\abs{t}\int_1^N\frac{dx}{(x+a)^{1-\delta}}\right)=O(\abs{t}N^{\delta})=O(\abs{t}^{1+\delta}).
        \end{equation*}
        Finalmente,
        \begin{equation*}
            \abs{s}\abs{s+1}\sum_{n=N}^{\infty}\frac{1}{(n+a)^{\sigma+2}}=O\left(\abs{t}^2\int_N^{\infty}\frac{dx}{(x+a)^{2-\delta}}\right)=O(\abs{t}^2N^{\delta-1})=O(\abs{t}^{1+\delta}).
        \end{equation*}
        Esto termina la demostración de \eqref{eq:12-31}.

        La demostración de \eqref{eq:12-32} es análoga, salvo que utilizamos \eqref{eq:12-28} y
        observamos que $a^{-\sigma}=O(1)$ cuando $\sigma<0$.
    \end{proof}

    \section[DESIGUALDADES PARA $\abs{\zeta(s)}$ Y PARA $\abs{L(s,\chi)}$]{DESIGUALDADES PARA \texorpdfstring{$\abs{\zeta(s)}$}{|ζ(s)|} Y PARA \texorpdfstring{$\abs{L(s,\chi)}$}{|L(s,χ)|}}

    Cuando $a=1$ las acotaciones del teorema \ref{teo:12-23} dan las correspondientes
    acotaciones para $\abs{\zeta(s)}$. Nos proporciona también cotas para las $L$-series de
    Dirichlet. Si $\sigma\geq1+\delta$, en donde $\delta>0$, tanto $\abs{\zeta(s)}$ como
    $\abs{L(s,\chi)}$ se hallan dominadas por $\zeta(1+\delta)$ por lo que únicamente
    consideramos $\sigma\leq1+\delta$.

    \begin{teorema}\label{teo:12-24}
        Sea $\chi$ un carácter de Dirichlet mód $k$ y supongamos $0<\delta<1$. Entonces existe
        una constante positiva $A(\delta)$, que depende de $\delta$ pero no de $s$ ni de $k$,
        tal que para $s=\sigma+it$ con $\abs{t}\geq1$ tenemos
        \begin{equation}\label{eq:12-33}
            \abs{L(s,\chi)}\leq A(\delta)\abs{kt}^{m+1+\delta}\qquad\text{si }-m-\delta\leq\sigma\leq-m+\delta,
        \end{equation}
        en donde $m=-1,0,1,2,\dots$
    \end{teorema}

    \begin{proof}
        Recordamos la relación
        \begin{equation*}
            L(s,\chi)=k^{-s}\sum_{r=1}^{k-1}\chi(r)\zeta\left(s,\frac{r}{k}\right).
        \end{equation*}
        Si $m=1,2,3,\dots$ utilizamos \eqref{eq:12-32} para obtener
        \begin{equation*}
            \abs{L(s,\chi)}\leq k^{-\sigma}\sum_{r=1}^{k-1}\abs{\zeta\left(s,\frac{r}{k}\right)}<k^{m+\delta}kA(\delta)\abs{t}^{m+1+\delta}
        \end{equation*}
        que prueba \eqref{eq:12-33} para $m\geq1$. Si $m=0$ ó $-1$ escribimos
        \begin{equation}\label{eq:12-34}
            L(s,\chi)=\sum_{r=1}^{k-1}\frac{\chi(r)}{r^s}+k^{-s}\sum_{r=1}^{k-1}\chi(r)\left\{\zeta\left(s,\frac{r}{k}\right)-\left(\frac{r}{k}\right)^{-s}\right\}.
        \end{equation}
        Como $-m-\delta\leq\sigma\leq-m+\delta$ podemos utilizar \eqref{eq:12-30} y
        \eqref{eq:12-31} para obtener
        \begin{equation*}
            k^{-\sigma}\abs{\zeta\left(s,\frac{r}{k}\right)-\left(\frac{r}{k}\right)^{-s}}\leq k^{m+\delta}A(\delta)\abs{t}^{m+1+\delta},
        \end{equation*}
        luego la segunda suma de \eqref{eq:12-34} se halla dominada por
        $A(\delta)\abs{kt}^{m+1+\delta}$. La primera suma está dominada por
        \begin{equation*}
            \sum_{r=1}^{k-1}\frac{1}{r^{\sigma}}\leq\sum_{r=1}^{k-1}r^{m+\delta}<1+\int_1^kx^{m+\delta}\,dx=\frac{k^{m+1+\delta}}{m+1+\delta}\leq\frac{k^{m+1+\delta}}{\delta},
        \end{equation*}
        y esta suma queda absorbida en la acotación $A(\delta)\abs{kt}^{m+1+\delta}$.
    \end{proof}

    \section*{Ejercicios del capítulo 12}

    \begin{ejercicio}
        Sea $f(n)$ una función aritmética periódica\index{funcion aritmetica periodica@Función aritmética periódica} módulo $k$.
        \begin{enumerate}
            \item[(a)] Probar que la serie de Dirichlet $\sum f(n)n^{-s}$ converge
            absolutamente para $\sigma>1$ y que
            \begin{equation*}
                \sum_{n=1}^{\infty}\frac{f(n)}{n^s}=k^{-s}\sum_{r=1}^{k}f(r)\zeta\left(s,\frac{r}{k}\right)\qquad\text{si }\sigma>1.
            \end{equation*}
            \item[(b)] Si $\sum_{r=1}^{k}f(r)=0$ probar que la serie de Dirichlet
            $\sum f(n)n^{-s}$ converge para $\sigma>0$ y que existe una función entera $F(s)$
            tal que $F(s)=\sum f(n)n^{-s}$ para $\sigma>0$.
        \end{enumerate}
    \end{ejercicio}

    \begin{ejercicio}
        Si $x$ es real y $\sigma>1$, sea $F(x,s)$ la función zeta periódica\index{funcion zeta periodica@Función zeta periódica}
        \begin{equation*}
            F(x,s)=\sum_{n=1}^{\infty}\frac{e^{2\pi inx}}{n^s}.
        \end{equation*}
        Si $0<a<1$ y $\sigma>1$ probar que la fórmula de Hurwitz implica
        \begin{equation*}
            F(a,s)=\frac{\Gamma(1-s)}{(2\pi)^{1-s}}\left\{e^{\pi i(1-s)/2}\zeta(1-s,a)+e^{\pi i(s-1)/2}\zeta(1-s,1-a)\right\}.
        \end{equation*}
    \end{ejercicio}

    \begin{ejercicio}
        La fórmula del ejercicio 2 se puede utilizar para extender la definición de $F(a,s)$
        sobre el $s$-plano entero si $0<a<1$. Probar que $F(a,s)$, extendida de esta forma, es
        una función entera de $s$.
    \end{ejercicio}

    \begin{ejercicio}
        Si $0<a<1$ y $0<b<1$, sea
        \begin{equation*}
            \Phi(a,b,s)=\frac{\Gamma(s)}{(2\pi)^s}\left\{\zeta(s,a)F(b,1+s)+\zeta(s,1-a)F(1-b,1+s)\right\},
        \end{equation*}
        en donde $F$ es la función del ejercicio 2. Probar que
        \begin{multline*}
            \frac{\Phi(a,b,s)}{\Gamma(s)\Gamma(-s)}=e^{\pi is/2}\left\{\zeta(s,a)\zeta(-s,1-b)+\zeta(s,1-a)\zeta(-s,b)\right\}\\
            +e^{-\pi is/2}\left\{\zeta(-s,1-b)\zeta(s,1-a)+\zeta(-s,b)\zeta(s,a)\right\},
        \end{multline*}
        y deducir que $\Phi(a,b,s)=\Phi(1-b,a,-s)$. Esta ecuación funcional es útil en la teoría
        de las funciones elípticas modulares.
    \end{ejercicio}

    En los ejercicios 5, 6 y 7, $\xi(s)$ designa la función entera introducida en la sección
    12.8,
    \begin{equation*}
        \xi(s)=\frac{1}{2}s(s-1)\pi^{-s/2}\Gamma\left(\frac{s}{2}\right)\zeta(s).
    \end{equation*}

    \begin{ejercicio}
        Probar que $\xi(s)$ es real sobre las rectas $t=0$ y $\sigma=1/2$, y que
        $\xi(0)=\xi(1)=1/2$.
    \end{ejercicio}

    \begin{ejercicio}
        Probar que los ceros de $\xi(s)$ (si existen) se hallan todos ellos situados en la
        banda $0\leq\sigma\leq1$ y su colocación es simétrica respecto de las rectas $t=0$ y
        $\sigma=1/2$.
    \end{ejercicio}

    \begin{ejercicio}
        Probar que los ceros de $\zeta(s)$ en la banda crítica\index{banda critica@Banda crítica} $0<\sigma<1$ (si existen) son
        idénticos en posición y en orden de multiplicidad que los de $\xi(s)$.
    \end{ejercicio}

    \begin{ejercicio}
        Sea $\chi$ un carácter primitivo mód $k$. Definimos
        \begin{equation*}
            a=a(\chi)=
            \begin{cases}
                0&\text{si }\chi(-1)=1,\\
                1&\text{si }\chi(-1)=-1.
            \end{cases}
        \end{equation*}
        \begin{enumerate}
            \item[(a)] Probar que la ecuación funcional de $L(s,\chi)$ tiene la forma
            \begin{equation*}
                L(1-s,\bar{\chi})=\varepsilon(\chi)2(2\pi)^{-s}k^{s-1/2}\cos\left(\frac{\pi(s-a)}{2}\right)\Gamma(s)L(s,\chi),\qquad\text{donde }\abs{\varepsilon(\chi)}=1.
            \end{equation*}
            \item[(b)] Sea
            \begin{equation*}
                \xi(s,\chi)=\left(\frac{k}{\pi}\right)^{(s+a)/2}\Gamma\left(\frac{s+a}{2}\right)L(s,\chi).
            \end{equation*}
            Probar que $\xi(1-s,\bar{\chi})=\varepsilon(\chi)\xi(s,\chi)$.
        \end{enumerate}
    \end{ejercicio}

    \begin{ejercicio}
        Referente al ejercicio 8.
        \begin{enumerate}
            \item[(a)] Probar que $\xi(s,\chi)\neq0$ si $\sigma>1$ o $\sigma<0$.
            \item[(b)] Describir la colocación de los ceros de $L(s,\chi)$ en el semiplano
            $\sigma<0$.
        \end{enumerate}
    \end{ejercicio}

    \begin{ejercicio}
        Sea $\chi$ un carácter no primitivo mód $k$. Describir la colocación de los ceros de
        $L(s,\chi)$ en el semiplano $\sigma<0$.
    \end{ejercicio}

    \begin{ejercicio}
        Probar que los polinomios de Bernoulli\index{bernoulli, polinomios@Bernoulli, polinomios} satisfacen las relaciones
        \begin{equation*}
            B_n(1-x)=(-1)^nB_n(x)\qquad\text{y}\qquad B_{2n+1}\left(\tfrac{1}{2}\right)=0\quad\text{para todo }n\geq0.
        \end{equation*}
    \end{ejercicio}

    \begin{ejercicio}
        $B_n$ designa el $n$-ésimo número de Bernoulli\index{bernoulli, jacques@Bernoulli, Jacques}\index{bernoulli, numeros@Bernoulli, números}. Obsérvese que
        \begin{equation*}
            B_2=\tfrac{1}{6}=1-\tfrac{1}{2}-\tfrac{1}{3},\qquad B_4=-\tfrac{1}{30}=1-\tfrac{1}{2}-\tfrac{1}{3}-\tfrac{1}{5},\qquad B_6=\tfrac{1}{42}=1-\tfrac{1}{2}-\tfrac{1}{3}-\tfrac{1}{7}.
        \end{equation*}
        Estas fórmulas ilustran un teorema descubierto en 1840 por von Staudt\index{staudt, karl georg christian von@Staudt, Karl Georg Christian von} y Clausen\index{clausen, thomas@Clausen, Thomas}
        (independientemente). Si $n\geq1$ tenemos
        \begin{equation*}
            B_{2n}=I_n-\sum_{p-1\mid2n}\frac{1}{p},
        \end{equation*}
        en donde $I_n$ es un entero y la suma se halla extendida a todos los primos $p$ tales
        que $p-1$ divide a $2n$. Este ejercicio esboza una demostración que se debe a Lucas\index{lucas, edouard@Lucas, Edouard}.
        \begin{enumerate}
            \item[(a)] Probar que
            \begin{equation*}
                B_n=\sum_{k=0}^{n}\frac{1}{k+1}\sum_{r=0}^{k}(-1)^r\binom{k}{r}r^n.
            \end{equation*}
            [\textit{Indicación:} Escribir $x=\log\{1+(e^x-1)\}$ y utilizar las series de
            potencias para $x/(e^x-1)$.]
            \item[(b)] Probar que
            \begin{equation*}
                B_n=\sum_{k=0}^{n}\frac{k!}{k+1}\,c(n,k),
            \end{equation*}
            en donde $c(n,k)$ es un entero.
            \item[(c)] Si $a$ y $b$ son enteros con $a\geq2$, $b\geq2$ y $ab>4$, probar que
            $ab\mid(ab-1)!$ Este hecho demuestra que en la suma de la parte (b), cada término
            con $k+1$ compuesto, $k>3$, es un entero.
            \item[(d)] Si $p$ es primo, probar que
            \begin{equation*}
                \sum_{r=0}^{p-1}(-1)^r\binom{p-1}{r}r^n\equiv
                \begin{cases}
                    -1\pmod{p}&\text{si }p-1\mid n,\ n>0,\\
                    0\pmod{p}&\text{si }p-1\nmid n.
                \end{cases}
            \end{equation*}
            \item[(e)] Utilizar los resultados anteriores o algún otro medio para probar el
            teorema de von Staudt\index{staudt, karl georg christian von@Staudt, Karl Georg Christian von}-Clausen\index{clausen, thomas@Clausen, Thomas}.
        \end{enumerate}
    \end{ejercicio}

    \begin{ejercicio}
        Probar que la derivada del polinomio de Bernoulli\index{bernoulli, jacques@Bernoulli, Jacques}\index{bernoulli, polinomios@Bernoulli, polinomios} $B_n(x)$ es $nB_{n-1}(x)$ si
        $n\geq2$.
    \end{ejercicio}

    \begin{ejercicio}
        Probar que los polinomios de Bernoulli\index{bernoulli, polinomios@Bernoulli, polinomios} satisfacen la fórmula aditiva
        \begin{equation*}
            B_n(x+y)=\sum_{k=0}^{n}\binom{n}{k}B_k(x)y^{n-k}.
        \end{equation*}
    \end{ejercicio}

    \begin{ejercicio}
        Probar que los polinomios de Bernoulli\index{bernoulli, jacques@Bernoulli, Jacques}\index{bernoulli, polinomios@Bernoulli, polinomios} satisfacen la fórmula multiplicativa
        \begin{equation*}
            B_p(mx)=m^{p-1}\sum_{k=0}^{m-1}B_p\left(x+\frac{k}{m}\right).
        \end{equation*}
    \end{ejercicio}

    \begin{ejercicio}
        Probar que, si $r\geq1$, los números de Bernoulli\index{bernoulli, numeros@Bernoulli, números} satisfacen la relación
        \begin{equation*}
            \sum_{k=0}^{r}\frac{2^{2k}B_{2k}}{(2k)!\,(2r+1-2k)!}=\frac{1}{(2r)!}.
        \end{equation*}
    \end{ejercicio}

    \begin{ejercicio}
        Calcular la integral $\int_0^1xB_p(x)\,dx$ de dos formas distintas y deducir la
        fórmula
        \begin{equation*}
            \sum_{r=0}^{p}\binom{p}{r}\frac{B_r}{p+2-r}=\frac{B_{p+1}}{p+1}.
        \end{equation*}
    \end{ejercicio}

    \begin{ejercicio}
        \begin{enumerate}
            \item[(a)] Comprobar la identidad
            \begin{equation*}
                \frac{uv\,(e^{u+v}-1)}{(e^u-1)(e^v-1)(u+v)}=\frac{uv}{u+v}\left(1+\frac{1}{e^u-1}+\frac{1}{e^v-1}\right)=1+\sum_{n=2}^{\infty}\frac{uv}{n!}\left(\frac{u^{n-1}+v^{n-1}}{u+v}\right)B_n.
            \end{equation*}
            \item[(b)] Sea $J=\int_0^1B_p(x)B_q(x)\,dx$. Probar que $J$ es el coeficiente de
            $p!\,q!\,u^pv^q$ en el desarrollo de la parte (a). Utilizarlo para deducir que
            \begin{equation*}
                \int_0^1B_p(x)B_q(x)\,dx=
                \begin{cases}
                    (-1)^{p+1}\dfrac{p!\,q!}{(p+q)!}B_{p+q}&\text{si }p\geq1,\ q\geq1,\\[1.5ex]
                    1&\text{si }p=q=0,\\
                    0&\text{si }p\geq1,\ q=0;\text{ o }p=0,\ q\geq1.
                \end{cases}
            \end{equation*}
        \end{enumerate}
    \end{ejercicio}

    \begin{ejercicio}
        \begin{enumerate}
            \item[(a)] Utilizar un método análogo al del ejercicio 18 para obtener la
            identidad
            \begin{equation*}
                (u+v)\sum_{m=0}^{\infty}\sum_{n=0}^{\infty}B_m(x)B_n(x)\frac{u^mv^n}{m!\,n!}=\sum_{m=0}^{\infty}\sum_{n=0}^{\infty}B_{m+n}(x)\frac{u^mv^n}{m!\,n!}\sum_{r=0}^{\infty}\frac{B_{2r}}{(2r)!}\left(u^{2r}v+uv^{2r}\right).
            \end{equation*}
            \item[(b)] Comparar los coeficientes de (a) e integrar el resultado para obtener
            la fórmula
            \begin{equation*}
                B_m(x)B_n(x)=\sum_r\left\{\binom{m}{2r}n+\binom{n}{2r}m\right\}\frac{B_{2r}B_{m+n-2r}(x)}{m+n-2r}+(-1)^{m+1}\frac{m!\,n!}{(m+n)!}B_{m+n}
            \end{equation*}
            para $m\geq1$, $n\geq1$. Indicar el recorrido del índice $r$.
        \end{enumerate}
    \end{ejercicio}

    \begin{ejercicio}
        Probar que, si $m\geq1$, $n\geq1$, y $p\geq1$, tenemos
        \begin{multline*}
            \int_0^1B_m(x)B_n(x)B_p(x)\,dx\\
            =(-1)^{p+1}p!\sum_r\left\{\binom{m}{2r}n+\binom{n}{2r}m\right\}\frac{(m+n-2r-1)!}{(m+n+p-2r)!}\,B_{2r}B_{m+n+p-2r}.
        \end{multline*}
        En particular, calcular $\int_0^1B_2^3(x)\,dx$ a partir de esta fórmula.
    \end{ejercicio}

    \begin{ejercicio}
        Sea $f(n)$ una función aritmética periódica\index{funcion aritmetica periodica@Función aritmética periódica} mód $k$, y sea
        \begin{equation*}
            g(n)=\frac{1}{k}\sum_{m\bmod k}f(m)e^{-2\pi imn/k}
        \end{equation*}
        la sucesión finita de coeficientes de Fourier\index{coeficiente de fourier@Coeficiente de Fourier} de $f$. Si
        \begin{equation*}
            F(s)=k^{-s}\sum_{r=1}^{k}f(r)\zeta\left(s,\frac{r}{k}\right),
        \end{equation*}
        probar que
        \begin{equation*}
            F(1-s)=\frac{\Gamma(s)}{(2\pi)^s}\left\{e^{\pi is/2}\sum_{r=1}^{k}g(r)\zeta\left(s,\frac{r}{k}\right)+e^{-\pi is/2}\sum_{r=1}^{k}g(-r)\zeta\left(s,\frac{r}{k}\right)\right\}.
        \end{equation*}
    \end{ejercicio}

    \begin{ejercicio}
        Sea $\chi$ un carácter no principal mód $k$ y sea $S(x)=\sum_{n\leq x}\chi(n)$.
        \begin{enumerate}
            \item[(a)] Si $N\geq1$ y $\sigma>0$ probar que
            \begin{equation*}
                L(s,\chi)=\sum_{n=1}^{N}\frac{\chi(n)}{n^s}+s\int_N^{\infty}\frac{S(x)-S(N)}{x^{s+1}}\,dx.
            \end{equation*}
            \item[(b)] Si $s=\sigma+it$ con $\sigma\geq\delta>0$ y $\abs{t}\geq0$, utilizar la
            parte (a) para probar que existe una constante $A(\delta)$ tal que
            \begin{equation*}
                \abs{L(s,\chi)}\leq A(\delta)B(k)(\abs{t}+1)^{1-\delta},
            \end{equation*}
            en donde $B(k)$ es una cota superior de $\abs{S(x)}$. En el teorema 13.15 se
            demuestra que $B(k)=O(\sqrt{k}\log k)$.
            \item[(c)] Probar que, para cierta constante $A>0$, tenemos
            \begin{equation*}
                \abs{L(s,\chi)}\leq A\log k\qquad\text{si }\sigma\geq1-\frac{1}{\log k}\text{ y }0\leq\abs{t}\leq2.
            \end{equation*}
            [\textit{Indicación:} Hacer $N=k$ en la parte (a).]
        \end{enumerate}
    \end{ejercicio}

\chapter{Demostración analítica del teorema del número primo}

    \section{EL PLAN DE LA DEMOSTRACIÓN}

    El teorema del número primo es equivalente a la afirmación
    \begin{equation}\label{eq:13-1}
        \psi(x)\sim x\qquad\text{cuando }x\to\infty,
    \end{equation}
    en donde $\psi(x)$ es la función de Chebyshev\index{chebyshev, pafnuti lvovich@Chebyshev, Pafnuti Lvóvich},
    \begin{equation*}
        \psi(x)=\sum_{n\leq x}\Lambda(n).
    \end{equation*}
    Este capítulo proporciona una demostración analítica de \eqref{eq:13-1} basada en las
    propiedades de la función zeta de Riemann. La demostración analítica es más breve que la
    demostración elemental\index{demostracion elemental del teorema del numero primo@Demostración elemental del teorema del número primo} efectuada en el capítulo 4 y sus ideas principales se comprenden
    con mayor facilidad. Esta sección describe los hechos más sobresalientes de la
    demostración.

    La función $\psi$ es una función escalonada y resulta más conveniente tratar con su
    integral que designamos $\psi_1$. Por lo tanto, sea
    \begin{equation*}
        \psi_1(x)=\int_1^x\psi(t)\,dt.
    \end{equation*}
    La integral $\psi_1$ es una función continua lineal a trozos. Ante todo veremos que la
    relación asintótica
    \begin{equation}\label{eq:13-2}
        \psi_1(x)\sim\frac{1}{2}x^2\qquad\text{cuando }x\to\infty
    \end{equation}
    implica \eqref{eq:13-1} y por tanto, para demostrar \eqref{eq:13-1}, basta demostrar \eqref{eq:13-2}. A este fin expresamos
    $\psi_1(x)/x^2$ en términos de la función zeta de Riemann\index{funcion zeta de riemann@Función zeta de Riemann} mediante la integral de
    contorno,
    \begin{equation*}
        \frac{\psi_1(x)}{x^2}=\frac{1}{2\pi i}\int_{c-\infty i}^{c+\infty i}\frac{x^{s-1}}{s(s+1)}\left(-\frac{\zeta'(s)}{\zeta(s)}\right)ds,\qquad\text{en donde }c>1.
    \end{equation*}
    El cociente $-\zeta'(s)/\zeta(s)$ posee un polo de primer orden en $s=1$ con residuo 1. Si
    quitamos este polo obtenemos la fórmula
    \begin{equation*}
        \frac{\psi_1(x)}{x^2}-\frac{1}{2}\left(1-\frac{1}{x}\right)^2=\frac{1}{2\pi i}\int_{c-\infty i}^{c+\infty i}\frac{x^{s-1}}{s(s+1)}\left(-\frac{\zeta'(s)}{\zeta(s)}-\frac{1}{s-1}\right)ds,\qquad\text{para }c>1.
    \end{equation*}
    Sea
    \begin{equation*}
        h(s)=\frac{1}{s(s+1)}\left(-\frac{\zeta'(s)}{\zeta(s)}-\frac{1}{s-1}\right)
    \end{equation*}
    y escribamos de nuevo la última ecuación en la forma
    \begin{align}
        \frac{\psi_1(x)}{x^2}-\frac{1}{2}\left(1-\frac{1}{x}\right)^2&=\frac{1}{2\pi i}\int_{c-\infty i}^{c+\infty i}x^{s-1}h(s)\,ds\notag\\
        &=\frac{x^{c-1}}{2\pi}\int_{-\infty}^{+\infty}h(c+it)e^{it\log x}\,dt.\label{eq:13-3}
    \end{align}
    Para completar la demostración debemos probar que
    \begin{equation}\label{eq:13-4}
        \lim_{x\to\infty}\frac{x^{c-1}}{2\pi}\int_{-\infty}^{+\infty}h(c+it)e^{it\log x}\,dt=0.
    \end{equation}
    Entonces el lema de Riemann\index{riemann, georg friedrich bernhard@Riemann, Georg Friedrich Bernhard}-Lebesgue de la teoría de las series de Fourier establece que
    \begin{equation*}
        \lim_{x\to\infty}\int_{-\infty}^{+\infty}f(t)e^{itx}\,dt=0
    \end{equation*}
    si la integral $\int_{-\infty}^{+\infty}\abs{f(t)}\,dt$ converge. La integral en
    \eqref{eq:13-4} es de este tipo con $\log x$ reemplazando a $x$, y es fácil demostrar que
    la integral $\int_{-\infty}^{+\infty}\abs{h(c+it)}\,dt$ converge si $c>1$, por lo que la
    integral de \eqref{eq:13-4} tiende a 0 cuando $x\to\infty$. Sin embargo, el factor
    $x^{c-1}$, que se halla fuera de la integral, tiende a $\infty$ cuando $x\to\infty$ si $c>1$,
    por lo que nos enfrentamos con una indeterminación del tipo $\infty\cdot0$. La ecuación
    \eqref{eq:13-3} se verifica para todo $c>1$. Si hacemos $c=1$ en \eqref{eq:13-3} el
    factor inoportuno $x^{c-1}$ desaparece. Pero entonces $h(c+it)$ se transforma en
    $h(1+it)$ y el integrando contiene a $\zeta'(s)/\zeta(s)$ sobre la recta $\sigma=1$. En
    este caso resulta más difícil demostrar que la integral
    $\int_{-\infty}^{+\infty}\abs{h(1+it)}\,dt$ converge, y este hecho debe ser demostrado
    antes de poder aplicar el lema de Riemann-Lebesgue. La última y más difícil parte de la
    demostración consiste en demostrar que \textit{es} posible substituir $c$ por 1 en
    \eqref{eq:13-3} y que la integral $\int_{-\infty}^{+\infty}\abs{h(1+it)}\,dt$ converge.
    Requiere un estudio más detallado de la función zeta de Riemann en las proximidades de la
    recta $\sigma=1$.

    Ahora procederemos a llevar a término el plan ahora esbozado. Empezaremos con unos lemas.

    \section{LEMAS}

    \begin{lema}\label{lem:13-1}
        Para toda función aritmética $a(n)$, sea
        \begin{equation*}
            A(x)=\sum_{n\leq x}a(n),
        \end{equation*}
        en donde $A(x)=0$ si $x<1$. Entonces
        \begin{equation}\label{eq:13-5}
            \sum_{n\leq x}(x-n)a(n)=\int_1^xA(t)\,dt.
        \end{equation}
    \end{lema}

    \begin{proof}
        Aplicamos la identidad de Abel\index{abel, identidad de@Abel, identidad de}\index{abel, niels henrik@Abel, Niels Henrik} (teorema 4.2) que establece que
        \begin{equation}\label{eq:13-6}
            \sum_{n\leq x}a(n)f(n)=A(x)f(x)-\int_1^xA(t)f'(t)\,dt
        \end{equation}
        si $f$ posee derivada continua en $[1,x]$. Hacemos $f(t)=t$ y obtenemos
        \begin{equation*}
            \sum_{n\leq x}a(n)f(n)=\sum_{n\leq x}na(n)\qquad\text{y}\qquad A(x)f(x)=x\sum_{n\leq x}a(n),
        \end{equation*}
        por lo que \eqref{eq:13-6} se reduce a \eqref{eq:13-5}.
    \end{proof}

    El lema que sigue constituye una forma de la regla de l'Hôpital para funciones crecientes
    lineales a trozos.

    \begin{lema}\label{lem:13-2}
        Sea $A(x)=\sum_{n\leq x}a(n)$ y sea $A_1(x)=\int_1^xA(t)\,dt$. Además suponemos que
        $a(n)\geq0$ para todo $n$. Si tenemos la fórmula asintótica
        \begin{equation}\label{eq:13-7}
            A_1(x)\sim Lx^c\qquad\text{cuando }x\to\infty
        \end{equation}
        para un $c>0$ y un $L>0$, entonces también tenemos
        \begin{equation}\label{eq:13-8}
            A(x)\sim cLx^{c-1}\qquad\text{cuando }x\to\infty.
        \end{equation}
    \end{lema}

    Con otras palabras, la diferenciación formal de \eqref{eq:13-7} nos proporciona un
    resultado correcto.

    \begin{proof}
        La función $A(x)$ es creciente puesto que los $a(n)$ son no negativos. Elegimos un
        $\beta>1$ y consideramos la diferencia $A_1(\beta x)-A_1(x)$. Tenemos
        \begin{align*}
            A_1(\beta x)-A_1(x)&=\int_x^{\beta x}A(u)\,du\geq\int_x^{\beta x}A(x)\,du=A(x)(\beta x-x)\\
            &=x(\beta-1)A(x).
        \end{align*}
        Esto nos da
        \begin{equation*}
            xA(x)\leq\frac{1}{\beta-1}\left\{A_1(\beta x)-A_1(x)\right\}
        \end{equation*}
        luego
        \begin{equation*}
            \frac{A(x)}{x^{c-1}}\leq\frac{1}{\beta-1}\left\{\frac{A_1(\beta x)}{(\beta x)^c}\beta^c-\frac{A_1(x)}{x^c}\right\}.
        \end{equation*}
        Fijamos $\beta$ y hacemos que $x\to\infty$ en la desigualdad anterior. Obtenemos
        \begin{equation*}
            \limsup_{x\to\infty}\frac{A(x)}{x^{c-1}}\leq\frac{1}{\beta-1}(L\beta^c-L)=L\,\frac{\beta^c-1}{\beta-1}.
        \end{equation*}
        Ahora hacemos que $\beta\to1+$. El cociente de la derecha es el cociente incremental
        relativo a la derivada de $x^c$ en $x=1$ y tiene límite $c$. Por consiguiente
        \begin{equation}\label{eq:13-9}
            \limsup_{x\to\infty}\frac{A(x)}{x^{c-1}}\leq cL.
        \end{equation}
        Ahora consideramos un $\alpha$ con $0<\alpha<1$ y consideramos la diferencia
        $A_1(x)-A_1(\alpha x)$. Un razonamiento análogo al anterior demuestra que
        \begin{equation*}
            \liminf_{x\to\infty}\frac{A(x)}{x^{c-1}}\geq L\,\frac{1-\alpha^c}{1-\alpha}.
        \end{equation*}
        Cuando $\alpha\to1-$ el segundo miembro tiende a $cL$. Esto, junto con
        \eqref{eq:13-9}, prueba que $A(x)/x^{c-1}$ tiende al límite $cL$ cuando
        $x\to\infty$.
    \end{proof}

    Cuando $a(n)=\Lambda(n)$ tenemos $A(x)=\psi(x)$, $A_1(x)=\psi_1(x)$, y $a(n)\geq0$. Por
    consiguiente podemos aplicar los lemas \ref{lem:13-1} y \ref{lem:13-2} y obtenemos
    inmediatamente:

    \begin{teorema}\label{teo:13-1}
        Tenemos
        \begin{equation}\label{eq:13-10}
            \psi_1(x)=\sum_{n\leq x}(x-n)\Lambda(n).
        \end{equation}
        Además, la relación asintótica $\psi_1(x)\sim x^2/2$ implica $\psi(x)\sim x$ cuando
        $x\to\infty$.
    \end{teorema}

    Nuestra próxima labor consiste en expresar $\psi_1(x)/x^2$ como una integral de contorno
    que involucre a la función zeta. Para ello precisamos de los casos especiales $k=1$ y
    $k=2$ del siguiente lema sobre integrales de contorno. (Compárese con el lema 4 del
    capítulo 11.)

    \begin{lema}\label{lem:13-3}
        Si $c>0$ y $u>0$, entonces para cada entero $k\geq1$ tenemos
        \begin{equation*}
            \frac{1}{2\pi i}\int_{c-\infty i}^{c+\infty i}\frac{u^{-z}}{z(z+1)\cdots(z+k)}\,dz=
            \begin{cases}
                \dfrac{1}{k!}(1-u)^k&\text{si }0<u\leq1,\\[1.5ex]
                0&\text{si }u>1,
            \end{cases}
        \end{equation*}
        y la integral es absolutamente convergente.
    \end{lema}

    \begin{proof}
        En primer lugar observamos que el integrando es igual a
        $u^{-z}\Gamma(z)/\Gamma(z+k+1)$. Este resultado se obtiene utilizando repetidamente la
        ecuación funcional\index{ecuacion funcional@Ecuación funcional} $\Gamma(z+1)=z\Gamma(z)$. Para probar el lema aplicamos el teorema
        del residuo de Cauchy a la integral
        \begin{equation*}
            \frac{1}{2\pi i}\int_{C(R)}\frac{u^{-z}\Gamma(z)}{\Gamma(z+k+1)}\,dz,
        \end{equation*}
        en donde $C(R)$ es el contorno dibujado en la figura 13.1(a) si $0<u\leq1$, y el de la
        figura 13.1(b) si $u>1$. El radio $R$ del círculo es mayor que $2k+c$ por lo que todos
        los polos en $z=0,-1,\dots,-k$ se hallan en el interior del círculo.

        \begin{figure}[H]
            \centering
            \includegraphics{figuras/figura13-1.pdf}
            \caption{}
        \end{figure}

        Ahora vemos que el integrando a lo largo de cada uno de los arcos circulares tiende a 0
        cuando $R\to\infty$. Si $z=x+iy$ y $\abs{z}=R$, el integrando se halla dominado por
        \begin{equation*}
            \abs{\frac{u^{-z}}{z(z+1)\cdots(z+k)}}=\frac{u^{-x}}{\abs{z}\abs{z+1}\cdots\abs{z+k}}\leq\frac{u^{-c}}{R\abs{z+1}\cdots\abs{z+k}}.
        \end{equation*}
        La desigualdad $u^{-x}\leq u^{-c}$ se sigue del hecho de que $u^{-x}$ es una función
        creciente de $x$ si $0<u\leq1$ y decreciente si $u>1$. Ahora, si $1\leq n\leq k$,
        tenemos
        \begin{equation*}
            \abs{z+n}\geq\abs{z}-n=R-n\geq R-k\geq R/2
        \end{equation*}
        puesto que $R>2k$. Por consiguiente la integral a lo largo de cada arco circular se
        halla acotada por
        \begin{equation*}
            \frac{2\pi Ru^{-c}}{R(\tfrac{1}{2}R)^k}=O(R^{-k})
        \end{equation*}
        y ésta $\to0$ cuando $R\to\infty$ ya que $k\geq1$.

        Si $u>1$, el integrando es analítico en el interior de $C(R)$, luego
        $\int_{C(R)}=0$. Si ahora $R\to\infty$ el lema queda establecido en este caso.

        Si $0<u\leq1$, calculamos la integral a lo largo de $C(R)$ por el teorema del residuo
        de Cauchy\index{cauchy, augustin-louis@Cauchy, Augustin-Louis}. El integrando posee polos en los puntos enteros $n=0,-1,\dots,-k$, luego
        \begin{align*}
            \frac{1}{2\pi i}\int_{C(R)}\frac{u^{-z}\Gamma(z)}{\Gamma(z+k+1)}\,dz&=\sum_{n=0}^{k}\operatorname*{Res}_{z=-n}\frac{u^{-z}\Gamma(z)}{\Gamma(z+k+1)}\\
            &=\sum_{n=0}^{k}\frac{u^n}{\Gamma(k+1-n)}\operatorname*{Res}_{z=-n}\Gamma(z)=\sum_{n=0}^{k}\frac{u^n(-1)^n}{(k-n)!\,n!}\\
            &=\frac{1}{k!}\sum_{n=0}^{k}\binom{k}{n}(-u)^n=\frac{(1-u)^k}{k!}.
        \end{align*}
        Si $R\to\infty$ obtenemos el lema.
    \end{proof}

    \section[UNA REPRESENTACIÓN DE $\psi_1(x)/x^2$ COMO INTEGRAL DE CONTORNO]{UNA REPRESENTACIÓN DE \texorpdfstring{$\psi_1(x)/x^2$}{ψ₁(x)/x²} COMO INTEGRAL DE CONTORNO}

    \begin{teorema}\label{teo:13-2}
        Si $c>1$ y $x\geq1$ tenemos
        \begin{equation}\label{eq:13-11}
            \frac{\psi_1(x)}{x^2}=\frac{1}{2\pi i}\int_{c-\infty i}^{c+\infty i}\frac{x^{s-1}}{s(s+1)}\left(-\frac{\zeta'(s)}{\zeta(s)}\right)ds.
        \end{equation}
    \end{teorema}

    \begin{proof}
        De la ecuación \eqref{eq:13-10} tenemos $\psi_1(x)/x=\sum_{n\leq x}(1-n/x)\Lambda(n)$.
        Ahora usamos el lema \ref{lem:13-3} con $k=1$ y $u=n/x$. Si $n\leq x$ obtenemos
        \begin{equation*}
            1-\frac{n}{x}=\frac{1}{2\pi i}\int_{c-\infty i}^{c+\infty i}\frac{(x/n)^s}{s(s+1)}\,ds.
        \end{equation*}
        Multiplicamos esta relación por $\Lambda(n)$ y sumamos para todos los $n\leq x$ y
        obtenemos
        \begin{equation*}
            \frac{\psi_1(x)}{x}=\sum_{n\leq x}\frac{1}{2\pi i}\int_{c-\infty i}^{c+\infty i}\frac{\Lambda(n)(x/n)^s}{s(s+1)}\,ds=\sum_{n=1}^{\infty}\frac{1}{2\pi i}\int_{c-\infty i}^{c+\infty i}\frac{\Lambda(n)(x/n)^s}{s(s+1)}\,ds
        \end{equation*}
        ya que la integral se anula si $n>x$. Podemos escribirla
        \begin{equation}\label{eq:13-12}
            \frac{\psi_1(x)}{x}=\sum_{n=1}^{\infty}\int_{c-\infty i}^{c+\infty i}f_n(s)\,ds,
        \end{equation}
        en donde $2\pi if_n(s)=\Lambda(n)(x/n)^s/(s^2+s)$. Ahora, en \eqref{eq:13-12}, queremos
        intercambiar la suma y la integral. Para ello es suficiente probar que la serie
        \begin{equation}\label{eq:13-13}
            \sum_{n=1}^{\infty}\int_{c-\infty i}^{c+\infty i}\abs{f_n(s)}\,ds
        \end{equation}
        es convergente. (Ver teorema 10.26 de \cite{apostol1976}.) Las sumas parciales de esta
        serie satisfacen la desigualdad
        \begin{equation*}
            \sum_{n=1}^{N}\int_{c-\infty i}^{c+\infty i}\frac{\Lambda(n)(x/n)^c}{\abs{s}\abs{s+1}}\,ds=\sum_{n=1}^{N}\frac{\Lambda(n)}{n^c}\int_{c-\infty i}^{c+\infty i}\frac{x^c}{\abs{s}\abs{s+1}}\,ds\leq A\sum_{n=1}^{\infty}\frac{\Lambda(n)}{n^c},
        \end{equation*}
        en donde $A$ es constante, luego \eqref{eq:13-13} converge. Por tanto podemos
        intercambiar la suma y la integral en \eqref{eq:13-12} y obtenemos
        \begin{align*}
            \frac{\psi_1(x)}{x}&=\int_{c-\infty i}^{c+\infty i}\sum_{n=1}^{\infty}f_n(s)\,ds=\frac{1}{2\pi i}\int_{c-\infty i}^{c+\infty i}\frac{x^s}{s(s+1)}\sum_{n=1}^{\infty}\frac{\Lambda(n)}{n^s}\,ds\\
            &=\frac{1}{2\pi i}\int_{c-\infty i}^{c+\infty i}\frac{x^s}{s(s+1)}\left(-\frac{\zeta'(s)}{\zeta(s)}\right)ds.
        \end{align*}
        Ahora, para obtener \eqref{eq:13-11}, basta dividir por $x$.
    \end{proof}

    \begin{teorema}\label{teo:13-3}
        Si $c>1$ y $x\geq1$ tenemos
        \begin{equation}\label{eq:13-14}
            \frac{\psi_1(x)}{x^2}-\frac{1}{2}\left(1-\frac{1}{x}\right)^2=\frac{1}{2\pi i}\int_{c-\infty i}^{c+\infty i}x^{s-1}h(s)\,ds,
        \end{equation}
        en donde
        \begin{equation}\label{eq:13-15}
            h(s)=\frac{1}{s(s+1)}\left(-\frac{\zeta'(s)}{\zeta(s)}-\frac{1}{s-1}\right).
        \end{equation}
    \end{teorema}

    \begin{proof}
        Esta vez utilizaremos el lema \ref{lem:13-3} con $k=2$ para obtener
        \begin{equation*}
            \frac{1}{2}\left(1-\frac{1}{x}\right)^2=\frac{1}{2\pi i}\int_{c-\infty i}^{c+\infty i}\frac{x^s}{s(s+1)(s+2)}\,ds,
        \end{equation*}
        en donde $c>0$. Substituimos $s$ por $s-1$ en la integral (haciendo $c>1$) y restamos
        este resultado de \eqref{eq:13-11} para obtener el teorema \ref{teo:13-3}.
    \end{proof}

    Si parametrizamos el arco de integración haciendo $s=c+it$, obtenemos
    $x^{s-1}=x^{c-1}x^{it}=x^{c-1}e^{it\log x}$ y la ecuación \eqref{eq:13-14} se transforma
    en
    \begin{equation}\label{eq:13-16}
        \frac{\psi_1(x)}{x^2}-\frac{1}{2}\left(1-\frac{1}{x}\right)^2=\frac{x^{c-1}}{2\pi}\int_{-\infty}^{+\infty}h(c+it)e^{it\log x}\,dt.
    \end{equation}

    Nuestra próxima labor consiste en demostrar que el segundo miembro de
    \eqref{eq:13-16} tiende a 0 cuando $x\to\infty$. Como ya hemos indicado anteriormente,
    primero probaremos que podemos hacer $c=1$ en \eqref{eq:13-16}. A este fin necesitamos
    estudiar $\zeta(s)$ en las proximidades de la recta $\sigma=1$.

    \section[COTAS SUPERIORES PARA $\abs{\zeta(s)}$ Y PARA $\abs{\zeta'(s)}$ EN LAS PROXIMIDADES DE LA RECTA $\sigma=1$]{COTAS SUPERIORES PARA \texorpdfstring{$\abs{\zeta(s)}$}{|ζ(s)|} Y PARA \texorpdfstring{$\abs{\zeta'(s)}$}{|ζ'(s)|} EN LAS PROXIMIDADES DE LA RECTA \texorpdfstring{$\sigma=1$}{σ=1}}

    Para estudiar $\zeta(s)$ en las proximidades de la recta $\sigma=1$ utilizamos la
    representación que se obtiene por el teorema 12.21 y que es válida para $\sigma>0$,
    \begin{equation}\label{eq:13-17}
        \zeta(s)=\sum_{n=1}^{N}\frac{1}{n^s}-s\int_N^{\infty}\frac{x-[x]}{x^{s+1}}\,dx+\frac{N^{1-s}}{s-1}.
    \end{equation}
    Utilizamos además la fórmula correspondiente a $\zeta'(s)$ que se obtiene derivando cada
    uno de los miembros de \eqref{eq:13-17},
    \begin{multline}\label{eq:13-18}
        \zeta'(s)=-\sum_{n=1}^{N}\frac{\log n}{n^s}+s\int_N^{\infty}\frac{(x-[x])\log x}{x^{s+1}}\,dx-\int_N^{\infty}\frac{x-[x]}{x^{s+1}}\,dx\\
        -\frac{N^{1-s}\log N}{s-1}-\frac{N^{1-s}}{(s-1)^2}.
    \end{multline}
    El teorema que sigue utiliza estas relaciones para obtener cotas superiores de
    $\abs{\zeta(s)}$ y de $\abs{\zeta'(s)}$.

    \begin{teorema}\label{teo:13-4}
        Para cada $A>0$, existe una constante $M$ (que depende de $A$) tal que
        \begin{equation}\label{eq:13-19}
            \abs{\zeta(s)}\leq M\log t\qquad\text{y}\qquad\abs{\zeta'(s)}\leq M\log^2t
        \end{equation}
        para todo $s$ con $\sigma\geq1/2$ que además verifica
        \begin{equation}\label{eq:13-20}
            \sigma>1-\frac{A}{\log t}\qquad\text{y}\qquad t\geq e.
        \end{equation}
    \end{teorema}

    Nota. Las desigualdades de \eqref{eq:13-20} describen una región del tipo representado en
    la figura 13.2.

    \begin{figure}[H]
        \centering
        \includegraphics{figuras/figura13-2.pdf}
        \caption{}
    \end{figure}

    \begin{proof}
        Si $\sigma\geq2$, tenemos $\abs{\zeta(s)}\leq\zeta(2)$, $\abs{\zeta'(s)}\leq\abs{\zeta'(2)}$
        y las desigualdades de \eqref{eq:13-19} se verifican trivialmente. Por consiguiente
        podemos suponer que $\sigma<2$ y $t\geq e$. Entonces tenemos
        \begin{equation*}
            \abs{s}\leq\sigma+t\leq2+t<2t\qquad\text{y}\qquad\abs{s-1}\geq t
        \end{equation*}
        luego $1/\abs{s-1}\leq1/t$. Si acotamos $\abs{\zeta(s)}$ utilizando \eqref{eq:13-17}
        obtenemos
        \begin{equation*}
            \abs{\zeta(s)}\leq\sum_{n=1}^{N}\frac{1}{n^{\sigma}}+2t\int_N^{\infty}\frac{1}{x^{\sigma+1}}\,dx+\frac{N^{1-\sigma}}{t}=\sum_{n=1}^{N}\frac{1}{n^{\sigma}}+\frac{2t}{\sigma N^{\sigma}}+\frac{N^{1-\sigma}}{t}.
        \end{equation*}
        Ahora hacemos que $N$ dependa de $t$ tomando $N=[t]$. Entonces $N\leq t<N+1$ y
        $\log n\leq\log t$ si $n<N$. La desigualdad de \eqref{eq:13-20} implica
        $1-\sigma<A/\log t$ por lo tanto
        \begin{equation*}
            \frac{1}{n^{\sigma}}=\frac{n^{1-\sigma}}{n}=\frac{1}{n}e^{(1-\sigma)\log n}<\frac{1}{n}e^{A\log n/\log t}\leq\frac{1}{n}e^A=O\left(\frac{1}{n}\right).
        \end{equation*}
        Por consiguiente
        \begin{equation*}
            \frac{2t}{\sigma N^{\sigma}}\leq\frac{N+1}{N}=O(1)\qquad\text{y}\qquad\frac{N^{1-\sigma}}{t}=\frac{N}{t}\,\frac{1}{N^{\sigma}}=O\left(\frac{1}{N}\right)=O(1),
        \end{equation*}
        luego
        \begin{equation*}
            \abs{\zeta(s)}=O\left(\sum_{n=1}^{N}\frac{1}{n}\right)+O(1)=O(\log N)+O(1)=O(\log t).
        \end{equation*}
        Esto demuestra la desigualdad relativa a $\abs{\zeta(s)}$ dada en \eqref{eq:13-19}. Para
        obtener la desigualdad relativa a $\abs{\zeta'(s)}$ aplicamos el mismo tipo de
        razonamiento a \eqref{eq:13-18}. La única diferencia esencial es que en el miembro de
        la derecha aparece el factor extra $\log N$. Pero $\log N=O(\log t)$ por lo que en la
        región especificada tenemos $\abs{\zeta'(s)}=O(\log^2t)$.
    \end{proof}

    \section{LA NO ANULACIÓN DE \texorpdfstring{$\zeta(s)$}{ζ(s)} EN LA RECTA \texorpdfstring{$\sigma=1$}{σ=1}}

    En esta sección vemos que $\zeta(1+it)\neq0$ para cada $t$ real. La demostración se basa
    en una desigualdad que también necesitaremos en la sección siguiente.

    \begin{teorema}\label{teo:13-5}
        Si $\sigma>1$ tenemos
        \begin{equation}\label{eq:13-21}
            \zeta^3(\sigma)\abs{\zeta(\sigma+it)}^4\abs{\zeta(\sigma+2it)}\geq1.
        \end{equation}
    \end{teorema}

    \begin{proof}
        Recordamos la identidad $\zeta(s)=e^{G(s)}$ demostrada en la sección 11.9, ejemplo 1,
        en donde
        \begin{equation*}
            G(s)=\sum_{n=2}^{\infty}\frac{\Lambda(n)}{\log n}n^{-s}=\sum_p\sum_{m=1}^{\infty}\frac{1}{mp^{ms}}\qquad(\sigma>1)
        \end{equation*}
        se puede escribir
        \begin{equation*}
            \zeta(s)=\exp\left\{\sum_p\sum_{m=1}^{\infty}\frac{1}{mp^{ms}}\right\}=\exp\left\{\sum_p\sum_{m=1}^{\infty}\frac{e^{-imt\log p}}{mp^{m\sigma}}\right\},
        \end{equation*}
        de donde obtenemos
        \begin{equation*}
            \abs{\zeta(s)}=\exp\left\{\sum_p\sum_{m=1}^{\infty}\frac{\cos(mt\log p)}{mp^{m\sigma}}\right\}.
        \end{equation*}
        Aplicamos esta fórmula repetidamente con $s=\sigma$, $s=\sigma+it$ y $s=\sigma+2it$, y se
        obtiene
        \begin{multline*}
            \zeta^3(\sigma)\abs{\zeta(\sigma+it)}^4\abs{\zeta(\sigma+2it)}\\
            =\exp\left\{\sum_p\sum_{m=1}^{\infty}\frac{3+4\cos(mt\log p)+\cos(2mt\log p)}{mp^{m\sigma}}\right\}.
        \end{multline*}
        Ahora bien, disponemos de la desigualdad trigonométrica
        \begin{equation*}
            3+4\cos\theta+\cos2\theta\geq0
        \end{equation*}
        que se obtiene a partir de la identidad
        \begin{equation*}
            3+4\cos\theta+\cos2\theta=3+4\cos\theta+2\cos^2\theta-1=2(1+\cos\theta)^2.
        \end{equation*}
        Por consiguiente cada término de la última serie infinita es no negativo y obtenemos
        \eqref{eq:13-21}.
    \end{proof}

    \begin{teorema}\label{teo:13-6}
        Tenemos $\zeta(1+it)\neq0$ para cada $t$ real.
    \end{teorema}

    \begin{proof}
        Únicamente debemos considerar $t\neq0$. Se puede escribir \eqref{eq:13-21} en la forma
        \begin{equation}\label{eq:13-22}
            \left\{(\sigma-1)\zeta(\sigma)\right\}^3\abs{\frac{\zeta(\sigma+it)}{\sigma-1}}^4\abs{\zeta(\sigma+2it)}\geq\frac{1}{\sigma-1}.
        \end{equation}
        Esto es válido si $\sigma>1$. Ahora hacemos que $\sigma\to1+$ en \eqref{eq:13-22}. El
        primer factor tiende a 1 puesto que $\zeta(s)$ tiene residuo 1 en el polo $s=1$. El
        tercer factor tiende a $\abs{\zeta(1+2it)}$. Si $\zeta(1+it)$ fuese cero, el segundo
        factor podríamos escribirlo
        \begin{equation*}
            \abs{\frac{\zeta(\sigma+it)-\zeta(1+it)}{\sigma-1}}^4\to\abs{\zeta'(1+it)}^4\qquad\text{cuando }\sigma\to1+.
        \end{equation*}
        Por consiguiente, si para algún $t\neq0$ tuviésemos $\zeta(1+it)=0$, el primer miembro
        de \eqref{eq:13-22} se aproximaría al límite $\abs{\zeta'(1+it)}^4\abs{\zeta(1+2it)}$
        cuando $\sigma\to1+$. Pero el segundo miembro tiende a $\infty$ cuando $\sigma\to1+$ y
        ello no es posible.
    \end{proof}

    \section[DESIGUALDADES PARA $\abs{1/\zeta(s)}$ Y $\abs{\zeta'(s)/\zeta(s)}$]{DESIGUALDADES PARA \texorpdfstring{$\abs{1/\zeta(s)}$}{|1/ζ(s)|} Y \texorpdfstring{$\abs{\zeta'(s)/\zeta(s)}$}{|ζ'(s)/ζ(s)|}}

    Aplicamos ahora una vez más el teorema \ref{teo:13-5} y obtenemos las siguientes
    desigualdades para $\abs{1/\zeta(s)}$ y $\abs{\zeta'(s)/\zeta(s)}$.

    \begin{teorema}\label{teo:13-7}
        Existe una constante $M>0$ tal que
        \begin{equation*}
            \abs{\frac{1}{\zeta(s)}}<M\log^7t\qquad\text{y}\qquad\abs{\frac{\zeta'(s)}{\zeta(s)}}<M\log^9t
        \end{equation*}
        si $\sigma\geq1$ y $t\geq e$.
    \end{teorema}

    \begin{proof}
        Para $\sigma\geq2$ tenemos
        \begin{equation*}
            \abs{\frac{1}{\zeta(s)}}=\abs{\sum_{n=1}^{\infty}\frac{\mu(n)}{n^s}}\leq\sum_{n=1}^{\infty}\frac{1}{n^2}\leq\zeta(2)
        \end{equation*}
        y
        \begin{equation*}
            \abs{\frac{\zeta'(s)}{\zeta(s)}}\leq\sum_{n=1}^{\infty}\frac{\Lambda(n)}{n^2},
        \end{equation*}
        luego las desigualdades se verifican trivialmente si $\sigma\geq2$. Suponemos, entonces,
        que $1\leq\sigma<2$ y que $t\geq e$. Escribimos de nuevo las desigualdades de
        \eqref{eq:13-21} como sigue:
        \begin{equation*}
            \frac{1}{\abs{\zeta(\sigma+it)}}\leq\zeta(\sigma)^{3/4}\abs{\zeta(\sigma+2it)}^{1/4}.
        \end{equation*}
        Ahora, como $(\sigma-1)\zeta(\sigma)$ está acotado en el intervalo $1\leq\sigma<2$, o
        sea que $(\sigma-1)\zeta(\sigma)\leq M$, en donde $M$ es una constante, tenemos
        \begin{equation*}
            \zeta(\sigma)\leq\frac{M}{\sigma-1}\qquad\text{si }1<\sigma\leq2.
        \end{equation*}
        Además, $\zeta(\sigma+2it)=O(\log t)$ si $1\leq\sigma\leq2$ (por el teorema
        \ref{teo:13-4}), luego para $1<\sigma\leq2$ tenemos
        \begin{equation*}
            \frac{1}{\abs{\zeta(\sigma+it)}}\leq\frac{M^{3/4}(\log t)^{1/4}}{(\sigma-1)^{3/4}}=\frac{A(\log t)^{1/4}}{(\sigma-1)^{3/4}},
        \end{equation*}
        en donde $A$ es una constante absoluta. Por consiguiente, para una constante $B>0$,
        tenemos
        \begin{equation}\label{eq:13-23}
            \abs{\zeta(\sigma+it)}>\frac{B(\sigma-1)^{3/4}}{(\log t)^{1/4}},\qquad\text{si }1<\sigma\leq2,\text{ y }t\geq e.
        \end{equation}
        Esto también se verifica trivialmente para $\sigma=1$. Sea $\alpha$ un número cualquiera
        que verifique $1<\alpha<2$. Entonces, si $1\leq\sigma\leq\alpha$, $t\geq e$, podemos
        utilizar el teorema \ref{teo:13-4} para escribir
        \begin{align*}
            \abs{\zeta(\sigma+it)-\zeta(\alpha+it)}&\leq\int_{\sigma}^{\alpha}\abs{\zeta'(u+it)}\,du\leq(\alpha-\sigma)M\log^2t\\
            &\leq(\alpha-1)M\log^2t.
        \end{align*}
        Luego, por la desigualdad triangular,
        \begin{align*}
            \abs{\zeta(\sigma+it)}&\geq\abs{\zeta(\alpha+it)}-\abs{\zeta(\sigma+it)-\zeta(\alpha+it)}\\
            &\geq\abs{\zeta(\alpha+it)}-(\alpha-1)M\log^2t\geq\frac{B(\alpha-1)^{3/4}}{(\log t)^{1/4}}-(\alpha-1)M\log^2t.
        \end{align*}
        Este resultado se verifica, si $1<\sigma<\alpha$, y por \eqref{eq:13-23} también se
        verifica para $\alpha\leq\sigma\leq2$ puesto que $(\sigma-1)^{3/4}\geq(\alpha-1)^{3/4}$.
        Con otras palabras, si $1\leq\sigma\leq2$ y $t\geq e$ tenemos la desigualdad
        \begin{equation*}
            \abs{\zeta(\sigma+it)}\geq\frac{B(\alpha-1)^{3/4}}{(\log t)^{1/4}}-(\alpha-1)M\log^2t
        \end{equation*}
        para todo $\alpha$ que satisfaga $1<\alpha<2$. Ahora $\alpha$ lo hacemos depender de $t$
        eligiendo $\alpha$ de forma que el primer término de la derecha sea igual a dos veces el
        segundo. Esto requiere que
        \begin{equation*}
            \alpha=1+\left(\frac{B}{2M}\right)^4\frac{1}{(\log t)^9}.
        \end{equation*}
        Es obvio que $\alpha>1$ y también que $\alpha<2$ si $t\geq t_0$ para cierto $t_0$. Así
        pues, si $t>t_0$ y $1\leq\sigma<2$ tenemos
        \begin{equation*}
            \abs{\zeta(\sigma+it)}\geq(\alpha-1)M\log^2t=\frac{C}{(\log t)^7}.
        \end{equation*}
        Esta desigualdad se verifica asimismo con (quizás) una $C$ diferente si $e\leq t\leq t_0$.
        Todo ello demuestra que $\abs{\zeta(s)}\geq C\log^{-7}t$ para todo $\sigma\geq1$,
        $t\geq e$, y, lo que nos proporciona es una cota superior de $\abs{1/\zeta(s)}$. A fin de
        obtener la desigualdad relativa a $\abs{\zeta'(s)/\zeta(s)}$ aplicamos el teorema
        \ref{teo:13-4} y obtenemos un factor extra $\log^2t$.
    \end{proof}

    \section{TERMINACIÓN DE LA DEMOSTRACIÓN DEL TEOREMA DEL NÚMERO PRIMO}

    Estamos a punto de terminar la demostración del teorema del número primo\index{teorema@Teorema!de los numeros primos@de los números primos}. Necesitamos un
    resultado más de la teoría de funciones complejas que estableceremos en forma de lema.

    \begin{lema}\label{lem:13-4}
        Si $f(s)$ tiene un polo de orden $k$ en $s=\alpha$, entonces el cociente $f'(s)/f(s)$
        tiene un polo de primer orden en $s=\alpha$ con residuo $-k$.
    \end{lema}

    \begin{proof}
        Tenemos $f(s)=g(s)/(s-\alpha)^k$, en donde $g$ es analítica en $\alpha$ y
        $g(\alpha)\neq0$. Luego, para todo $s$ de un cierto entorno de $\alpha$, tenemos
        \begin{equation*}
            f'(s)=\frac{g'(s)}{(s-\alpha)^k}-\frac{kg(s)}{(s-\alpha)^{k+1}}=\frac{g(s)}{(s-\alpha)^k}\left\{\frac{-k}{s-\alpha}+\frac{g'(s)}{g(s)}\right\}.
        \end{equation*}
        Por lo tanto
        \begin{equation*}
            \frac{f'(s)}{f(s)}=\frac{-k}{s-\alpha}+\frac{g'(s)}{g(s)}.
        \end{equation*}
        Esto demuestra el lema ya que $g'(s)/g(s)$ es analítica en $\alpha$.
    \end{proof}

    \begin{teorema}\label{teo:13-8}
        La función
        \begin{equation*}
            F(s)=-\frac{\zeta'(s)}{\zeta(s)}-\frac{1}{s-1}
        \end{equation*}
        es analítica en $s=1$.
    \end{teorema}

    \begin{proof}
        Por el lema \ref{lem:13-4}, $-\zeta'(s)/\zeta(s)$ tiene un polo de primer orden en 1 con
        residuo 1, así como $1/(s-1)$. Luego su diferencia es analítica en $s=1$.
    \end{proof}

    \begin{teorema}\label{teo:13-9}
        Para $x\geq1$ tenemos
        \begin{equation*}
            \frac{\psi_1(x)}{x^2}-\frac{1}{2}\left(1-\frac{1}{x}\right)^2=\frac{1}{2\pi}\int_{-\infty}^{\infty}h(1+it)e^{it\log x}\,dt,
        \end{equation*}
        en donde la integral $\int_{-\infty}^{\infty}\abs{h(1+it)}\,dt$ converge. Por
        consiguiente, por el lema de Riemann-Lebesgue, tenemos
        \begin{equation}\label{eq:13-24}
            \psi_1(x)\sim x^2/2
        \end{equation}
        y por lo tanto
        \begin{equation*}
            \psi(x)\sim x\qquad\text{cuando }x\to\infty.
        \end{equation*}
    \end{teorema}

    \begin{proof}
        En el teorema \ref{teo:13-3} hemos demostrado que, si $c>1$ y $x\geq1$, tenemos
        \begin{equation*}
            \frac{\psi_1(x)}{x^2}-\frac{1}{2}\left(1-\frac{1}{x}\right)^2=\frac{1}{2\pi i}\int_{c-\infty i}^{c+\infty i}x^{s-1}h(s)\,ds,
        \end{equation*}
        en donde
        \begin{equation*}
            h(s)=\frac{1}{s(s+1)}\left(-\frac{\zeta'(s)}{\zeta(s)}-\frac{1}{s-1}\right).
        \end{equation*}
        La primera tarea que se nos plantea consiste en demostrar que podemos trasladar el
        camino de integración a la recta $\sigma=1$. Para ello aplicamos el teorema de Cauchy
        al rectángulo dibujado en la figura 13.3. La integral de $x^{s-1}h(s)$ a lo largo de
        $R$ es 0 puesto que el integrando es analítico en el interior y sobre $R$. Ahora
        demostraremos que las integrales a lo largo de los segmentos horizontales tienden a 0
        cuando $T\to\infty$. Dado que el integrando tiene el mismo valor absoluto en puntos
        conjugados, bastará considerar únicamente el segmento superior, $t=T$. En este segmento
        tenemos las acotaciones

        \begin{figure}[H]
            \centering
            \includegraphics{figuras/figura13-3.pdf}
            \caption{}
        \end{figure}

        \begin{equation*}
            \abs{\frac{1}{s(s+1)}}\leq\frac{1}{T^2}\qquad\text{y}\qquad\abs{\frac{1}{s(s+1)(s-1)}}\leq\frac{1}{T^3}\leq\frac{1}{T^2}.
        \end{equation*}
        Además existe una constante $M$ tal que $\abs{\zeta'(s)/\zeta(s)}\leq M\log^9t$ si
        $\sigma>1$ y $t\geq e$. Luego, si $T\geq e$, tenemos
        \begin{equation*}
            \abs{h(s)}\leq\frac{M\log^9T}{T^2}
        \end{equation*}
        o sea que
        \begin{equation*}
            \abs{\int_1^cx^{s-1}h(s)\,ds}\leq\int_1^cx^{\sigma-1}\,\frac{M\log^9T}{T^2}\,d\sigma=Mx^{c-1}\,\frac{\log^9T}{T^2}\,(c-1).
        \end{equation*}
        Por consiguiente las integrales a lo largo de los segmentos horizontales tienden a 0
        cuando $T\to\infty$, y por ello tenemos
        \begin{equation*}
            \int_{c-\infty i}^{c+\infty i}x^{s-1}h(s)\,ds=\int_{1-\infty i}^{1+\infty i}x^{s-1}h(s)\,ds.
        \end{equation*}
        Sobre la recta $\sigma=1$ escribimos $s=1+it$ y obtenemos
        \begin{equation*}
            \frac{1}{2\pi i}\int_{1-\infty i}^{1+\infty i}x^{s-1}h(s)\,ds=\frac{1}{2\pi}\int_{-\infty}^{\infty}h(1+it)e^{it\log x}\,dt.
        \end{equation*}
        Ahora observamos que
        \begin{equation*}
            \int_{-\infty}^{\infty}\abs{h(1+it)}\,dt=\int_{-\infty}^{-e}+\int_{-e}^{e}+\int_e^{\infty}.
        \end{equation*}
        En la integral de $e$ a $\infty$ tenemos
        \begin{equation*}
            \abs{h(1+it)}\leq\frac{M\log^9t}{t^2}
        \end{equation*}
        luego $\int_e^{\infty}\abs{h(1+it)}\,dt$ converge. Análogamente, $\int_{-\infty}^{-e}$
        converge, luego $\int_{-\infty}^{\infty}\abs{h(1+it)}\,dt$ converge. Entonces podemos
        aplicar el lema de Riemann\index{riemann, georg friedrich bernhard@Riemann, Georg Friedrich Bernhard}-Lebesgue para obtener $\psi_1(x)\sim x^2/2$. Por el teorema
        \ref{teo:13-1} esto implica $\psi(x)\sim x$ cuando $x\to\infty$, lo que termina la
        demostración del teorema del número primo.
    \end{proof}

    \section[REGIONES CARENTES DE CEROS DE $\zeta(s)$]{REGIONES CARENTES DE CEROS DE \texorpdfstring{$\zeta(s)$}{ζ(s)}}

    La desigualdad $\abs{1/\zeta(s)}<M\log^7t$ que se ha demostrado en el teorema
    \ref{teo:13-7} para $\sigma\geq1$ y $t\geq e$ se puede extender a la izquierda de la recta
    $\sigma=1$. La acotación no se obtiene en una región vertical sino en una región semejante
    a la de la figura 13.2, en la que el borde izquierdo de la curva se aproxima a la recta
    $\sigma=1$ asintóticamente cuando $t\to\infty$. La desigualdad implica la no anulación de
    $\zeta(s)$ en esta región. Con mayor precisión, tenemos:

    \begin{teorema}\label{teo:13-10}
        Suponemos $\sigma\geq1/2$. Entonces existen constantes $A>0$ y $C>0$ tales que
        \begin{equation*}
            \abs{\zeta(\sigma+it)}>\frac{C}{\log^7t}
        \end{equation*}
        siempre que
        \begin{equation}\label{eq:13-25}
            1-\frac{A}{\log^9t}<\sigma\leq1\qquad\text{y}\qquad t\geq e.
        \end{equation}
        Esto implica que $\zeta(\sigma+it)\neq0$ si $\sigma$ y $t$ satisfacen \eqref{eq:13-25}.
    \end{teorema}

    \begin{proof}
        La desigualdad triangular, junto con el teorema \ref{teo:13-7}, nos da, para un cierto
        $B>0$
        \begin{align}
            \abs{\zeta(\sigma+it)}&\geq\abs{\zeta(1+it)}-\abs{\zeta(1+it)-\zeta(\sigma+it)}\notag\\
            &>\frac{B}{\log^7t}-\abs{\zeta(1+it)-\zeta(\sigma+it)}.\label{eq:13-26}
        \end{align}
        Para acotar el último término escribimos
        \begin{equation*}
            \abs{\zeta(1+it)-\zeta(\sigma+it)}=\abs{\int_{\sigma}^1\zeta'(u+it)\,du}\leq\int_{\sigma}^1\abs{\zeta'(u+it)}\,du.
        \end{equation*}
        Como $t>e$, tenemos $\log^9t\geq\log t$, luego $1-(A/\log^9t)\geq1-(A/\log t)$. Así
        pues, si $\sigma$ satisface \eqref{eq:13-25} para todo $A>0$, podemos aplicar el teorema
        \ref{teo:13-4} para acotar $\abs{\zeta'(u+it)}$, obteniendo
        \begin{equation*}
            \abs{\zeta(1+it)-\zeta(\sigma+it)}\leq M(1-\sigma)\log^2t<M\log^2t\,\frac{A}{\log^9t}=\frac{MA}{\log^7t}.
        \end{equation*}
        Utilizando este resultado en \eqref{eq:13-26} obtenemos
        \begin{equation*}
            \abs{\zeta(\sigma+it)}>\frac{B-MA}{\log^7t}.
        \end{equation*}
        Esta desigualdad se verifica para un cierto $B>0$, todo $A>0$ y un cierto $M>0$ que
        depende de $A$. Un valor de $M$ que sirva para un $A$ sirve también para todo $A$ más
        pequeño. Por consiguiente podemos elegir $A$ ínfimo entre los que verifican
        $B-MA>0$. Si en la última desigualdad hacemos $C=B-MA$ obtenemos
        $\abs{\zeta(\sigma+it)}>C\log^{-7}t$ que prueba el teorema para todo $\sigma$ y todo
        $t$ que satisfagan
        \begin{equation*}
            1-\frac{A}{\log^9t}<\sigma<1,\qquad\text{y }t\geq e.
        \end{equation*}
        Pero el resultado es válido también para $\sigma=1$ por el teorema \ref{teo:13-7} con
        lo que se termina la demostración.
    \end{proof}

    Sabemos que $\zeta(s)\neq0$ si $\sigma\geq1$, y la ecuación funcional
    \begin{equation*}
        \zeta(s)=2(2\pi)^{s-1}\Gamma(1-s)\operatorname{sen}\left(\frac{\pi s}{2}\right)\zeta(1-s)
    \end{equation*}
    prueba que $\zeta(s)\neq0$ si $\sigma\leq0$ excepto en los ceros $s=-2,-4,-6,\dots$ que se
    obtienen de la anulación de $\operatorname{sen}(\pi s/2)$. Son los llamados ceros
    <<triviales>> de $\zeta(s)$. El teorema que sigue prueba que, fuera de los ceros
    triviales, $\zeta(s)$ no posee sobre el eje real ningún otro cero.

    \begin{teorema}\label{teo:13-11}
        Si $\sigma>0$ tenemos
        \begin{equation}\label{eq:13-27}
            (1-2^{1-s})\zeta(s)=\sum_{n=1}^{\infty}\frac{(-1)^{n-1}}{n^s}.
        \end{equation}
        Esto implica que $\zeta(s)<0$ si $s$ es real y $0<s<1$.
    \end{teorema}

    \begin{proof}
        Primero suponemos que $\sigma>1$. Entonces tenemos
        \begin{align*}
            (1-2^{1-s})\zeta(s)&=\sum_{n=1}^{\infty}\frac{1}{n^s}-2\sum_{n=1}^{\infty}\frac{1}{(2n)^s}\\
            &=(1+2^{-s}+3^{-s}+\cdots)-2(2^{-s}+4^{-s}+6^{-s}+\cdots)\\
            &=1-2^{-s}+3^{-s}-4^{-s}+5^{-s}-6^{-s}+\cdots,
        \end{align*}
        que prueba \eqref{eq:13-27} para $\sigma>1$. Sin embargo, si $\sigma>0$, la serie de la
        derecha converge, luego \eqref{eq:13-27} también se verifica para $\sigma>0$ por
        prolongación analítica.

        Cuando $s$ es real, la serie de \eqref{eq:13-27} es una serie alternada que tiene suma
        positiva. Si $0<s<1$, el factor $(1-2^{1-s})$ es negativo, luego $\zeta(s)$ también es
        negativo.
    \end{proof}

    \section{LA HIPÓTESIS DE RIEMANN}

    En su famosa memoria de 8 páginas acerca de $\pi(x)$, publicada en 1859, Riemann
    \cite{riemann1859} afirma que parece plausible que los ceros no triviales de $\zeta(s)$
    pertenecen todos a la recta $\sigma=1/2$, si bien no ha podido demostrarlo. La afirmación
    de que todos los ceros no triviales tienen parte real $1/2$ se conoce actualmente como
    \textit{hipótesis de Riemann}. En 1900 Hilbert\index{hilbert, david@Hilbert, David} colocó el problema de demostrar o
    contradecir esta hipótesis en la lista de los problemas más importantes con que deberían
    enfrentarse los matemáticos del siglo veinte. Todavía hoy no ha sido resuelto.

    La hipótesis de Riemann atrajo la atención de muchos de los matemáticos eminentes y se ha
    descubierto gran cantidad de resultados acerca de la distribución de los ceros de
    $\zeta(s)$. La ecuación funcional prueba que todos los ceros no triviales (si existe
    alguno) deben hallarse en la banda $0<\sigma<1$, llamada <<banda crítica\index{banda critica@Banda crítica}>>. Es fácil
    demostrar que los ceros se hallan distribuidos simétricamente respecto del eje real y de
    la <<recta crítica\index{recta critica@Recta crítica}>> $\sigma=1/2$.

    En 1915, Hardy\index{hardy, godfrey harold@Hardy, Godfrey Harold} probó que hay una infinidad de ceros situados en la recta crítica\index{recta critica@Recta crítica}. En 1921
    Hardy\index{hardy, godfrey harold@Hardy, Godfrey Harold} y Littlewood\index{littlewood, john edensor@Littlewood, John Edensor} demostraron que el número de ceros que hay en el segmento rectilíneo
    que une $1/2$ con $1/2+iT$ es por lo menos $AT$ para una cierta constante positiva $A$,
    si $T$ es suficientemente grande. En 1942 Selberg lo perfeccionó probando que el número es
    por lo menos $AT\log T$ para un cierto $A>0$. También se sabe que el número en la banda
    crítica con $0<t<T$ es asintótico a $T\log T/2\pi$ cuando $T\to\infty$, o sea que el
    resultado de Selberg\index{selberg, atle@Selberg, Atle} prueba que una fracción positiva de los ceros está en la recta
    crítica. Recientemente (1974) Levinson ha demostrado que esta fracción es por lo menos
    $7/10$. Es decir, que la constante del teorema de Selberg satisface $A>7/20\pi$.

    Extensos cálculos de Gram, Backlund, Lehmer, Haselgrove, Rosser, Yohe, Schoenfeld, y otros
    han demostrado que los tres primeros millones y medio de ceros por encima del eje real se
    hallan en la recta crítica\index{recta critica@Recta crítica}. A despecho de que todo ello constituye una evidencia a favor de
    la hipótesis de Riemann\index{riemann, georg friedrich bernhard@Riemann, Georg Friedrich Bernhard}, los cálculos han revelado también ciertos fenómenos que sugieren
    que es muy posible que existan contraejemplos de la hipótesis de Riemann. Para una
    narración fascinante de la historia de los cálculos a gran escala concernientes a
    $\zeta(s)$, el lector puede consultar \cite{edwards1974}.

    \section{APLICACIÓN A LA FUNCIÓN DIVISOR}

    El teorema del número primo, a veces, es útil para estimar el orden de magnitud de
    funciones aritméticas multiplicativas. En esta sección lo utilizaremos para demostrar
    desigualdades para $d(n)$, número de divisores de $n$.

    En el capítulo 3 hemos demostrado que el orden medio de $d(n)$ es $\log n$. Cuando $n$ es
    primo tenemos $d(n)=2$, por lo que el tamaño de $d(n)$ es tanto mayor cuantos más divisores
    tenga $n$. Suponemos que $n$ es el producto de todos los números primos $\leq x$,
    \begin{equation}\label{eq:13-28}
        n=2\cdot3\cdot5\cdots p_{\pi(x)}.
    \end{equation}
    Puesto que $d(n)$ es multiplicativa tenemos
    \begin{equation*}
        d(n)=d(2)d(3)\cdots d(p_{\pi(x)})=2^{\pi(x)}.
    \end{equation*}
    Para $x$ grande, $\pi(x)$ es aproximadamente $x/\log x$ y \eqref{eq:13-28} implica
    \begin{equation*}
        \log n=\sum_{p\leq x}\log p=\vartheta(x)\sim x
    \end{equation*}
    luego $2^{\pi(x)}$ es aproximadamente $2^{\log n/\log\log n}$. Ahora bien
    \begin{equation*}
        2^{a\log n}=e^{a\log n\log2}=n^{a\log2}
    \end{equation*}
    luego $2^{\log n/\log\log n}=n^{\log2/\log\log n}$. Con otras palabras, cuando $n$ es de la
    forma \eqref{eq:13-28} entonces $d(n)$ es aproximadamente
    $2^{\log n/\log\log n}=n^{\log2/\log\log n}$.

    Siguiendo esta idea un poco más cuidadosamente obtenemos las siguientes desigualdades para
    $d(n)$.

    \begin{teorema}\label{teo:13-12}
        Sea $\varepsilon>0$. Entonces tenemos:
        \begin{enumerate}
            \item[(a)] Existe un entero $N(\varepsilon)$ tal que $n\geq N(\varepsilon)$
            implica
            \begin{equation*}
                d(n)<2^{(1+\varepsilon)\log n/\log\log n}=n^{(1+\varepsilon)\log2/\log\log n}.
            \end{equation*}
            \item[(b)] Para una infinidad de $n$ tenemos
            \begin{equation*}
                d(n)>2^{(1-\varepsilon)\log n/\log\log n}=n^{(1-\varepsilon)\log2/\log\log n}.
            \end{equation*}
        \end{enumerate}
    \end{teorema}

    Nota. Estas desigualdades equivalen a la relación
    \begin{equation*}
        \limsup_{n\to\infty}\frac{\log d(n)\log\log n}{\log n}=\log2.
    \end{equation*}

    \begin{proof}
        Escribimos $n=p_1^{a_1}\cdots p_k^{a_k}$, así que $d(n)=\prod_{i=1}^{k}(a_i+1)$.
        Dividimos el producto en dos partes, separando los divisores primos $<f(n)$ de los
        $\geq f(n)$, en donde $f(n)$ se especificará más adelante. Entonces
        $d(n)=P_1(n)P_2(n)$ en donde
        \begin{equation*}
            P_1(n)=\prod_{p_i<f(n)}(a_i+1)\qquad\text{y}\qquad P_2(n)=\prod_{p_i\geq f(n)}(a_i+1).
        \end{equation*}
        En el producto $P_2(n)$ utilizamos la desigualdad $(a+1)\leq2^a$ y obtenemos
        $P_2(n)\leq2^{S(n)}$ en donde
        \begin{equation*}
            S(n)=\sum_{\substack{i=1\\p_i\geq f(n)}}^{k}a_i.
        \end{equation*}
        Ahora bien
        \begin{equation*}
            n=\prod_{i=1}^{k}p_i^{a_i}\geq\prod_{p_i\geq f(n)}p_i^{a_i}\geq\prod_{p_i\geq f(n)}f(n)^{a_i}=f(n)^{S(n)},
        \end{equation*}
        por lo tanto
        \begin{equation*}
            \log n\geq S(n)\log f(n),\qquad\text{luego}\qquad S(n)\leq\frac{\log n}{\log f(n)}.
        \end{equation*}
        Esto nos da
        \begin{equation}\label{eq:13-29}
            P_2(n)\leq2^{\log n/\log f(n)}.
        \end{equation}
        Para estimar $P_1(n)$ escribimos
        \begin{equation*}
            P_1(n)=\exp\left\{\sum_{p_i<f(n)}\log(a_i+1)\right\}
        \end{equation*}
        y probamos que $\log(a_i+1)<2\log\log n$ si $n$ es suficientemente grande. De hecho
        tenemos
        \begin{equation*}
            n\geq p_i^{a_i}\geq2^{a_i}
        \end{equation*}
        por lo tanto
        \begin{equation*}
            \log n\geq a_i\log2,\qquad\text{luego}\qquad a_i\leq\log n/\log2.
        \end{equation*}
        Por consiguiente
        \begin{equation*}
            1+a_i\leq1+\frac{\log n}{\log2}<(\log n)^2\qquad\text{si }n>n_1
        \end{equation*}
        para un cierto $n_1$. Entonces $n\geq n_1$ implica
        $\log(1+a_i)<\log(\log n)^2=2\log\log n$. Esto nos da
        \begin{equation*}
            P_1(n)<\exp\left\{2\log\log n\sum_{p_i<f(n)}1\right\}\leq\exp\{2\log\log n\,\pi(f(n))\}.
        \end{equation*}
        Utilizando la desigualdad $\pi(x)<6x/\log x$ (ver teorema 4.6) obtenemos
        \begin{equation}\label{eq:13-30}
            P_1(n)<\exp\left\{\frac{12f(n)\log\log n}{\log f(n)}\right\}=2^{cf(n)\log\log n/\log f(n)},
        \end{equation}
        en donde $c=12/\log2$. Combinando \eqref{eq:13-29} y \eqref{eq:13-30} obtenemos
        $d(n)=P_1(n)P_2(n)<2^{g(n)}$ en donde
        \begin{equation*}
            g(n)=\frac{\log n+cf(n)\log\log n}{\log f(n)}=\frac{\log n}{\log\log n}\;\frac{1+c\,\dfrac{f(n)\log\log n}{\log n}}{\dfrac{\log f(n)}{\log\log n}}.
        \end{equation*}
        Ahora elegimos $f(n)$ de forma que $f(n)\log\log n/\log n\to0$ y además hacemos que
        $\log f(n)/\log\log n\to1$ cuando $n\to\infty$. Para ello es suficiente tomar
        \begin{equation*}
            f(n)=\frac{\log n}{(\log\log n)^2}.
        \end{equation*}
        Entonces
        \begin{equation*}
            g(n)=\frac{\log n}{\log\log n}\;\frac{1+o(1)}{1+o(1)}=\frac{\log n}{\log\log n}(1+o(1))<(1+\varepsilon)\frac{\log n}{\log\log n}
        \end{equation*}
        si $n\geq N(\varepsilon)$ para un cierto $N(\varepsilon)$. Esto prueba la parte (a).

        Para demostrar la parte (b) tomamos un conjunto de enteros $n$ que posean gran número de
        factores primos. Efectivamente, tomamos $n$ igual al producto de todos los factores
        primos $\leq x$. Entonces $n\to\infty$ si, y sólo si, $x\to\infty$. Para ese $n$ tenemos,
        por el teorema del número primo,
        \begin{equation*}
            d(n)=2^{\pi(x)}=2^{(1+o(1))x/\log x}.
        \end{equation*}
        También, para este $n$, tenemos
        \begin{equation*}
            \log n=\sum_{p\leq x}\log p=\vartheta(x)=x(1+o(1))
        \end{equation*}
        luego
        \begin{equation*}
            x=\frac{\log n}{1+o(1)}=(1+o(1))\log n
        \end{equation*}
        por lo tanto
        \begin{align*}
            \log x&=\log\log n+\log(1+o(1))=\log\log n\left(1+\frac{\log(1+o(1))}{\log\log n}\right)\\
            &=(1+o(1))\log\log n.
        \end{align*}
        Por consiguiente $x/\log x=(1+o(1))\log n/\log\log n$ y
        \begin{equation*}
            d(n)=2^{(1+o(1))\log n/\log\log n}
        \end{equation*}
        para tal $n$. Pero $1+o(1)>1-\varepsilon$ si $n\geq N(\varepsilon)$ para un cierto
        $N(\varepsilon)$ y esto prueba (b).
    \end{proof}

    Nota. Como corolario del teorema \ref{teo:13-12} obtenemos la relación
    \begin{equation}\label{eq:13-31}
        d(n)=o(n^{\delta})
    \end{equation}
    para cada $\delta>0$. Este resultado se puede obtener también sin necesidad de utilizar el
    teorema del número primo\index{teorema@Teorema!de los numeros primos@de los números primos}. (Ver ejercicio 13.13.)

    \section{APLICACIÓN A LA INDICATRIZ DE EULER}

    El tipo de razonamiento utilizado en la sección precedente se puede utilizar también para
    obtener desigualdades para $\varphi(n)$. Cuando $n$ es primo tenemos $\varphi(n)=n-1$.
    Cuando $n$ posee gran número de factores primos, $\varphi(n)$ será mucho menor. Realmente si
    $n$ es el producto de todos los primos $\leq x$ tenemos
    \begin{equation*}
        \varphi(n)=n\prod_{p\leq x}\left(1-\frac{1}{p}\right).
    \end{equation*}
    El teorema que sigue da el comportamiento asintótico de este producto cuando $x$ es grande.

    \begin{teorema}\label{teo:13-13}
        Existe una constante positiva $c$ tal que, para $x\geq2$,
        \begin{equation}\label{eq:13-32}
            \prod_{p\leq x}\left(1-\frac{1}{p}\right)=\frac{c}{\log x}+O\left(\frac{1}{\log^2x}\right).
        \end{equation}
    \end{teorema}

    Nota. Es posible demostrar que $c=e^{-C}$, en donde $C$ es la constante de Euler (ver
    \cite{hardywright1960}).

    \begin{proof}
        Si $P(x)$ designa el producto de \eqref{eq:13-32}, entonces
        $\log P(x)=-\sum_{p\leq x}\log(1-1/p)$. Para estimar esta suma utilizamos el desarrollo
        en serie de potencias
        \begin{equation*}
            -\log(1-t)=t+\frac{t^2}{2}+\frac{t^3}{3}+\cdots+\frac{t^n}{n}+\cdots\qquad(\abs{t}<1)
        \end{equation*}
        con $t=1/p$. Si pasamos un término al otro miembro obtenemos, si
        $a_p=-\log(1-1/p)-1/p$,
        \begin{equation*}
            0<a_p=\frac{1}{2p^2}+\frac{1}{3p^3}+\cdots<\frac{1}{2}\left(\frac{1}{p^2}+\frac{1}{p^3}+\cdots\right)=\frac{1}{2p(p-1)}.
        \end{equation*}
        Esta desigualdad prueba que la serie infinita
        \begin{equation}\label{eq:13-33}
            \sum_pa_p=\sum_p\left\{-\log\left(1-\frac{1}{p}\right)-\frac{1}{p}\right\}
        \end{equation}
        converge, ya que está dominada por $\sum_{n=2}^{\infty}1/n(n-1)$. Si $B$ designa la suma
        de la serie dada en \eqref{eq:13-33} tenemos
        \begin{equation*}
            0<B-\sum_{p\leq x}a_p=\sum_{p>x}a_p\leq\sum_{n\geq x}\frac{1}{n(n-1)}=\sum_{n\geq x}\left(\frac{1}{n-1}-\frac{1}{n}\right)=O\left(\frac{1}{x}\right).
        \end{equation*}
        Luego
        \begin{equation*}
            \sum_{p\leq x}a_p=B+O\left(\frac{1}{x}\right),
        \end{equation*}
        por lo tanto
        \begin{equation*}
            -\log P(x)=\sum_{p\leq x}\frac{1}{p}+B+O\left(\frac{1}{x}\right).
        \end{equation*}
        Pero, por el teorema 4.12, la suma de la derecha es $\log\log x+A+O(1/\log x)$
        así que
        \begin{equation*}
            \log P(x)=-\log\log x-B-A+O\left(\frac{1}{\log x}\right).
        \end{equation*}
        Por consiguiente
        \begin{equation*}
            P(x)=\exp\{\log P(x)\}=e^{-B-A}e^{-\log\log x}e^{O(1/\log x)}.
        \end{equation*}
        Sea ahora $c=e^{-B-A}$ y utilizando la desigualdad $e^u=1+O(u)$ para $0<u<1$ obtenemos
        \begin{equation*}
            P(x)=\frac{c}{\log x}\left\{1+O\left(\frac{1}{\log x}\right)\right\}=\frac{c}{\log x}+O\left(\frac{1}{\log^2x}\right).
        \end{equation*}
        Esto termina la demostración.
    \end{proof}

    \begin{teorema}\label{teo:13-14}
        Sea $c$ la constante del teorema \ref{teo:13-13}, y sea $\varepsilon>0$.
        \begin{enumerate}
            \item[(a)] Existe un $N(\varepsilon)$ tal que
            \begin{equation*}
                \varphi(n)\geq(1-\varepsilon)\frac{cn}{\log\log n}\qquad\text{para todo }n>N(\varepsilon).
            \end{equation*}
            \item[(b)] Para una infinidad de $n$ tenemos
            \begin{equation*}
                \varphi(n)\leq(1+\varepsilon)\frac{cn}{\log\log n}.
            \end{equation*}
        \end{enumerate}
        Con otras palabras,
        \begin{equation*}
            \liminf_{n\to\infty}\frac{\varphi(n)\log\log n}{n}=c.
        \end{equation*}
    \end{teorema}

    \begin{proof}
        Primeramente probaremos (b). Tomamos $n=\prod_{p\leq x}p$. Entonces
        \begin{equation*}
            \frac{\varphi(n)}{n}=\prod_{p\leq x}\left(1-\frac{1}{p}\right)=\frac{c}{\log x}+O\left(\frac{1}{\log^2x}\right).
        \end{equation*}
        Pero $\log n=\vartheta(x)=(1+o(1))x$, luego $\log\log n=(1+o(1))\log x$, por lo tanto
        \begin{equation*}
            \frac{\varphi(n)}{n}=\frac{c(1+o(1))}{\log\log n}+O\left(\frac{1}{(\log\log n)^2}\right)=\frac{c(1+o(1))}{\log\log n}\leq(1+\varepsilon)\frac{c}{\log\log n}
        \end{equation*}
        si $n\geq N(\varepsilon)$ para un $N(\varepsilon)$. Esto demuestra (b).

        Para demostrar (a) tomamos $n>1$ y escribimos
        \begin{equation*}
            \frac{\varphi(n)}{n}=\prod_{p\mid n}\left(1-\frac{1}{p}\right)=P_1(n)P_2(n)
        \end{equation*}
        en donde
        \begin{equation*}
            P_1(n)=\prod_{\substack{p\mid n\\p\leq\log n}}\left(1-\frac{1}{p}\right),\qquad\text{y}\qquad P_2(n)=\prod_{\substack{p\mid n\\p>\log n}}\left(1-\frac{1}{p}\right).
        \end{equation*}
        Entonces
        \begin{equation}\label{eq:13-34}
            P_2(n)>\prod_{\substack{p\mid n\\p>\log n}}\left(1-\frac{1}{\log n}\right)=\left(1-\frac{1}{\log n}\right)^{f(n)}
        \end{equation}
        en donde $f(n)$ es el número de primos que dividen a $n$ y exceden a $\log n$. Como
        \begin{equation*}
            n\geq\prod_{p\mid n}p>\prod_{\substack{p\mid n\\p>\log n}}p\geq(\log n)^{f(n)}
        \end{equation*}
        obtenemos $\log n>f(n)\log\log n$, por lo tanto $f(n)<\log n/\log\log n$. Pero al ser
        $1-(1/\log n)<1$, la desigualdad \eqref{eq:13-34} nos da
        \begin{equation}\label{eq:13-35}
            P_2(n)>\left(1-\frac{1}{\log n}\right)^{\log n/\log\log n}=\left\{\left(1-\frac{1}{\log n}\right)^{\log n}\right\}^{1/\log\log n}.
        \end{equation}
        Ahora bien $(1-(1/u))^u\to e^{-1}$ cuando $u\to\infty$ luego el último miembro de
        \eqref{eq:13-35} tiende a 1 cuando $n\to\infty$. Por lo tanto \eqref{eq:13-35} nos da
        \begin{equation*}
            P_2(n)>1+o(1)\qquad\text{cuando }n\to\infty.
        \end{equation*}
        Por consiguiente
        \begin{align*}
            \frac{\varphi(n)}{n}=P_1(n)P_2(n)&>(1+o(1))\prod_{\substack{p\mid n\\p\leq\log n}}\left(1-\frac{1}{p}\right)\geq(1+o(1))\prod_{p\leq\log n}\left(1-\frac{1}{p}\right)\\
            &=(1+o(1))\frac{c}{\log\log n}(1+o(1))\geq(1-\varepsilon)\frac{c}{\log\log n}
        \end{align*}
        si $n\geq N(\varepsilon)$. Esto demuestra la parte (a).
    \end{proof}

    \section{EXTENSIÓN DE LA DESIGUALDAD DE PÓLYA PARA SUMAS DE CARACTERES}
\index{desigualdad de polya@Desigualdad de Pólya}
    Terminamos este capítulo extendiendo la desigualdad de Pólya\index{desigualdad de polya@Desigualdad de Pólya}\index{polya, g.@Pólya, G.} (teorema 8.21) a caracteres no
    principales arbitrarios. La demostración utiliza la estimación de la función divisor
    \begin{equation*}
        d(n)=O(n^{\delta})
    \end{equation*}
    obtenida en \eqref{eq:13-31}.

    \begin{teorema}\label{teo:13-15}
        Si $\chi$ es un carácter no principal mód $k$ entonces, para todo $x\geq2$, tenemos
        \begin{equation*}
            \sum_{m\leq x}\chi(m)=O(\sqrt{k}\log k).
        \end{equation*}
    \end{teorema}

    \begin{proof}
        Si $\chi$ es primitivo, el teorema 8.21 demuestra que
        \begin{equation*}
            \abs{\sum_{m\leq x}\chi(m)}<\sqrt{k}\log k.
        \end{equation*}
        Sea ahora $\chi$ un carácter no principal arbitrario mód $k$ y sea $c$ el conductor de
        $\chi$. Entonces $c\mid k$, $c<k$, y podemos escribir
        \begin{equation*}
            \chi(m)=\psi(m)\chi_1(m)
        \end{equation*}
        en donde $\chi_1$ es el carácter principal mód $k$ y $\psi$ es un carácter primitivo
        mód $c$. Entonces
        \begin{align*}
            \sum_{m\leq x}\chi(m)&=\sum_{\substack{m\leq x\\(m,k)=1}}\psi(m)=\sum_{m\leq x}\psi(m)\sum_{d\mid(m,k)}\mu(d)=\sum_{m\leq x}\sum_{\substack{d\mid k\\d\mid m}}\mu(d)\psi(m)\\
            &=\sum_{d\mid k}\mu(d)\sum_{q\leq x/d}\psi(qd)=\sum_{d\mid k}\mu(d)\psi(d)\sum_{q\leq x/d}\psi(q).
        \end{align*}
        Luego
        \begin{equation}\label{eq:13-36}
            \abs{\sum_{m\leq x}\chi(m)}\leq\sum_{d\mid k}\abs{\mu(d)\psi(d)}\abs{\sum_{q\leq x/d}\psi(q)}<\sqrt{c}\log c\sum_{d\mid k}\abs{\mu(d)\psi(d)}
        \end{equation}
        ya que $\psi$ es primitivo mód $c$. En esta última suma cada factor
        $\abs{\mu(d)\psi(d)}$ vale 0 ó 1. Si $\abs{\mu(d)\psi(d)}=1$ entonces $\abs{\mu(d)}=1$,
        luego $d$ es un divisor de $k$ sin factores cuadrados, es decir
        \begin{equation*}
            d=p_1p_2\cdots p_r.
        \end{equation*}
        Además, $\abs{\psi(d)}=1$, luego $(d,c)=1$, lo que significa que ningún factor primo
        $p_i$ divide a $c$. Luego cada $p_i$ divide a $k/c$, por lo tanto $d$ divide a $k/c$. Con
        otras palabras
        \begin{equation*}
            \sum_{d\mid k}\abs{\mu(d)\psi(d)}\leq\sum_{d\mid k/c}1=d\left(\frac{k}{c}\right)=O\left(\left(\frac{k}{c}\right)^{\delta}\right)
        \end{equation*}
        para cada $\delta>0$. En particular, $d(k/c)=O(\sqrt{k/c})$, luego \eqref{eq:13-36}
        implica
        \begin{equation*}
            \sum_{m\leq x}\chi(m)=O\left(\sqrt{\frac{k}{c}}\sqrt{c}\log c\right)=O(\sqrt{k}\log c)=O(\sqrt{k}\log k).\qedhere
        \end{equation*}
    \end{proof}

    \section*{Ejercicios del capítulo 13}

    \begin{ejercicio}
        Chebyshev probó que, si $\psi(x)/x$ tiende a un límite cuando $x\to\infty$ entonces este
        límite es igual a 1. Una demostración fue indicada ya en el ejercicio 4.26. Este
        ejercicio proporciona otra demostración basada en la identidad
        \begin{equation}\label{eq:13-37}
            -\frac{\zeta'(s)}{\zeta(s)}=s\int_1^{\infty}\frac{\psi(x)}{x^{s+1}}\,dx\qquad(\sigma>1)
        \end{equation}
        dada en el ejercicio 11.1(d).
        \begin{enumerate}
            \item[(a)] Probar que $(1-s)\zeta'(s)/\zeta(s)\to1$ cuando $s\to1+$.
            \item[(b)] Sea $\delta=\limsup_{x\to\infty}(\psi(x)/x)$. Dado $\varepsilon>0$,
            elegimos $N=N(\varepsilon)$ tal que $x\geq N$ implique
            $\psi(x)\leq(\delta+\varepsilon)x$. Tomamos $s$ real, $1<s\leq2$, descomponemos la
            integral de \eqref{eq:13-37} en dos partes, $\int_1^N+\int_N^{\infty}$, y acotamos
            cada parte a fin de obtener la desigualdad
            \begin{equation*}
                -\frac{\zeta'(s)}{\zeta(s)}\leq C(\varepsilon)+\frac{s(\delta+\varepsilon)}{s-1},
            \end{equation*}
            en donde $C(\varepsilon)$ es una constante independiente de $s$. Utilizar (a) para
            deducir que $\delta\geq1$.
            \item[(c)] Sea $\gamma=\liminf_{x\to\infty}(\psi(x)/x)$ y utilizar un razonamiento
            análogo para deducir que $\gamma\leq1$.
        \end{enumerate}
        Por consiguiente, si $\psi(x)/x$ tiende a un límite cuando $x\to\infty$, entonces
        $\gamma=\delta=1$.
    \end{ejercicio}

    \begin{ejercicio}
        Sea $A(x)=\sum_{n\leq x}a(n)$, en donde
        \begin{equation*}
            a(n)=
            \begin{cases}
                0&\text{si }n\neq\text{una potencia de primo,}\\
                \dfrac{1}{k}&\text{si }n=p^k.
            \end{cases}
        \end{equation*}
        Probar que $A(x)=\pi(x)+O(\sqrt{x}\log\log x)$.
    \end{ejercicio}

    \begin{ejercicio}
        \begin{enumerate}
            \item[(a)] Si $c>1$ y $x\neq$ entero, probar que, si $x>1$,
            \begin{equation*}
                \frac{1}{2\pi i}\int_{c-\infty i}^{c+\infty i}\log\zeta(s)\,\frac{x^s}{s}\,ds=\pi(x)+\frac{1}{2}\pi(x^{1/2})+\frac{1}{3}\pi(x^{1/3})+\cdots.
            \end{equation*}
            \item[(b)] Probar que el teorema del número primo es equivalente a la relación
            asintótica
            \begin{equation*}
                \frac{1}{2\pi i}\int_{c-\infty i}^{c+\infty i}\log\zeta(s)\,\frac{x^s}{s}\,ds\sim\frac{x}{\log x}\qquad\text{cuando }x\to\infty.
            \end{equation*}
        \end{enumerate}
        Una demostración del teorema del número primo basada en esta relación fue establecida
        por Landau\index{landau, edmund@Landau, Edmund} en 1903.
    \end{ejercicio}

    \begin{ejercicio}
        Sea $M(x)=\sum_{n\leq x}\mu(n)$. Se desconoce el orden exacto de magnitud de $M(x)$ para
        $x$ grande. En el capítulo 4 probábamos que el teorema del número primo es equivalente a
        la relación $M(x)=o(x)$ cuando $x\to\infty$. Este ejercicio relaciona el orden de
        magnitud de $M(x)$ con la hipótesis de Riemann.

        Suponemos que existe una constante positiva $\theta$ tal que
        \begin{equation*}
            M(x)=O(x^{\theta})\qquad\text{para }x\geq1.
        \end{equation*}
        Probar que la fórmula
        \begin{equation*}
            \frac{1}{\zeta(s)}=s\int_1^{\infty}\frac{M(x)}{x^{s+1}}\,dx,
        \end{equation*}
        que es válida para $\sigma>1$ (ver ejercicio 11.1(c)) también es válida para
        $\sigma>\theta$. Deducir que $\zeta(s)\neq0$ para $\sigma>\theta$. En particular, esto
        prueba que la relación $M(x)=O(x^{1/2-\varepsilon})$ para cada $\varepsilon>0$ implica
        la hipótesis de Riemann. También se puede demostrar que la hipótesis de Riemann implica
        $M(x)=O(x^{1/2+\varepsilon})$ para cada $\varepsilon>0$. (Ver Titchmarsh
        \cite{titchmarsh1951}, p. 315.)
    \end{ejercicio}

    \begin{ejercicio}
        Probar el siguiente lema, que es análogo al lema \ref{lem:13-2}. Sea
        \begin{equation*}
            A_1(x)=\int_1^x\frac{A(u)}{u}\,du,
        \end{equation*}
        en donde $A(u)$ es una función creciente no negativa para $u\geq1$. Si, para un $c>0$ y
        un $L>0$, tenemos la fórmula asintótica
        \begin{equation*}
            A_1(x)\sim Lx^c\qquad\text{cuando }x\to\infty,
        \end{equation*}
        entonces es
        \begin{equation*}
            A(x)\sim cLx^c\qquad\text{cuando }x\to\infty.
        \end{equation*}
    \end{ejercicio}

    \begin{ejercicio}
        Probar que
        \begin{equation*}
            \frac{1}{2\pi i}\int_{2-\infty i}^{2+\infty i}\frac{y^s}{s^2}\,ds=0\qquad\text{si }0<y<1.
        \end{equation*}
        ¿Cuál es el valor de esta integral si $y\geq1$?
    \end{ejercicio}

    \begin{ejercicio}
        Expresar
        \begin{equation*}
            \frac{1}{2\pi i}\int_{2-\infty i}^{2+\infty i}\frac{x^s}{s^2}\left(-\frac{\zeta'(s)}{\zeta(s)}\right)ds
        \end{equation*}
        como una suma finita que contenga a $\Lambda(n)$.
    \end{ejercicio}

    \begin{ejercicio}
        Sea $\chi$ un carácter cualquiera de Dirichlet mód $k$ y $\chi_1$ el carácter principal.
        Definimos
        \begin{equation*}
            F(\sigma,t)=3\,\frac{L'}{L}(\sigma,\chi_1)+4\,\frac{L'}{L}(\sigma+it,\chi)+\frac{L'}{L}(\sigma+2it,\chi^2).
        \end{equation*}
        Si $\sigma>1$, probar que $F(\sigma,t)$ tiene parte real igual a
        \begin{equation*}
            -\sum_{n=1}^{\infty}\frac{\Lambda(n)}{n^{\sigma}}\operatorname{Re}\left\{3\chi_1(n)+4\chi(n)n^{-it}+\chi^2(n)n^{-2it}\right\}
        \end{equation*}
        y deducir que $\operatorname{Re}F(\sigma,t)\leq0$.
    \end{ejercicio}

    \begin{ejercicio}
        Suponemos que $L(s,\chi)$ tiene un cero de orden $m\geq1$ en $s=1+it$. Probar que, para
        este $t$, tenemos:
        \begin{enumerate}
            \item[(a)] $\displaystyle\frac{L'}{L}(\sigma+it,\chi)=\frac{m}{\sigma-1}+O(1)$ cuando $\sigma\to1+$,
        \end{enumerate}
        y
        \begin{enumerate}
            \item[(b)] existe un entero $r\geq0$ tal que
            \begin{equation*}
                \frac{L'}{L}(\sigma+2it,\chi^2)=\frac{r}{\sigma-1}+O(1)\qquad\text{cuando }\sigma\to1+,
            \end{equation*}
            excepto cuando $\chi^2=\chi_1$ y $t=0$.
        \end{enumerate}
    \end{ejercicio}

    \begin{ejercicio}
        Utilizar los ejercicios 8 y 9 para demostrar que
        \begin{equation*}
            L(1+it,\chi)\neq0\qquad\text{para todo real }t\text{ si }\chi^2\neq\chi_1
        \end{equation*}
        y que
        \begin{equation*}
            L(1+it,\chi)\neq0\qquad\text{para todo real }t\neq0\text{ si }\chi^2=\chi_1.
        \end{equation*}
        [\textit{Indicación:} Considerar $F(\sigma,t)$ cuando $\sigma\to1+$.]
    \end{ejercicio}

    \begin{ejercicio}
        Para toda función aritmética $f(n)$, probar que las siguientes afirmaciones son
        equivalentes:
        \begin{enumerate}
            \item[(a)] $f(n)=O(n^{\varepsilon})$ para cada $\varepsilon>0$ y todo
            $n\geq n_1$.
            \item[(b)] $f(n)=o(n^{\delta})$ para cada $\delta>0$ cuando $n\to\infty$.
        \end{enumerate}
    \end{ejercicio}

    \begin{ejercicio}
        Sea $f$ una función multiplicativa tal que, si $p$ es primo, entonces
        \begin{equation*}
            f(p^m)\to0\qquad\text{cuando }p^m\to\infty.
        \end{equation*}
        Es decir, para cada $\varepsilon>0$, existe un $N(\varepsilon)$ tal que
        $\abs{f(p^m)}<\varepsilon$ si $p^m>N(\varepsilon)$. Probar que $f(n)\to0$ cuando
        $n\to\infty$.

        [\textit{Indicación:} Existe una constante $A>0$ tal que $\abs{f(p^m)}<A$ para todo
        primo $p$ y todo $m>0$, y una constante $B>0$ tal que $\abs{f(p^m)}<1$ si $p^m>B$.]
    \end{ejercicio}

    \begin{ejercicio}
        Si $\alpha\geq0$, sea $\sigma_{\alpha}(n)=\sum_{d\mid n}d^{\alpha}$. Probar que, para
        cada $\delta>0$, tenemos
        \begin{equation*}
            \sigma_{\alpha}(n)=o(n^{\alpha+\delta})\qquad\text{cuando }n\to\infty.
        \end{equation*}
        [\textit{Indicación:} Utilizar el ejercicio 12.]
    \end{ejercicio}

