% ========== COMANDOS MATEMÁTICOS ==========

% -- Conjuntos numéricos --
\newcommand{\N}{\mathbb{N}}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\Q}{\mathbb{Q}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\C}{\mathbb{C}}
\newcommand{\E}{\mathbb{E}}        % Esperanza (probabilidad)

% -- Letras caligráficas --
\newcommand{\BB}{\mathcal{B}}
\newcommand{\CC}{\mathcal{C}}
\newcommand{\FF}{\mathcal{F}}      % σ-álgebra (probabilidad) / familia
\newcommand{\PP}{\mathcal{P}}
\newcommand{\TT}{\mathcal{T}}
\newcommand{\LL}{\mathcal{L}}

% -- Fracciones y puntos --
\newcommand{\pfrac}[2]{\left( \frac{#1}{#2} \right)}
\newcommand{\bfrac}[2]{\left[ \frac{#1}{#2} \right]}
\newcommand{\vecpar}[1]{\left( #1 \right)}
\newcommand{\point}[2]{\left( #1, #2 \right)}
\newcommand{\pointfrac}[4]{\left( \frac{#1}{#2}, \frac{#3}{#4} \right)}
\newcommand{\pointmix}[4]{\left( #1, \frac{#3}{#4} \right)}

% -- Subespacio generado --
\newcommand{\gen}[1]{\langle #1 \rangle}

% -- Lógica y relaciones --
\newcommand{\ssi}{\Longleftrightarrow}
\newcommand{\gt}{\ensuremath{>}}
\newcommand{\lt}{\ensuremath{<}}

% -- Operadores --
\DeclareMathOperator{\nul}{nul}
\DeclareMathOperator{\rg}{rg}      % Rango (álgebra lineal)
\DeclareMathOperator{\sgn}{sgn}    % Signo (álgebra lineal)
\DeclareMathOperator{\Var}{Var}    % Varianza (probabilidad)

% -- QED y tabla de contenidos --
\renewcommand{\qedsymbol}{$\blacksquare$}
\renewcommand{\cftsecleader}{\cftdotfill{\cftdotsep}}

% -- Atajos de letras griegas --
\let\a\alpha
\let\e\varepsilon
\let\o\omega
\let\l\lambda

% ========== CONFIGURACIÓN DE PÁRRAFOS ==========
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}

% ========== ENTORNOS ==========

% -- Solución --
\newenvironment{solucion}
  {\par\noindent\textit{Solución. }\ignorespaces}
  {\hfill$\blacktriangle$\par}

% -- Ejemplo (numerado por capítulo) --
\newcounter{ejemplo}[section]
\renewcommand{\theejemplo}{\thechapter.\arabic{ejemplo}}

\newenvironment{ejemplo}
  {\par\refstepcounter{ejemplo}%
   \noindent\textbf{Ejemplo \theejemplo. }\ignorespaces}
  {\par\vspace{\baselineskip}\noindent\hfill$\blacktriangle$\par}

% -- Problema/Ejercicio con caja (física) --
% Uso: \begin{problema}  o  \begin{problema}[título opcional]
\newcounter{problema}

\newenvironment{problema}[1][]{%
  \refstepcounter{problema}%
  \ifx&#1&%
    \begin{mdframed}[style=mdpinkbox, frametitle={Ejercicio \theproblema}]%
  \else%
    \begin{mdframed}[style=mdpinkbox, frametitle={Ejercicio \theproblema: #1}]%
  \fi
}{%
  \end{mdframed}
}
